<Window x:Class="DeltaForceTune.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="三角洲帧律 · delta-force-tune"
        Icon="Assets/app.ico"
        Width="1200" Height="780"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,16">
                    <TextBlock Text="delta-force-tune"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="系统层帧率优化"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,20">
                    <TextBlock Text="主题"
                               Margin="0,0,0,8"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <RadioButton x:Name="ThemeDark" Content="深色"
                                 Tag="dark"
                                 Style="{StaticResource ThemeRadioStyle}"
                                 Checked="Theme_Checked"/>
                    <RadioButton x:Name="ThemeLight" Content="亮色"
                                 Tag="light"
                                 Style="{StaticResource ThemeRadioStyle}"
                                 Checked="Theme_Checked"/>
                    <RadioButton x:Name="ThemeSystem" Content="跟随系统"
                                 Tag="system"
                                 Style="{StaticResource ThemeRadioStyle}"
                                 Checked="Theme_Checked"/>
                </StackPanel>

                <StackPanel Margin="18,28,18,0">
                    <RadioButton x:Name="NavDetect" Content="检测"
                                 Tag="detect"
                                 Style="{StaticResource NavRadioStyle}"
                                 IsChecked="True"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavOpt" Content="优化"
                                 Tag="opt"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAb" Content="A/B 实验"
                                 Tag="ab"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavFriend" Content="朋友测试"
                                 Tag="friend"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavBackup" Content="备份 / 日志"
                                 Tag="backup"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 右侧内容 -->
        <ContentControl x:Name="PageHost"
                        Grid.Column="1"
                        Margin="0"
                        Focusable="False"/>
    </Grid>
</Window>
