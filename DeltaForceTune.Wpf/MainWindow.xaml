<Window x:Class="DeltaForceTune.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="三角洲帧律 · delta-force-tune"
        Icon="Assets/app.ico"
        Width="1200" Height="780"
        MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,16">
                    <TextBlock Text="delta-force-tune"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="系统层帧率优化"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <!-- 设置固定左下角 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,20">
                    <Border Height="1"
                            Background="{DynamicResource BorderBrush}"
                            Margin="0,0,0,14"/>
                    <RadioButton x:Name="NavSettings"
                                 Tag="settings"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked">
<StackPanel Orientation="Horizontal">
<TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
<TextBlock Text="设置" Margin="10,0,0,0" VerticalAlignment="Center"/>
</StackPanel>
</RadioButton>
                    <TextBlock Text="v1.0.0"
                               Margin="14,10,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Margin="18,28,18,0">
                    <RadioButton x:Name="NavHome"
                                 Tag="home"
                                 Style="{StaticResource NavRadioStyle}"
                                 IsChecked="True"
                                 Checked="Nav_Checked">
<StackPanel Orientation="Horizontal">
<TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
<TextBlock Text="首页" Margin="10,0,0,0" VerticalAlignment="Center"/>
</StackPanel>
</RadioButton>
                    <RadioButton x:Name="NavDetect"
                                 Tag="detect"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked">
<StackPanel Orientation="Horizontal">
<TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
<TextBlock Text="检测" Margin="10,0,0,0" VerticalAlignment="Center"/>
</StackPanel>
</RadioButton>
                    <RadioButton x:Name="NavOpt"
                                 Tag="opt"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked">
<StackPanel Orientation="Horizontal">
<TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
<TextBlock Text="优化" Margin="10,0,0,0" VerticalAlignment="Center"/>
</StackPanel>
</RadioButton>
                    <RadioButton x:Name="NavAb"
                                 Tag="ab"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked">
<StackPanel Orientation="Horizontal">
<TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
<TextBlock Text="A/B 实验" Margin="10,0,0,0" VerticalAlignment="Center"/>
</StackPanel>
</RadioButton>
                    <RadioButton x:Name="NavFriend"
                                 Tag="friend"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked">
<StackPanel Orientation="Horizontal">
<TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
<TextBlock Text="朋友测试" Margin="10,0,0,0" VerticalAlignment="Center"/>
</StackPanel>
</RadioButton>
                    <RadioButton x:Name="NavBackup"
                                 Tag="backup"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked">
<StackPanel Orientation="Horizontal">
<TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
<TextBlock Text="备份 / 日志" Margin="10,0,0,0" VerticalAlignment="Center"/>
</StackPanel>
</RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 右侧内容 -->
        <ContentControl x:Name="PageHost"
                        Grid.Column="1"
                        Margin="0"
                        Focusable="False"/>
    </Grid>
</Window>
