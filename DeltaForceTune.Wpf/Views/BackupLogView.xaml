<UserControl x:Class="DeltaForceTune.Wpf.Views.BackupLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="备份 / 日志"
                   Style="{StaticResource PageTitleStyle}"
                   Margin="0,0,0,18"/>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Button Content="列出可还原项"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="130"
                        Margin="0,0,10,0"
                        Click="ListBackup_Click"/>
                <Button Content="还原全部"
                        Style="{StaticResource DangerButtonStyle}"
                        MinWidth="110"
                        Margin="0,0,10,0"
                        Click="RestoreAll_Click"/>
                <Button Content="打开备份目录"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="120"
                        Margin="0,0,10,0"
                        Click="OpenBackup_Click"/>
                <Button Content="打开 GUI 临时目录"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="140"
                        Margin="0,0,10,0"
                        Click="OpenTemp_Click"/>
                <Button Content="导出日志"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="110"
                        Click="ExportLog_Click"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,14">
            <Border Style="{StaticResource CardStyle}" Margin="4">
                <StackPanel>
                    <TextBlock Text="备份目录" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="BackupDirText" Text="--" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="4">
                <StackPanel>
                    <TextBlock Text="GUI 临时目录" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TempDirText" Text="--" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="4">
                <StackPanel>
                    <TextBlock Text="当前状态" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="StatusText" Text="等待操作" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="日志 / JSON 输出" Style="{StaticResource CardTitleStyle}"/>
                <TextBox Grid.Row="1"
                         x:Name="LogBox"
                         Style="{StaticResource MonoTextBoxStyle}"
                         IsReadOnly="True"
                         Text="点击上方按钮查看输出。"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
