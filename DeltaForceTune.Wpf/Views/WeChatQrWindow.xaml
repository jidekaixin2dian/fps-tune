<Window x:Class="DeltaForceTune.Wpf.Views.WeChatQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="微信二维码"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Microsoft YaHei UI">
    <StackPanel Margin="24">
        <TextBlock Text="微信二维码"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   HorizontalAlignment="Center"/>
        <TextBlock x:Name="WeChatNameText"
                   Text="记得开心1点"
                   FontSize="13"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,6,0,14"
                   HorizontalAlignment="Center"/>
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8">
            <Image Source="/Assets/wechat-qr.jpg"
                   Width="260" Height="370"
                   Stretch="Uniform"/>
        </Border>
        <TextBlock x:Name="WeChatIdText"
                   Text="微信号：jiaxindeyang"
                   FontSize="12"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Margin="0,14,0,4"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="仅接受合作/反馈"
                   FontSize="11"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Margin="0,0,0,14"
                   HorizontalAlignment="Center"/>
        <Button Content="复制微信号"
                Style="{StaticResource PrimaryButtonStyle}"
                MinWidth="140"
                HorizontalAlignment="Center"
                Click="CopyWeChat_Click"/>
    </StackPanel>
</Window>
