<UserControl x:Class="DeltaForceTune.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="设置"
                       Style="{StaticResource PageTitleStyle}"
                       Margin="0,0,0,20"/>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="常规" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="默认启动主题" Style="{StaticResource MutedTextStyle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
                        <RadioButton x:Name="ThemeDarkRadio" Content="深色" GroupName="defaultTheme" Style="{StaticResource ThemeRadioStyle}" Margin="0,0,12,0"/>
                        <RadioButton x:Name="ThemeLightRadio" Content="亮色" GroupName="defaultTheme" Style="{StaticResource ThemeRadioStyle}" Margin="0,0,12,0"/>
                        <RadioButton x:Name="ThemeSystemRadio" Content="跟随系统" GroupName="defaultTheme" Style="{StaticResource ThemeRadioStyle}"/>
                    </StackPanel>
                    <Button Content="保存设置"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left"
                            MinWidth="120"
                            Margin="0,4,0,0"
                            Click="SaveButton_Click"/>

                    <TextBlock Text="关于" Style="{StaticResource CardTitleStyle}" Margin="0,24,0,0"/>
                    <TextBlock x:Name="VersionText" Text="版本：v1.0.0"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="三角洲帧律：系统层帧率优化工具。"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="只调整 Windows 系统层设置：不修改游戏文件、不注入进程、不与反作弊交互、不关闭引导虚拟化、不做显卡伪装。"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="所有改动写入前自动备份，可一键还原。"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="联系方式仅接受合作/反馈。"
                               Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" Margin="0,14,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button x:Name="CheckUpdateButton"
                                Content="检查更新"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="110"
                                Margin="0,0,10,0"
                                Click="CheckUpdateButton_Click"/>
                        <TextBlock x:Name="UpdateStatusText"
                                   Text="未检查"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0"/>
                        <TextBlock x:Name="AdminStatusText"
                                   Text="当前非管理员"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0"/>
                        <Button x:Name="AdminRestartButton"
                                Content="以管理员身份重启"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="150"
                                Click="AdminRestartButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
