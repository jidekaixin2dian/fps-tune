<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DeltaForceTune.Wpf</RootNamespace>
    <AssemblyName>DeltaForceTune</AssemblyName>
    <Version>1.0.1</Version>
    <Product>三角洲帧律</Product>
    <Description>系统层帧率优化工具</Description>
    <Authors>三角洲帧律</Authors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WMI 查询（内存频率体检），避免再启动 powershell.exe 子进程 -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeltaForceTune.Wpf.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\delta-optimizer.ps1" Link="delta-optimizer.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\tuning-experiment.ps1" Link="tuning-experiment.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\friend-test.ps1" Link="friend-test.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\delta-optimizer.ps1" LogicalName="DeltaForceTune.Wpf.Scripts.delta-optimizer.ps1" />
    <EmbeddedResource Include="..\tuning-experiment.ps1" LogicalName="DeltaForceTune.Wpf.Scripts.tuning-experiment.ps1" />
    <EmbeddedResource Include="..\friend-test.ps1" LogicalName="DeltaForceTune.Wpf.Scripts.friend-test.ps1" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-icon.png" />
    <Resource Include="Assets\wechat-qr.jpg" />
  </ItemGroup>

</Project>
