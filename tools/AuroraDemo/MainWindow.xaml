<Window x:Class="AuroraDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="极光层预览 · FPS 帧律"
        Width="1020" Height="680"
        WindowStartupLocation="CenterScreen"
        Background="#22252B">
    <DockPanel>
        <!-- 控制条 -->
        <Border DockPanel.Dock="Top" Background="#2B2F37" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="主题：" Foreground="#C8CFDA" VerticalAlignment="Center"/>
                <RadioButton x:Name="ThemeDark" Content="深色" GroupName="theme" IsChecked="True"
                             Foreground="#E8ECF3" Margin="4,0,14,0" VerticalAlignment="Center" Checked="Refresh"/>
                <RadioButton Content="浅色" GroupName="theme"
                             Foreground="#E8ECF3" Margin="0,0,24,0" VerticalAlignment="Center" Checked="Refresh"/>
                <TextBlock Text="极光层：" Foreground="#C8CFDA" VerticalAlignment="Center"/>
                <RadioButton x:Name="AuroraOff" Content="关闭" GroupName="aurora" IsChecked="True"
                             Foreground="#E8ECF3" Margin="4,0,14,0" VerticalAlignment="Center" Checked="Refresh"/>
                <RadioButton x:Name="AuroraNormal" Content="原版强度" GroupName="aurora"
                             Foreground="#E8ECF3" Margin="0,0,14,0" VerticalAlignment="Center" Checked="Refresh"/>
                <RadioButton x:Name="AuroraStrong" Content="加强版" GroupName="aurora"
                             Foreground="#E8ECF3" Margin="0,0,24,0" VerticalAlignment="Center" Checked="Refresh"/>
                <TextBlock x:Name="HintText"
                           Text="原版 = v1.1.5 曾发布的参数（深 0x30 / 浅 0x22，被页面平色盖住从未显示过）"
                           Foreground="#8B95A5" VerticalAlignment="Center" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- 预览舞台：等比例还原主窗口的结构（渐变底 + 极光 + 标题栏 + 卡片） -->
        <Border x:Name="Stage" Margin="18" CornerRadius="10" ClipToBounds="True">
            <Grid>
                <!-- 极光层（与主窗口原实现一致：顶部中央的柔光椭圆，上缘出血） -->
                <Ellipse x:Name="Aurora"
                         Width="1200" Height="520"
                         HorizontalAlignment="Center" VerticalAlignment="Top"
                         Margin="0,-300,0,0"
                         IsHitTestVisible="False"/>

                <!-- 标题栏示意 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="TitleBar" Grid.Row="0" Background="#0D1016">
                        <TextBlock x:Name="TitleBarText" Text="FPS 帧律" Foreground="#EDF1F7" FontSize="12" FontWeight="SemiBold"
                                   Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </Border>

                    <!-- 页面示意：品牌区 + Hero 卡 + 两张功能卡 -->
                    <Grid Grid.Row="1" Margin="18,14,18,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="BrandText" Text="fps-tune"
                                   FontSize="15" FontWeight="Bold" Foreground="#EDF1F7" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1">
                            <Border x:Name="HeroCard" CornerRadius="12" Background="#12161E" BorderBrush="#232B38" BorderThickness="1"
                                    Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="HeroTitle" Text="FPS 帧律" FontSize="22" FontWeight="Bold" Foreground="#EDF1F7"/>
                                    <TextBlock x:Name="HeroSub" Text="FPS TUNE · Windows 系统层帧率优化，全游戏通用"
                                               FontSize="12" Foreground="#A6B1C2" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <UniformGrid Columns="2">
                                <Border x:Name="Card1" Style="{x:Null}" CornerRadius="12" Background="#12161E" BorderBrush="#232B38" BorderThickness="1"
                                        Padding="16" Margin="0,0,7,0" Height="120">
                                    <StackPanel>
                                        <TextBlock x:Name="CardTitle1" Text="检测" FontSize="15" FontWeight="Bold" Foreground="#EDF1F7"/>
                                        <TextBlock x:Name="CardDesc1" Text="硬件信息、游戏路径、体检和优化项状态"
                                                   FontSize="11" Foreground="#7E8BA0" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="Card2" CornerRadius="12" Background="#12161E" BorderBrush="#232B38" BorderThickness="1"
                                        Padding="16" Margin="7,0,0,0" Height="120">
                                    <StackPanel>
                                        <TextBlock x:Name="CardTitle2" Text="优化" FontSize="15" FontWeight="Bold" Foreground="#EDF1F7"/>
                                        <TextBlock x:Name="CardDesc2" Text="预设与逐项开关、33 项系统层优化、一键还原"
                                                   FontSize="11" Foreground="#7E8BA0" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </DockPanel>
</Window>
