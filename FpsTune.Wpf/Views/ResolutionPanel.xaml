<UserControl x:Class="FpsTune.Wpf.Views.ResolutionPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <Border Style="{StaticResource CardStyle}" Padding="20,18" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="{DynamicResource Str.ResolutionTitle}" Style="{StaticResource CardTitleStyle}"/>
    <TextBlock Text="{DynamicResource Str.ResolutionScope}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,14"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ComboBox x:Name="Target" MinWidth="220" HorizontalAlignment="Stretch" SelectionChanged="TargetChanged" AutomationProperties.Name="{DynamicResource Str.Resolution.UI.1}"/>
     <Button x:Name="RefreshButton" Grid.Column="1" Content="{DynamicResource Str.Resolution.UI.2}" Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshClick"/>
    </Grid>
    <TextBlock x:Name="CurrentText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0"/>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource CardStyle}" Padding="20,18" Margin="0,0,0,12">
   <StackPanel>
    <StackPanel x:Name="Inputs">
     <TextBlock Text="{DynamicResource Str.Resolution.UI.3}" Style="{StaticResource CardTitleStyle}"/>
     <TextBlock Text="{DynamicResource Str.Resolution.UI.4}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,12" TextWrapping="Wrap"/>
     <ItemsControl x:Name="Presets">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <RadioButton GroupName="resolutionPreset" Tag="{Binding}" IsEnabled="{Binding Enabled}" IsChecked="{Binding Selected, Mode=OneWay}"
         Style="{StaticResource ChoiceTabStyle}" Padding="14,10" Margin="0,0,8,8" Checked="PresetChecked" ToolTip="{Binding Detail}" ToolTipService.ShowOnDisabled="True" AutomationProperties.HelpText="{Binding Detail}">
         <StackPanel><TextBlock Text="{Binding Title}" FontSize="15"/><TextBlock Text="{Binding Summary}" FontSize="13" MaxWidth="180" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
        </RadioButton>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <WrapPanel Margin="0,10,0,6">
      <StackPanel Margin="0,0,12,8"><TextBlock Text="{DynamicResource Str.Resolution.UI.5}" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6"/><TextBox x:Name="WidthInput" Width="120" TextChanged="DimensionChanged" LostKeyboardFocus="DimensionLostFocus" AutomationProperties.Name="{DynamicResource Str.Resolution.UI.6}"/></StackPanel>
      <StackPanel Margin="0,0,12,8"><TextBlock Text="{DynamicResource Str.Resolution.UI.7}" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6"/><TextBox x:Name="HeightInput" Width="120" TextChanged="DimensionChanged" LostKeyboardFocus="DimensionLostFocus" AutomationProperties.Name="{DynamicResource Str.Resolution.UI.8}"/></StackPanel>
      <StackPanel Margin="0,0,12,8"><TextBlock Text="{DynamicResource Str.Resolution.UI.9}" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6"/><ComboBox x:Name="RefreshRate" Width="140" SelectionChanged="DraftChanged" AutomationProperties.Name="{DynamicResource Str.Resolution.UI.10}"/></StackPanel>
     </WrapPanel>
     <CheckBox x:Name="LockRatio" Content="{DynamicResource Str.Resolution.UI.11}" IsChecked="True" Checked="RatioChanged" Unchecked="RatioChanged" Margin="0,0,0,14"/>
     <TextBlock Text="{DynamicResource Str.Resolution.UI.12}" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6"/>
     <ComboBox x:Name="Scaling" MaxWidth="330" HorizontalAlignment="Left" MinWidth="240" SelectionChanged="DraftChanged" AutomationProperties.Name="{DynamicResource Str.Resolution.UI.13}"/>
     <TextBlock x:Name="ScalingText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,14"/>
    </StackPanel>
    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="{DynamicResource RadiusChip}" Padding="14,12" Margin="0,2,0,14">
     <StackPanel><TextBlock x:Name="PendingText" FontSize="16" TextWrapping="Wrap"/><TextBlock x:Name="PlanText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
    </Border>
    <WrapPanel>
     <Button x:Name="ApplyButton" Content="{DynamicResource Str.Resolution.UI.14}" Style="{StaticResource PrimaryButtonStyle}" Click="ApplyClick" Margin="0,0,8,8" IsEnabled="False"/>
     <Button x:Name="RestoreButton" Content="{DynamicResource Str.Resolution.UI.15}" Style="{StaticResource SecondaryButtonStyle}" Click="RestoreClick" Margin="0,0,8,8" IsEnabled="False"/>
    </WrapPanel>
    <Border x:Name="Confirmation" Visibility="Collapsed" Background="{DynamicResource AccentSoftBrush}" CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="0,8,0,12">
     <StackPanel>
      <TextBlock x:Name="CountdownText" FontSize="16" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,12,0,0">
       <Button x:Name="KeepButton" Content="{DynamicResource Str.Resolution.UI.16}" Style="{StaticResource PrimaryButtonStyle}" Click="KeepClick" Margin="0,0,8,0"/>
       <Button x:Name="RevertButton" Content="{DynamicResource Str.Resolution.UI.17}" Style="{StaticResource SecondaryButtonStyle}" Click="RestoreClick"/>
      </WrapPanel>
     </StackPanel>
    </Border>
    <TextBlock x:Name="ResultText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
 </StackPanel>
</UserControl>
