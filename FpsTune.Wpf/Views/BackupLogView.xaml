<UserControl x:Class="FpsTune.Wpf.Views.BackupLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str.NavBackup}" Style="{StaticResource SectionLabelStyle}"/>
                <TextBlock Text="{DynamicResource Str.BackupIntro}"
                           Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button x:Name="ListBackupButton" Content="{DynamicResource Str.ListRestorable}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="126" Margin="0,0,8,0"
                        Click="ListBackup_Click"/>
                <Button x:Name="RestoreAllButton" Content="{DynamicResource Str.RestoreAll}"
                        Style="{StaticResource DangerButtonStyle}"
                        MinWidth="106" Margin="0,0,8,0"
                        Click="RestoreAll_Click"/>
                <Button Content="{DynamicResource Str.ExportLog}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="106"
                        Click="ExportLog_Click"/>
            </StackPanel>
        </Grid>

        <!-- 目录信息 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.BackupDir}" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="BackupDirText" Text="--"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="{StaticResource FontMono}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <Button Content="{DynamicResource Str.OpenArrow}"
                            Style="{StaticResource GhostButtonStyle}"
                            MinWidth="60" Height="26" Padding="8,0"
                            HorizontalAlignment="Left" Margin="0,8,0,0"
                            Click="OpenBackup_Click"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.GuiTempDir}" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="TempDirText" Text="--"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="{StaticResource FontMono}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <Button Content="{DynamicResource Str.OpenArrow}"
                            Style="{StaticResource GhostButtonStyle}"
                            MinWidth="60" Height="26" Padding="8,0"
                            HorizontalAlignment="Left" Margin="0,8,0,0"
                            Click="OpenTemp_Click"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.CurrentStatus}" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="StatusText" Text="{DynamicResource Str.WaitingAction}"
                               Foreground="{DynamicResource AccentBrush}"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 备份文件列表：区分"还能还原"与"已消费的 .restored 审计文件"（P2-11） -->

        <!-- 0.2.2 M4：改动总览（只读）——本工具改过什么：原值 vs 当前实时状态 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.ChangeAuditTitle}" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Str.ChangeAuditHint}"
                                   Style="{StaticResource MutedTextStyle}" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Content="{DynamicResource Str.ChangeAuditRefresh}"
                            Style="{StaticResource GhostButtonStyle}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="RefreshAudit_Click"/>
                </Grid>
                <TextBlock x:Name="AuditEmptyHint" Text="{DynamicResource Str.ChangeAuditEmpty}"
                           Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" Visibility="Collapsed"/>
                <ItemsControl x:Name="AuditList" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" Padding="12,8" CornerRadius="{StaticResource RadiusControl}"
                                    Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding NowText}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource OkBrush}"/><Style.Triggers><DataTrigger Binding="{Binding OptimizedNow}" Value="False"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource Str.BackupFilesCard}" Style="{StaticResource CardTitleStyle}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Str.ExportBackups}"
                            Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0"
                            Click="ExportBackups_Click"/>
                    <Button Content="{DynamicResource Str.ImportBackups}"
                            Style="{StaticResource GhostButtonStyle}" Margin="0,0,12,0"
                            Click="ImportBackups_Click"/>
                    <Button Content="{DynamicResource Str.Refresh}"
                            Style="{StaticResource GhostButtonStyle}"
                            MinWidth="60" Height="26" Padding="8,0"
                            HorizontalAlignment="Right"
                            Click="RefreshBackupList_Click"/>
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="1" x:Name="BackupEmptyHint"
                           Text="{DynamicResource Str.BackupNoFiles}"
                           Style="{StaticResource MutedTextStyle}"
                           Visibility="Collapsed" Margin="0,4,0,4"/>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="190" Margin="0,2,0,0">
                    <ItemsControl x:Name="BackupFileList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="2,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontFamily="{StaticResource FontMono}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                                            <TextBlock Text="{Binding LastWriteText}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource ChipStyle}">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="pending">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="invalid">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StateText}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="12"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 日志 -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Height="260">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource Str.LogJsonOutput}" Style="{StaticResource CardTitleStyle}"/>
                <TextBox Grid.Row="1"
                         x:Name="LogBox"
                         Style="{StaticResource MonoTextBoxStyle}"
                         IsReadOnly="True"
                         Text="{DynamicResource Str.ClickAboveForOutput}"/>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
