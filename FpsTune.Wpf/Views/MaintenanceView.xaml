<UserControl x:Class="FpsTune.Wpf.Views.MaintenanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FpsTune.Wpf.Views.Controls" xmlns:views="clr-namespace:FpsTune.Wpf.Views" Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="MemoryResultStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,12,0,0"/>
            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="32,26,32,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="{DynamicResource Str.NavTools}" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="{DynamicResource Str.MaintenanceIntro}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock x:Name="SnapshotStatus" Style="{StaticResource MutedTextStyle}" FontSize="13" Margin="0,6,0,0"/></StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="{DynamicResource Str.MaintenanceRefresh}" Style="{StaticResource SecondaryButtonStyle}" Click="Refresh_Click" VerticalAlignment="Top" Margin="20,0,0,0"/>
        </Grid>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,24,0">
                <RadioButton x:Name="StorageNav" Content="{DynamicResource Str.MaintenanceStorage}" GroupName="maintenanceSection" Tag="0" Checked="Section_Checked" IsChecked="True" Style="{StaticResource SectionNavigationStyle}"/>
                <RadioButton x:Name="ProcessesNav" Content="{DynamicResource Str.MaintenanceProcesses}" GroupName="maintenanceSection" Tag="1" Checked="Section_Checked" Style="{StaticResource SectionNavigationStyle}"/>
                <RadioButton x:Name="TroubleshootNav" Content="{DynamicResource Str.MaintenanceTroubleshoot}" GroupName="maintenanceSection" Tag="2" Checked="Section_Checked" Style="{StaticResource SectionNavigationStyle}"/>
                <RadioButton x:Name="AudioNav" Content="{DynamicResource Str.EqTitle}" GroupName="maintenanceSection" Tag="3" Checked="Section_Checked" Style="{StaticResource SectionNavigationStyle}"/>
                <RadioButton x:Name="NetworkNav" Content="{DynamicResource Str.NetworkToolsTitle}" GroupName="maintenanceSection" Tag="4" Checked="Section_Checked" Style="{StaticResource SectionNavigationStyle}"/>
                <RadioButton x:Name="SensitivityNav" Content="{DynamicResource Str.SensNav}" GroupName="maintenanceSection" Tag="5" Checked="Section_Checked" Style="{StaticResource SectionNavigationStyle}"/>
                <RadioButton x:Name="InputNav" Content="{DynamicResource Str.InputQueueTitle}" GroupName="maintenanceSection" Tag="6" Checked="Section_Checked" Style="{StaticResource SectionNavigationStyle}"/>
            </StackPanel>
            <Grid Grid.Column="1">
                <ContentControl x:Name="NetworkSection" Visibility="Collapsed"/>
                <ScrollViewer x:Name="SensitivitySection" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><views:SensitivityPanel Margin="0,0,14,0"/></ScrollViewer>
                <ScrollViewer x:Name="InputSection" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel Margin="0,0,14,0">
                    <Border Style="{StaticResource CardStyle}"><StackPanel>
                        <TextBlock Text="{DynamicResource Str.InputQueueTitle}" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Str.InputQueueHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,16,0,0">
                            <StackPanel Margin="0,0,18,10">
                                <TextBlock Text="{DynamicResource Str.InputQueuePollingRate}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="PollingRateBox" MinWidth="140" HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource Str.InputQueuePollingRate}" SelectionChanged="PollingRate_Changed">
                                    <ComboBoxItem Content="125 Hz" Tag="125"/>
                                    <ComboBoxItem Content="250 Hz" Tag="250"/>
                                    <ComboBoxItem Content="500 Hz" Tag="500"/>
                                    <ComboBoxItem Content="1000 Hz" Tag="1000"/>
                                    <ComboBoxItem Content="2000 Hz" Tag="2000"/>
                                    <ComboBoxItem Content="4000 Hz" Tag="4000"/>
                                    <ComboBoxItem Content="8000 Hz" Tag="8000"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,10">
                                <TextBlock Text="{DynamicResource Str.InputQueueKeyboard}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,6"/>
                                <TextBox x:Name="KeyboardDepthBox" Width="110" HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource Str.InputQueueKeyboard}" TextChanged="Depth_Changed"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource Str.InputQueueMouse}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,6"/>
                                <TextBox x:Name="MouseDepthBox" Width="110" HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource Str.InputQueueMouse}" TextChanged="Depth_Changed"/>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock x:Name="KeyboardReadout" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock x:Name="MouseReadout" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock x:Name="InputQueueWarning" Text="{DynamicResource Str.InputQueueLowWarning}" Foreground="{DynamicResource WarningBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                        <Button x:Name="InputQueueApplyButton" Content="{DynamicResource Str.InputQueueApply}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="InputQueueApply_Click"/>
                        <TextBlock x:Name="InputQueueStatus" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="InputQueueDefaultNote" Style="{StaticResource MutedTextStyle}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0"><StackPanel>
                        <TextBlock Text="{DynamicResource Str.InputFeedbackTitle}" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Str.InputFeedbackHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        <Button x:Name="InputFeedbackButton" Content="{DynamicResource Str.InputFeedbackAction}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="InputFeedback_Click"/>
                        <TextBlock x:Name="InputFeedbackStatus" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
                <ScrollViewer x:Name="AudioSection" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><views:AudioEqualizerPanel Margin="0,0,14,0"/></ScrollViewer>
                <ScrollViewer x:Name="StorageSection" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,14,0">
                    <Border Style="{StaticResource CardStyle}"><StackPanel>
                        <TextBlock Text="{DynamicResource Str.MaintenanceDrives}" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Str.MaintenanceDriveHint}" Style="{StaticResource MutedTextStyle}" FontSize="13" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="Drives" Margin="0,16,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,18">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="{DynamicResource SmallEmphasisWeight}"/>
                                <TextBlock Text="{Binding Amount}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ProgressBar Maximum="100" Value="{Binding UsedPercent}" Style="{StaticResource ThinMeterStyle}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Str.MaintenanceLowSpace}" Foreground="{DynamicResource WarningBrush}" FontSize="13" Margin="12,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding LowSpace}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            </Grid>
                        </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock x:Name="NoDrives" Text="{DynamicResource Str.MaintenanceNoDrives}" Style="{StaticResource MutedTextStyle}" Visibility="Collapsed"/>
                    </StackPanel></Border>
<Border Style="{StaticResource CardStyle}" Margin="0,18,0,0"><StackPanel>
    <DockPanel><Button x:Name="DiskHealthRefresh" DockPanel.Dock="Right" Content="{DynamicResource Str.MaintenanceRefresh}" Style="{StaticResource SecondaryButtonStyle}" Click="DiskHealthRefresh_Click"/>
        <StackPanel><TextBlock Text="{DynamicResource Str.DiskHealthTitle}" Style="{StaticResource CardTitleStyle}" Margin="0"/>
            <TextBlock Text="{DynamicResource Str.DiskHealthHint}" Style="{StaticResource MutedTextStyle}" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></DockPanel>
    <ItemsControl x:Name="DiskHealthList" Margin="0,14,0,0"><ItemsControl.ItemTemplate><DataTemplate>
        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="{DynamicResource RadiusControl}" Padding="14,12" Margin="0,0,0,8"><StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="{DynamicResource SmallEmphasisWeight}" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,0,0,0"/>
            </Grid>
            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedTextStyle}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock x:Name="DiskHealthStatus" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
</StackPanel></Border>
<Border Style="{StaticResource CardStyle}" Margin="0,18,0,0"><StackPanel><Grid Margin="0,10,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0"><TextBlock Text="{DynamicResource Str.MaintenanceTemporary}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="{DynamicResource SmallEmphasisWeight}"/>
                <TextBlock Text="{DynamicResource Str.MaintenanceTemporaryHint}" Style="{StaticResource MutedTextStyle}" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
            <Button Grid.Column="1" Tag="temporary" Content="{DynamicResource Str.MaintenanceOpen}" ToolTip="{DynamicResource Str.MaintenanceTemporary}" Click="OpenTool_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"/>
        </Grid>
<Grid Margin="0,10,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0"><TextBlock Text="{DynamicResource Str.MaintenanceApps}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="{DynamicResource SmallEmphasisWeight}"/>
                <TextBlock Text="{DynamicResource Str.MaintenanceAppsHint}" Style="{StaticResource MutedTextStyle}" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
            <Button Grid.Column="1" Tag="apps" Content="{DynamicResource Str.MaintenanceOpen}" ToolTip="{DynamicResource Str.MaintenanceApps}" Click="OpenTool_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"/>
        </Grid></StackPanel></Border><Border Style="{StaticResource CardStyle}" VerticalAlignment="Top" Margin="0,18,0,0"><StackPanel>
            <TextBlock Text="{DynamicResource Str.ShaderCache}" Style="{StaticResource CardTitleStyle}"/>
            <TextBlock Text="{DynamicResource Str.CacheScope}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,18,0,12"><Button x:Name="ScanButton" Content="{DynamicResource Str.CacheScan}" Click="Scan_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,8"/>
                <Button x:Name="CleanButton" Content="{DynamicResource Str.CacheClean}" Click="Clean_Click" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" Margin="0,0,0,8"/></WrapPanel>
            <TextBlock x:Name="Summary" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
            <ItemsControl x:Name="Folders" Margin="0,16,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="0,0,0,8"><StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="{DynamicResource SmallEmphasisWeight}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Amount}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding Path}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="{DynamicResource Str.CacheRebuild}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,16,0,0"/>
            <TextBlock x:Name="Skipped" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel></Border>
                </StackPanel></ScrollViewer>
                <ScrollViewer x:Name="ProcessesSection" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel Margin="0,0,14,0">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel>
                        <DockPanel LastChildFill="True"><Button x:Name="MemoryRefresh" DockPanel.Dock="Right" Content="{DynamicResource Str.MemoryRefreshAction}" Style="{StaticResource SecondaryButtonStyle}" Click="MemoryRefresh_Click"/>
                            <TextBlock Text="{DynamicResource Str.MemoryTitle}" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" Margin="0"/></DockPanel>
                        <Grid Margin="0,12,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"><TextBlock x:Name="MemoryPercent" Style="{StaticResource StatValueStyle}"/>
                                <TextBlock Text="{DynamicResource Str.MemoryPhysicalUsed}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
                            <TextBlock x:Name="MemoryAvailable" Grid.Column="1" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0" TextWrapping="Wrap"/></Grid>
                        <ProgressBar x:Name="MemoryUsage" Maximum="100" Style="{StaticResource ThinMeterStyle}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10" AutomationProperties.Name="{DynamicResource Str.MemoryUsed}"/>
                        <TextBlock x:Name="MemoryCommit" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,5"/>
                        <TextBlock x:Name="MemoryStandby" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock x:Name="MemoryFullScope" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,12,0,8" TextWrapping="Wrap"/>
                        <WrapPanel>
                            <Button x:Name="MemoryFullButton" Content="{DynamicResource Str.MemoryFullAction}" Style="{StaticResource PrimaryButtonStyle}" Height="40" Click="MemoryFull_Click" Margin="0,0,8,8"/>
                            <Button x:Name="MemoryCleanButton" Content="{DynamicResource Str.MemoryStandbyAction}" Style="{StaticResource SecondaryButtonStyle}" Height="40" Margin="0,0,8,8" Click="MemoryClean_Click"/>
                            <Button x:Name="MemoryWorkingSetsButton" Content="{DynamicResource Str.MemoryWorkingSetsAction}" Style="{StaticResource SecondaryButtonStyle}" Height="40" Margin="0,0,0,8" Click="MemoryAppsTrim_Click"/>
                        </WrapPanel>
                        <Expander x:Name="MemoryOptions" Header="{DynamicResource Str.MemoryMoreOptions}" Margin="0,4,0,0"><StackPanel Margin="0,6,0,0">
                            <TextBlock Text="{DynamicResource Str.MemoryScope}" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="MemoryMode" MinWidth="220" HorizontalAlignment="Left" SelectedIndex="1" AutomationProperties.Name="{DynamicResource Str.MemoryScope}">
                                <ComboBoxItem Content="{DynamicResource Str.MemoryLowMode}"/>
                                <ComboBoxItem Content="{DynamicResource Str.MemoryAllMode}"/>
                            </ComboBox>
                            <Button x:Name="MemoryCombinedButton" Content="{DynamicResource Str.MemoryCombinedAction}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="MemoryCombined_Click"/>
                        </StackPanel></Expander>
                        <Border x:Name="MemoryProgressPanel" Visibility="Collapsed" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="{DynamicResource RadiusControl}" Padding="14" Margin="0,18,0,0"><StackPanel>
                            <DockPanel><Button x:Name="MemoryCancel" DockPanel.Dock="Right" Content="{DynamicResource Str.MemoryStop}" Style="{StaticResource SecondaryButtonStyle}" Click="MemoryCancel_Click" Margin="12,0,0,0"/>
                                <StackPanel><TextBlock x:Name="MemoryStage" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="MemoryElapsed" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0"/></StackPanel></DockPanel>
                            <ProgressBar IsIndeterminate="True" Height="4" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}" Margin="0,16,0,0" AutomationProperties.Name="{DynamicResource Str.MemoryCleaning}"/>
                        </StackPanel></Border>
                        <TextBlock x:Name="MemoryResult" Style="{StaticResource MemoryResultStyle}" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel>
                        <TextBlock Text="{DynamicResource Str.MemoryBackgroundTitle}" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Str.MemoryBackgroundHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="MemorySelection" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,16,0,0"/>
                        <WrapPanel Margin="0,8,0,8">
                            <Button x:Name="MemoryAppsRefresh" Content="{DynamicResource Str.MaintenanceRefresh}" Click="MemoryAppsRefresh_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"/>
                            <Button x:Name="MemoryStreamingDetect" Content="{DynamicResource Str.MemoryStreamingDetect}" Click="MemoryStreamingDetect_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"/>
                            <Button x:Name="MemorySelectAll" Content="{DynamicResource Str.MemorySelectAll}" Click="MemorySelectAll_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"/>
                            <Button x:Name="MemorySelectNone" Content="{DynamicResource Str.MemorySelectNone}" Click="MemorySelectNone_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="MemoryApps"><ItemsControl.ItemTemplate><DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Checked="MemoryAppSelection_Changed" Unchecked="MemoryAppSelection_Changed" Margin="0,6">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Amount}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                    <controls:FileNameLabel Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Path}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,4,0,0"/>
                                </Grid>
                            </CheckBox>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                        <Button x:Name="MemoryAppsTrim" Content="{DynamicResource Str.MemoryTrimSelected}" Click="MemoryAppsTrim_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,10"/>
                        <TextBlock x:Name="MemoryAppsStatus" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="MemoryAppsResult" Style="{StaticResource MemoryResultStyle}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel>
                        <TextBlock Text="{DynamicResource Str.MemoryAutoTitle}" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Str.MemoryAutoHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        <CheckBox x:Name="MemoryAutoEnabled" Content="{DynamicResource Str.MemoryAutoEnabled}" Margin="0,14,0,8"/>
                        <WrapPanel>
                            <StackPanel Margin="0,0,18,8"><TextBlock Text="{DynamicResource Str.MemoryThreshold}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="MemoryThreshold" MinWidth="140" AutomationProperties.Name="{DynamicResource Str.MemoryThreshold}"><ComboBoxItem Content="512 MiB" Tag="512"/><ComboBoxItem Content="1024 MiB" Tag="1024"/><ComboBoxItem Content="2048 MiB" Tag="2048"/><ComboBoxItem Content="4096 MiB" Tag="4096"/></ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8"><TextBlock Text="{DynamicResource Str.MemoryCooldown}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="MemoryCooldown" MinWidth="140" AutomationProperties.Name="{DynamicResource Str.MemoryCooldown}"><ComboBoxItem Content="5 min" Tag="5"/><ComboBoxItem Content="10 min" Tag="10"/><ComboBoxItem Content="15 min" Tag="15"/><ComboBoxItem Content="30 min" Tag="30"/></ComboBox>
                            </StackPanel>
                        </WrapPanel>
                        <Button x:Name="MemoryAutoSave" Content="{DynamicResource Str.Save}" Click="MemoryAutoSave_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        <TextBlock x:Name="MemoryAutoStatus" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}"><StackPanel>
                        <TextBlock Text="{DynamicResource Str.MaintenanceMemoryTitle}" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Str.MaintenanceMemoryHint}" Style="{StaticResource MutedTextStyle}" FontSize="13" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="Processes" Margin="0,18,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Pid, StringFormat=PID {0}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13"/>
                                <TextBlock Grid.Column="2" Text="{Binding Amount}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock x:Name="NoProcesses" Text="{DynamicResource Str.MaintenanceNoProcesses}" Style="{StaticResource MutedTextStyle}" Visibility="Collapsed"/>
                    </StackPanel></Border>
<Border Style="{StaticResource CardStyle}" Margin="0,18,0,0"><StackPanel>
    <DockPanel LastChildFill="True">
        <Button x:Name="BgCheckButton" DockPanel.Dock="Right" Content="{DynamicResource Str.BgCheckStart}" Style="{StaticResource SecondaryButtonStyle}" Click="BgCheck_Click" VerticalAlignment="Top"/>
        <StackPanel>
            <TextBlock Text="{DynamicResource Str.BgCheckTitle}" Style="{StaticResource CardTitleStyle}" Margin="0"/>
            <TextBlock Text="{DynamicResource Str.BgCheckHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
    </DockPanel>
    <TextBlock x:Name="BgCheckStatus" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,16,0,0"/>
    <TextBlock x:Name="BgCpuTitle" Text="{DynamicResource Str.BgCheckCpuTitle}" TextWrapping="Wrap" Margin="0,14,0,4" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="{DynamicResource SmallEmphasisWeight}" Visibility="Collapsed"/>
    <ItemsControl x:Name="BgCpuList" Visibility="Collapsed"><ItemsControl.ItemTemplate><DataTemplate>
        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="1" Text="{Binding Pid, StringFormat=PID {0}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13"/>
            <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
        </Grid>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock x:Name="BgDiskTitle" Text="{DynamicResource Str.BgCheckDiskTitle}" TextWrapping="Wrap" Margin="0,10,0,4" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="{DynamicResource SmallEmphasisWeight}" Visibility="Collapsed"/>
    <ItemsControl x:Name="BgDiskList" Visibility="Collapsed"><ItemsControl.ItemTemplate><DataTemplate>
        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="1" Text="{Binding Pid, StringFormat=PID {0}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13"/>
            <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
        </Grid>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock x:Name="BgNetworkText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="Collapsed"/>
</StackPanel></Border>
<Border Style="{StaticResource CardStyle}" Margin="0,18,0,0"><StackPanel><Grid Margin="0,10,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0"><TextBlock Text="{DynamicResource Str.MaintenanceTaskManager}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="{DynamicResource SmallEmphasisWeight}"/>
