<Window x:Class="FpsTune.Wpf.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.Licenses}" Style="{StaticResource WindowTypographyStyle}" Width="820" Height="600" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource ConsoleBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Str.LicenseTitle}" Style="{StaticResource CardTitleStyle}"/>
            <TextBlock Text="{DynamicResource Str.LicenseRights}"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <TabControl Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
            <TabItem Header="MIT"><TextBox x:Name="ProjectText" IsReadOnly="True" TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="16"/></TabItem>
            <TabItem Header="{DynamicResource Str.ThirdPartyNotices}"><TextBox x:Name="ThirdPartyText" IsReadOnly="True" TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="16"/></TabItem>
        </TabControl>
    </Grid>
</Window>
