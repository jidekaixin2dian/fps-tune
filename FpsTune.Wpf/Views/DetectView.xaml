<UserControl x:Class="FpsTune.Wpf.Views.DetectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="检测" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="只读查看硬件、游戏与各项当前状态，不会修改任何系统设置"
                           Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button x:Name="RunButton"
                        Content="运行检测"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="110" Margin="0,0,10,0"
                        Click="RunButton_Click"/>
                <Button x:Name="LoadButton"
                        Content="加载到优化页"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="130"
                        Click="LoadButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- 硬件瓦片 -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="CPU" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="CpuText" Text="--"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="GPU" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="GpuText" Text="--"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="内存" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="RamText" Text="--"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="系统" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="OsText" Text="--"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border CornerRadius="5" Padding="6,1" Background="{DynamicResource ElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,6,0">
                            <TextBlock x:Name="LaptopText" Text="--" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <Border CornerRadius="5" Padding="6,1" Background="{DynamicResource ElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="AdminText" Text="--" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 游戏路径 + 体检 -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="9*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="游戏路径" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center"/>
                        <Button Content="复制"
                                Style="{StaticResource GhostButtonStyle}"
                                Height="24" MinWidth="52"
                                HorizontalAlignment="Right"
                                Padding="8,0"
                                Click="CopyGamePath_Click"/>
                    </Grid>
                    <TextBlock x:Name="GamePathText" Text="--"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="只读体检" Style="{StaticResource CardTitleStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Ellipse Grid.Row="0" Grid.Column="0" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,10"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="VC++ 运行库" Style="{StaticResource MutedTextStyle}"/>
                            <TextBlock x:Name="Check1Text" Text="待检测" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                        </StackPanel>
                        <Ellipse Grid.Row="1" Grid.Column="0" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,10"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="内存频率" Style="{StaticResource MutedTextStyle}"/>
                            <TextBlock x:Name="Check2Text" Text="待检测" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                        </StackPanel>
                        <Ellipse Grid.Row="2" Grid.Column="0" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Text="PCIe 链路" Style="{StaticResource MutedTextStyle}"/>
                            <TextBlock x:Name="Check3Text" Text="待检测" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 优化项概览 -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="优化项概览" Style="{StaticResource CardTitleStyle}"/>
                <ListBox x:Name="DetectItemList"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource CardListItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Id}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SideEffect, StringFormat=副作用：{0}}"
                                               Foreground="{DynamicResource WarningBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding HasSideEffect, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Margin="10,0,0,0"
                                        CornerRadius="8"
                                        Padding="8,3"
                                        Background="{DynamicResource ElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Optimized}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 详情 -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Height="170">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock Text="检测详情（JSON）" Style="{StaticResource CardTitleStyle}"/>
                    <Button Content="复制全部"
                            Style="{StaticResource GhostButtonStyle}"
                            HorizontalAlignment="Right"
                            MinWidth="72" Height="28"
                            Click="CopyDetail_Click"/>
                </Grid>
                <TextBox Grid.Row="1"
                         x:Name="OutputBox"
                         Style="{StaticResource MonoTextBoxStyle}"
                         IsReadOnly="True"
                         Text="点击“运行检测”开始。"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
