<UserControl x:Class="FpsTune.Wpf.Views.DetectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <!-- 页面根滚动: 概览列表/JSON框会把滚轮事件吞在自己身上,
         由 code-behind 的 PreviewMouseWheel 转发保证整页可滚 -->
    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="检测 · DETECT" Style="{StaticResource SectionLabelStyle}"/>
                <TextBlock Text="只读查看硬件、游戏与各项当前状态，不会修改任何系统设置"
                           Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button x:Name="RunButton"
                        Content="运行检测"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="110" Margin="0,0,10,0"
                        Click="RunButton_Click"/>
                <Button x:Name="LoadButton"
                        Content="加载到优化页"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="130"
                        Click="LoadButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- 硬件：发丝分隔的通栏 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="14,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock x:Name="CpuText" Text="--"
                                   FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="14,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Text="GPU" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock x:Name="GpuText" Text="--"
                                   FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="14,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Text="内存" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock x:Name="RamText" Text="--"
                                   FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="系统" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock x:Name="OsText" Text="--"
                                   FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Style="{StaticResource ChipStyle}" Margin="0,0,6,0">
                                <TextBlock x:Name="LaptopText" Text="--" FontSize="10.5" FontFamily="{StaticResource FontMono}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Style="{StaticResource ChipStyle}">
                                <TextBlock x:Name="AdminText" Text="--" FontSize="10.5" FontFamily="{StaticResource FontMono}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 实时监控 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="实时监控 · LIVE" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                    <TextBlock Text="每秒采样 · 只读性能数据" Style="{StaticResource MutedTextStyle}" FontSize="11" HorizontalAlignment="Right"/>
                </Grid>
                <UniformGrid Columns="4">
                    <StackPanel Margin="0,0,14,0">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="CPU 占用" Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                            <TextBlock x:Name="CpuNowText" Text="--" HorizontalAlignment="Right"
                                       FontSize="12" FontFamily="{StaticResource FontMono}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        </Grid>
                        <Canvas x:Name="CpuChart" Height="72"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="内存占用" Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                            <TextBlock x:Name="MemNowText" Text="--" HorizontalAlignment="Right"
                                       FontSize="12" FontFamily="{StaticResource FontMono}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Grid>
                        <Canvas x:Name="MemChart" Height="72"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="GPU 占用" Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                            <TextBlock x:Name="GpuNowText" Text="--" HorizontalAlignment="Right"
                                       FontSize="12" FontFamily="{StaticResource FontMono}" FontWeight="SemiBold" Foreground="{DynamicResource OkBrush}"/>
                        </Grid>
                        <Canvas x:Name="GpuChart" Height="72"/>
                    </StackPanel>
                    <StackPanel ToolTipService.HasDropShadow="True">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="显存占用（专用）" Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                            <TextBlock x:Name="VramNowText" Text="--" HorizontalAlignment="Right"
                                       FontSize="12" FontFamily="{StaticResource FontMono}" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                        </Grid>
                        <Canvas x:Name="VramChart" Height="72"/>
                        <TextBlock x:Name="VramNoteText" Text="" FontSize="10" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- 游戏路径 + 体检 -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="9*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="游戏路径 · GAME" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" Margin="0"/>
                        <Button Content="复制"
                                Style="{StaticResource GhostButtonStyle}"
                                Height="24" MinWidth="52"
                                HorizontalAlignment="Right"
                                Padding="8,0"
                                Click="CopyGamePath_Click"/>
                    </Grid>
                    <TextBlock x:Name="GamePathText" Text="--"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="{StaticResource FontMono}" FontSize="11.5"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="当前游戏" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="GameSwitcher" Style="{StaticResource SelectComboBoxStyle}"
                                  Margin="8,0,0,0" MaxDropDownHeight="280"
                                  SelectionChanged="GameSwitcher_SelectionChanged"/>
                        <Button Grid.Column="2" Content="重新扫描"
                                Style="{StaticResource GhostButtonStyle}"
                                Height="26" MinWidth="72" Margin="8,0,0,0"
                                Click="RescanGames_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="只读体检 · CHECK" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="CheckList"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="ForwardWheelToRoot">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="6" Height="6"
                                             Fill="{DynamicResource AccentBrush}"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                                        <TextBlock Text="{Binding Summary}" Foreground="{Binding Foreground}"
                                                   FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 优化项概览 -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,0,0,12" MinHeight="220" Padding="14,14,4,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="优化项概览 · ITEMS" Style="{StaticResource CardTitleStyle}"/>
                <ListBox x:Name="DetectItemList"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource CardListItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseWheel="ForwardWheelToRoot">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Id}"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SideEffect, StringFormat=副作用：{0}}"
                                               Foreground="{DynamicResource WarningBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding HasSideEffect, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Margin="10,0,0,0"
                                        Style="{StaticResource ChipStyle}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontFamily="{StaticResource FontMono}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Optimized}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 详情 -->
        <Border Grid.Row="5" Style="{StaticResource CardStyle}" Height="170">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock Text="检测详情 · JSON" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                    <Button Content="复制全部"
                            Style="{StaticResource GhostButtonStyle}"
                            HorizontalAlignment="Right"
                            MinWidth="72" Height="26"
                            Click="CopyDetail_Click"/>
                </Grid>
                <TextBox Grid.Row="1"
                         x:Name="OutputBox"
                         Style="{StaticResource MonoTextBoxStyle}"
                         IsReadOnly="True"
                         Margin="0,8,0,0"
                         PreviewMouseWheel="TextBoxWheelToRoot"
                         Text="点击“运行检测”开始。"/>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
