<UserControl x:Class="FpsTune.Wpf.Views.DetectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="28,22,28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource Str.NavDetect}" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="{DynamicResource Str.DetectIntro}"
                           Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <!-- P3-4：上次检测时间与耗时（进入页面即可见，不必先看输出框） -->
                <TextBlock x:Name="LastDetectText" Text=""
                           Style="{StaticResource MutedTextStyle}"
                           FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20,0,0,0">
                <Button x:Name="RunButton"
                        Content="{DynamicResource Str.RunDetect}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="110" Margin="0,0,10,0"
                        Click="RunButton_Click"/>
                <Button x:Name="LoadButton"
                        Content="{DynamicResource Str.LoadToOptimize}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="130"
                        Click="LoadButton_Click"/>
            </StackPanel>
        </Grid>


        <WrapPanel Grid.Row="1" Margin="0,0,0,16">
            <RadioButton Content="{DynamicResource Str.DetectOverview}" Tag="overview" GroupName="detectSection" IsChecked="True" Checked="DetectSection_Checked" Style="{StaticResource SectionNavigationStyle}" Margin="0,0,10,0"/>
            <RadioButton Content="{DynamicResource Str.ItemsOverview}" Tag="items" GroupName="detectSection" Checked="DetectSection_Checked" Style="{StaticResource SectionNavigationStyle}" Margin="0,0,10,0"/>
            <RadioButton Content="{DynamicResource Str.DetectDetails}" Tag="report" GroupName="detectSection" Checked="DetectSection_Checked" Style="{StaticResource SectionNavigationStyle}" Margin="0"/>
        </WrapPanel>
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,0">
        <!-- 硬件：发丝分隔的通栏 -->
        <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="14,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock x:Name="CpuText" Text="--"
                                   FontSize="13" FontWeight="{StaticResource SmallEmphasisWeight}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="14,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Text="GPU" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock x:Name="GpuText" Text="--"
                                   FontSize="13" FontWeight="{StaticResource SmallEmphasisWeight}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="14,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Memory}" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock x:Name="RamText" Text="--"
                                   FontSize="13" FontWeight="{StaticResource SmallEmphasisWeight}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.System}" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock x:Name="OsText" Text="--"
                                   FontSize="13" FontWeight="{StaticResource SmallEmphasisWeight}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Style="{StaticResource ChipStyle}" Margin="0,0,6,0">
                                <TextBlock x:Name="LaptopText" Text="--" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Style="{StaticResource ChipStyle}">
                                <TextBlock x:Name="AdminText" Text="--" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 实时监控 -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource Str.LiveMonitor}" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                    <TextBlock Text="{DynamicResource Str.SampleEverySecond}" Style="{StaticResource MutedTextStyle}" FontSize="12" HorizontalAlignment="Right"/>
                </Grid>
                <UniformGrid x:Name="ClassicMonitorPanel" Columns="4">
                    <StackPanel Margin="0,0,14,0">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="{DynamicResource Str.CpuUsage}" Style="{StaticResource MutedTextStyle}" FontSize="12"/>
                            <TextBlock x:Name="CpuNowText" Text="--" HorizontalAlignment="Right"
                                       FontSize="13" FontFamily="{StaticResource FontBody}" FontWeight="{StaticResource SmallEmphasisWeight}" Foreground="{DynamicResource AccentBrush}"/>
                        </Grid>
                        <Canvas x:Name="CpuChart" Height="72"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="{DynamicResource Str.MemoryUsage}" Style="{StaticResource MutedTextStyle}" FontSize="12"/>
                            <TextBlock x:Name="MemNowText" Text="--" HorizontalAlignment="Right"
                                       FontSize="13" FontFamily="{StaticResource FontBody}" FontWeight="{StaticResource SmallEmphasisWeight}" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Grid>
                        <Canvas x:Name="MemChart" Height="72"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="{DynamicResource Str.GpuUsage}" Style="{StaticResource MutedTextStyle}" FontSize="12"/>
                            <TextBlock x:Name="GpuNowText" Text="--" HorizontalAlignment="Right"
                                       FontSize="13" FontFamily="{StaticResource FontBody}" FontWeight="{StaticResource SmallEmphasisWeight}" Foreground="{DynamicResource OkBrush}"/>
                        </Grid>
                        <Canvas x:Name="GpuChart" Height="72"/>
                    </StackPanel>
                    <StackPanel ToolTipService.HasDropShadow="True">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="{DynamicResource Str.VramDedicated}" Style="{StaticResource MutedTextStyle}" FontSize="12"/>
                            <TextBlock x:Name="VramNowText" Text="--" HorizontalAlignment="Right"
                                       FontSize="13" FontFamily="{StaticResource FontBody}" FontWeight="{StaticResource SmallEmphasisWeight}" Foreground="{DynamicResource WarningBrush}"/>
                        </Grid>
                        <Canvas x:Name="VramChart" Height="72"/>
                        <TextBlock x:Name="VramNoteText" Text="" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- 游戏路径 + 体检 -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="9*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{DynamicResource Str.GamePath}" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" Margin="0"/>
                        <Button Content="{DynamicResource Str.Copy}"
                                Style="{StaticResource GhostButtonStyle}"
                                Height="24" MinWidth="52"
                                HorizontalAlignment="Right"
                                Padding="8,0"
                                Click="CopyGamePath_Click"/>
                    </Grid>
                    <TextBlock x:Name="GamePathText" Text="--"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="{StaticResource FontBody}" FontSize="13"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Str.CurrentGame}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="GameSwitcher" Style="{StaticResource SelectComboBoxStyle}"
                                  Margin="8,0,0,0" MaxDropDownHeight="280"
                                  SelectionChanged="GameSwitcher_SelectionChanged"/>
                        <Button Grid.Column="2" Content="{DynamicResource Str.Rescan}"
                                Style="{StaticResource GhostButtonStyle}"
                                Height="26" MinWidth="72" Margin="8,0,0,0"
                                Click="RescanGames_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.ReadOnlyCheckup}" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="CheckList"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,0,0,8" Foreground="{Binding Foreground}">
                                    <Expander.Header><Grid MinWidth="220"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"><Ellipse Width="6" Height="6" Fill="{Binding Foreground}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{Binding Summary}" FontSize="13"/></StackPanel>
                                    </Grid></Expander.Header>
                                    <TextBlock Text="{Binding Details}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap"/>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>


            </StackPanel></ScrollViewer>
            <Grid x:Name="DetectItemsSection" Visibility="Collapsed">        <!-- 优化项概览 -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="14,14,4,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0"><TextBlock Text="{DynamicResource Str.ItemsOverview}" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Str.DetectSearch}" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6"/><Grid Margin="0,0,10,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                        <TextBox Height="36" VerticalAlignment="Center" x:Name="DetectFilterText" TextChanged="DetectFilter_Changed" AutomationProperties.Name="{DynamicResource Str.DetectSearch}" ToolTip="{DynamicResource Str.DetectSearch}"/>
                        <ComboBox x:Name="DetectGroup" Grid.Column="1" Margin="12,0,0,0" SelectionChanged="DetectFilter_Changed" SelectedIndex="0" AutomationProperties.Name="{DynamicResource Str.OptCategory}">
                            <ComboBoxItem Content="{DynamicResource Str.AllCategories}" Tag=""/><ComboBoxItem Content="{DynamicResource Str.GroupKeyboardMouse}" Tag="键鼠"/><ComboBoxItem Content="{DynamicResource Str.GroupGraphics}" Tag="图形显示"/><ComboBoxItem Content="{DynamicResource Str.GroupNetwork}" Tag="网络"/><ComboBoxItem Content="{DynamicResource Str.GroupPower}" Tag="电源"/><ComboBoxItem Content="{DynamicResource Str.GroupSystem}" Tag="系统与调度"/>
                        </ComboBox>
                    </Grid><TextBlock x:Name="DetectItemCount" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,10"/>
                </StackPanel>
                <ListBox x:Name="DetectItemList" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource CardListItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        >
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Id}" Visibility="Collapsed"
                                           FontFamily="{StaticResource FontBody}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontWeight="{StaticResource SmallEmphasisWeight}"/>
                                    <Expander Header="{DynamicResource Str.DetectItemDetails}" Margin="0,6,0,0">
                                        <StackPanel><TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Current}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding SideEffect}" Foreground="{DynamicResource WarningBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding HasSideEffect, Converter={StaticResource BoolToVis}}"/></StackPanel>
                                    </Expander>
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Margin="10,0,0,0"
                                        Style="{StaticResource ChipStyle}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Optimized}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

</Grid>
            <Grid x:Name="DetectReportSection" Visibility="Collapsed">        <!-- 详情 -->
        <Border Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock Text="{DynamicResource Str.DetectDetails}" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                    <Button Content="{DynamicResource Str.CopyAll}"
                            Style="{StaticResource GhostButtonStyle}"
                            HorizontalAlignment="Right"
                            MinWidth="72" Height="26"
                            Click="CopyDetail_Click"/>
                </Grid>
                <TextBox Grid.Row="1"
                         x:Name="OutputBox"
                         Style="{StaticResource MonoTextBoxStyle}"
                         IsReadOnly="True"
                         Margin="0,8,0,0"

                         Text="{DynamicResource Str.ClickRunDetect}"/>
            </Grid>
        </Border>
</Grid>
        </Grid>
    </Grid>
</UserControl>
