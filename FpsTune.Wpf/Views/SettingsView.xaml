<UserControl x:Class="FpsTune.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="SettingsToggleStyle" TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitchStyle}">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style x:Key="SettingsChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="54"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="ChoiceBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12">
                    <ContentPresenter VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ChoiceBorder" Property="BorderThickness" Value="2"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18"><TextBlock Text="设置" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="选择一个分类即可调整，设置自动保存。" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"/></StackPanel>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,18">
            <RadioButton Content="外观与显示" GroupName="settingsSection" Tag="0" Checked="Section_Checked" Style="{StaticResource SettingsChoice}" IsChecked="True"/>
            <RadioButton Content="启动与通知" GroupName="settingsSection" Tag="1" Checked="Section_Checked" Style="{StaticResource SettingsChoice}"/>
            <RadioButton Content="游戏与方案" GroupName="settingsSection" Tag="2" Checked="Section_Checked" Style="{StaticResource SettingsChoice}"/>
            <RadioButton Content="数据与维护" GroupName="settingsSection" Tag="3" Checked="Section_Checked" Style="{StaticResource SettingsChoice}"/>
        </UniformGrid>
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="Section0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Visible"><StackPanel Margin="0,0,12,0">
<Border Style="{StaticResource CardStyle}"><StackPanel>                    <TextBlock Text="主题外观" Style="{StaticResource MutedTextStyle}" FontSize="13"/>
                    <UniformGrid Columns="3" Margin="0,12,0,16">
                        <RadioButton x:Name="ThemeDarkRadio" GroupName="defaultTheme" Style="{StaticResource SettingsChoice}" AutomationProperties.Name="深色主题">
                            <StackPanel><Border Height="26" Background="#07090B" CornerRadius="3" Margin="0,0,0,10"/>
                                <TextBlock Text="深色" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="近黑背景 · 青色强调" FontSize="13" Margin="0,5,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ThemeLightRadio" GroupName="defaultTheme" Style="{StaticResource SettingsChoice}" AutomationProperties.Name="浅色主题">
                            <StackPanel><Border Height="26" Background="#F7F9FC" CornerRadius="3" Margin="0,0,0,10"/>
                                <TextBlock Text="浅色" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="明亮纸面 · 清晰阅读" FontSize="13" Margin="0,5,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ThemeSystemRadio" GroupName="defaultTheme" Style="{StaticResource SettingsChoice}" AutomationProperties.Name="跟随系统主题">
                            <StackPanel><Border Height="26" Background="#64748B" CornerRadius="3" Margin="0,0,0,10"/>
                                <TextBlock Text="跟随系统" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="随 Windows 外观自动变化" FontSize="13" Margin="0,5,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                    <CheckBox x:Name="AuroraCheck"
                              Style="{StaticResource SettingsToggleStyle}"
                              Content="显示极光背景（经典界面）"
                              Margin="0,10,0,0"/>
                    <CheckBox x:Name="LowSpecCheck"
                              Style="{StaticResource SettingsToggleStyle}"
                              Content="低配模式（减少动画，实时采样改为每 3 秒一次）"
                              Margin="0,10,0,0"/>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,18,0,14"/>
                    <TextBlock Text="界面模式" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="控制台用数字和进度条显示检测数据；经典界面保留原有概览和曲线。" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="ConsoleModeRadio" GroupName="displayMode" Tag="console" Checked="DisplayMode_Checked" Content="紧凑控制台" Style="{StaticResource SettingsChoice}"/>
                        <RadioButton x:Name="ClassicModeRadio" GroupName="displayMode" Tag="classic" Checked="DisplayMode_Checked" Content="经典概览" Style="{StaticResource SettingsChoice}"/>
                    </UniformGrid>
</StackPanel></Border>
            </StackPanel></ScrollViewer>
            <ScrollViewer x:Name="Section1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="0,0,12,0">
<Border Style="{StaticResource CardStyle}"><StackPanel>                    <TextBlock Text="启动" Style="{StaticResource MutedTextStyle}" FontSize="13"/>
                    <CheckBox x:Name="AutostartCheck"
                              Style="{StaticResource SettingsToggleStyle}"
                              Content="登录 Windows 后自动运行 FPS 帧律（当前用户）"
                              Margin="0,8,0,0"/>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,12"/>

                    <TextBlock Text="托盘与通知" Style="{StaticResource MutedTextStyle}" FontSize="13"/>
                    <CheckBox x:Name="TrayCheck"
                              Style="{StaticResource SettingsToggleStyle}"
                              Content="最小化到系统托盘（不占任务栏，托盘图标双击呼出）"
                              Margin="0,8,0,0"/>
                    <CheckBox x:Name="HotkeyCheck"
                              Style="{StaticResource SettingsToggleStyle}"
                              Content="全局热键 Ctrl + Alt + F 呼出主窗口"
                              Margin="0,10,0,0"/>
                    <CheckBox x:Name="NotifyCheck"
                              Style="{StaticResource SettingsToggleStyle}"
                              Content="优化 / 实验完成时弹出托盘通知"
                              Margin="0,10,0,0"/>
</StackPanel></Border>
            </StackPanel></ScrollViewer>
            <ScrollViewer x:Name="Section2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="0,0,12,0">
            <!-- 游戏 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="游戏" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="手动指定游戏 EXE，用于全屏优化 / GPU 偏好 / 进程优先级三类优化；留空则自动检测主流 FPS。"
                               Style="{StaticResource MutedTextStyle}" FontSize="13" TextWrapping="Wrap"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GamePathBox"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 VerticalContentAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                            <Button Content="浏览..."
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="76" Margin="0,0,8,0"
                                    Click="BrowseGame_Click"/>
                            <Button Content="清除"
                                    Style="{StaticResource GhostButtonStyle}"
                                    MinWidth="56"
                                    Click="ClearGame_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="GamePathHint"
                               Text="未指定"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 按游戏自动应用 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="按游戏自动应用" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="仅按游戏进程名每 3 秒轮询启动边沿，不读取进程路径、内存或注入进程。国服与国际服若使用同一进程名，当前接口无法区分，只能保留一个绑定。"
                               Style="{StaticResource MutedTextStyle}" FontSize="13" TextWrapping="Wrap"/>
                    <CheckBox x:Name="AutoProfileCheck"
                              Style="{StaticResource SettingsToggleStyle}"
                              Content="检测到绑定游戏启动时自动应用对应方案"
                              Margin="0,10,0,0"
                              Checked="AutoProfileSetting_Changed"
                              Unchecked="AutoProfileSetting_Changed"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="GameCandidateCombo"
                                  Style="{StaticResource SelectComboBoxStyle}"
                                  MinHeight="34"
                                  Margin="0,0,8,0"
                                  ToolTip="已扫描的游戏候选">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding ExePath}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox x:Name="ProfileCombo"
                                  Grid.Column="1"
                                  Style="{StaticResource SelectComboBoxStyle}"
                                  DisplayMemberPath="Name"
                                  MinHeight="34"
                                  Margin="0,0,8,0"
                                  ToolTip="已保存的配置方案"/>
                        <Button Grid.Column="2"
                                Content="添加绑定"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="92"
                                Click="AddAutoProfileBinding_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="重新扫描游戏 / 方案"
                                Style="{StaticResource GhostButtonStyle}"
                                MinWidth="140"
                                Margin="0,0,10,0"
                                Click="RefreshAutoProfileData_Click"/>
                        <TextBlock x:Name="AutoProfileStatusText"
                                   Text="尚未扫描"
                                   Style="{StaticResource MutedTextStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <ListBox x:Name="AutoBindingList"
                             Margin="0,12,0,0"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource CardListItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="13">
                                            <Run Text="进程："/>
                                            <Run Text="{Binding ProcessName}" FontFamily="{StaticResource FontMono}"/>
                                            <Run Text="  ·  方案："/>
                                            <Run Text="{Binding ProfileName}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ExePath}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              Style="{StaticResource SettingsToggleStyle}"
                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="12,0,12,0"
                                              Checked="AutoProfileBinding_Changed"
                                              Unchecked="AutoProfileBinding_Changed"/>
                                    <Button Grid.Column="2"
                                            Content="删除"
                                            Style="{StaticResource GhostButtonStyle}"
                                            MinWidth="48"
                                            VerticalAlignment="Center"
                                            Click="RemoveAutoProfileBinding_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 活动中心：本地审计事件，可解释自动应用都发生了什么 -->
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,12"/>
                    <Grid>
                        <TextBlock Text="活动记录（最近事件，仅保存在本机）" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBox x:Name="ActivityFilter"
                                      Style="{StaticResource SelectComboBoxStyle}"
                                      MinHeight="28" MinWidth="96" Margin="0,0,8,0"
                                      SelectionChanged="ActivityFilter_SelectionChanged">
                                <ComboBoxItem Content="全部" IsSelected="True"/>
                                <ComboBoxItem Content="已应用"/>
                                <ComboBoxItem Content="跳过"/>
                                <ComboBoxItem Content="失败"/>
                                <ComboBoxItem Content="匹配"/>
                            </ComboBox>
                            <Button Content="清除记录"
                                    Style="{StaticResource GhostButtonStyle}"
                                    MinWidth="76"
                                    Click="ClearActivity_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ActivityScanText"
                               Style="{StaticResource MutedTextStyle}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                    <ListBox x:Name="ActivityList"
                             Margin="0,10,0,0"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="210"
                             ItemContainerStyle="{StaticResource CardListItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource ChipStyle}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding KindText}" FontSize="10.5" FontFamily="{StaticResource FontMono}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="13" FontFamily="{StaticResource FontMono}"
                                               Margin="10,0,10,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="13"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ActivityEmptyText"
                               Text="暂无活动记录。检测到绑定游戏启动（或触发被跳过/失败）时，这里会显示原因与结果。"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>


            </StackPanel></ScrollViewer>
            <ScrollViewer x:Name="Section3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="0,0,12,0">
            <!-- 高级 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="高级与维护" Style="{StaticResource CardTitleStyle}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="AdminStatusText"
                                   Text="当前非管理员"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="AdminRestartButton"
                                Content="以管理员身份重启"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="150" Margin="14,0,0,0"
                                Click="AdminRestartButton_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="打开数据目录"
                                Style="{StaticResource GhostButtonStyle}"
                                MinWidth="110" Margin="0,0,6,0"
                                Click="OpenData_Click"/>
                        <Button Content="打开日志目录"
                                Style="{StaticResource GhostButtonStyle}"
                                MinWidth="110" Margin="0,0,6,0"
                                Click="OpenLogs_Click"/>
                        <Button Content="打开备份目录"
                                Style="{StaticResource GhostButtonStyle}"
                                MinWidth="110" Margin="0,0,6,0"
                                Click="OpenBackups_Click"/>
                        <Button Content="导出诊断报告"
                                Style="{StaticResource GhostButtonStyle}"
                                MinWidth="110"
                                Click="ExportDiagnostics_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="关于" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock x:Name="VersionText" Text="版本：v1.0.0"
                               Foreground="{DynamicResource AccentBrush}" FontFamily="{StaticResource FontMono}" FontWeight="SemiBold"/>
                    <TextBlock Text="FPS 帧律：面向 Windows 的系统层帧率优化工具，全 FPS 游戏通用。"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Text="只调整 Windows 系统层设置：不修改游戏文件、不注入进程、不与反作弊交互、不关闭引导虚拟化、不做显卡伪装；所有改动写入前自动备份，可一键还原。"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="CheckUpdateButton"
                                Content="检查更新"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="110" Margin="0,0,10,0"
                                Click="CheckUpdateButton_Click"/>
                        <Button Content="GitHub 主页"
                                Style="{StaticResource GhostButtonStyle}"
                                MinWidth="100" Margin="0,0,14,0"
                                Click="OpenGitHub_Click"/>
                        <TextBlock x:Name="UpdateStatusText"
                                   Text="未检查"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="联系方式仅接受合作/反馈。"
                               Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>


            </StackPanel></ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
