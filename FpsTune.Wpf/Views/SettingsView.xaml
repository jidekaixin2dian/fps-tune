<UserControl x:Class="FpsTune.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="WallpaperSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="36"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="0.01"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border x:Name="FocusRing" Margin="0,3" CornerRadius="10" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Visibility="Collapsed"/>
                            <Border Height="4" Margin="9,0" CornerRadius="2" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" Margin="3,0" Orientation="Horizontal"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent"><Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/></Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20" Focusable="False" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Handle" Margin="2" CornerRadius="8" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger>
                                                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsToggleStyle" TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitchStyle}">
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style x:Key="SettingsChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="54"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="ChoiceBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="16,12">
                    <ContentPresenter VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ChoiceBorder" Property="BorderThickness" Value="2"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SettingsRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,12,0,12"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20"><TextBlock Text="{DynamicResource Str.NavSettings}" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="{DynamicResource Str.SettingsIntro}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"/></StackPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,24,0"><RadioButton x:Name="SettingsNav0" Content="{DynamicResource Str.SettingsAppearance}" GroupName="settingsSection" Tag="0" Checked="Section_Checked" Style="{StaticResource SectionNavigationStyle}" IsChecked="True"/>
<RadioButton x:Name="SettingsNav4" Content="{DynamicResource Str.Wallpaper}" GroupName="settingsSection" Tag="4" Checked="Section_Checked" Style="{StaticResource SectionNavigationStyle}"/>
<RadioButton x:Name="SettingsNav1" Content="{DynamicResource Str.SettingsStartup}" GroupName="settingsSection" Tag="1" Checked="Section_Checked" Style="{StaticResource SectionNavigationStyle}"/>
<RadioButton x:Name="SettingsNav2" Content="{DynamicResource Str.SettingsGame}" GroupName="settingsSection" Tag="2" Checked="Section_Checked" Style="{StaticResource SectionNavigationStyle}"/>
<RadioButton x:Name="SettingsNav3" Content="{DynamicResource Str.SettingsData}" GroupName="settingsSection" Tag="3" Checked="Section_Checked" Style="{StaticResource SectionNavigationStyle}"/>
<RadioButton x:Name="SettingsNav5" Content="{DynamicResource Str.SectionAbout}" GroupName="settingsSection" Tag="5" Checked="Section_Checked" Style="{StaticResource SectionNavigationStyle}"/></StackPanel>
            <Grid Grid.Column="1" MaxWidth="960" HorizontalAlignment="Stretch"><ScrollViewer x:Name="Section0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Visible"><StackPanel Margin="0,0,14,0">
<Border Style="{StaticResource CardStyle}"><StackPanel>                    <TextBlock Text="{DynamicResource Str.ThemeLabel}" Style="{StaticResource MutedTextStyle}" FontSize="13"/>

                    <UniformGrid Columns="3" Margin="0,12,0,20">
                        <RadioButton x:Name="ThemeDarkRadio" GroupName="defaultTheme" Style="{StaticResource SettingsChoice}" AutomationProperties.Name="{DynamicResource Str.ThemeDark}">
                            <StackPanel><Border Height="26" Background="#07090B" CornerRadius="3" Margin="0,0,0,10"/>
                                <TextBlock Text="{DynamicResource Str.ThemeDarkShort}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Str.ThemeDarkDesc}" TextWrapping="Wrap" FontSize="13" Margin="0,5,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ThemeLightRadio" GroupName="defaultTheme" Style="{StaticResource SettingsChoice}" AutomationProperties.Name="{DynamicResource Str.ThemeLight}">
                            <StackPanel><Border Height="26" Background="#F7F9FC" CornerRadius="3" Margin="0,0,0,10"/>
                                <TextBlock Text="{DynamicResource Str.ThemeLightShort}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Str.ThemeLightDesc}" TextWrapping="Wrap" FontSize="13" Margin="0,5,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ThemeSystemRadio" GroupName="defaultTheme" Style="{StaticResource SettingsChoice}" AutomationProperties.Name="{DynamicResource Str.ThemeSystem}">
                            <StackPanel><Border Height="26" Background="#64748B" CornerRadius="3" Margin="0,0,0,10"/>
                                <TextBlock Text="{DynamicResource Str.ThemeSystemShort}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Str.ThemeSystemDesc}" TextWrapping="Wrap" FontSize="13" Margin="0,5,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,20"/>
                    <StackPanel Margin="0,2,0,0">
                        <TextBlock Text="{DynamicResource Str.LanguageLabel}" Style="{StaticResource MutedTextStyle}" FontSize="13"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <RadioButton x:Name="LangZhRadio" GroupName="uiLang" Content="{DynamicResource Str.LanguageZh}"
                                         Style="{StaticResource SettingsChoice}" Checked="Lang_Checked"/>
                            <RadioButton x:Name="LangEnRadio" GroupName="uiLang" Content="{DynamicResource Str.LanguageEn}"
                                         Style="{StaticResource SettingsChoice}" Checked="Lang_Checked"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Str.LanguageNote}" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,18,0,14"/>
                    <TextBlock Text="{DynamicResource Str.DisplayMode}" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Str.DisplayModeDesc}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="ConsoleModeRadio" GroupName="displayMode" Tag="console" Checked="DisplayMode_Checked" Content="{DynamicResource Str.CompactConsole}" Style="{StaticResource SettingsChoice}"/>
                        <RadioButton x:Name="StudioModeRadio" GroupName="displayMode" Tag="studio" Checked="DisplayMode_Checked" Content="{DynamicResource Str.Workspace}" Style="{StaticResource SettingsChoice}"/>
                    </UniformGrid>
</StackPanel></Border>
</StackPanel></ScrollViewer><ScrollViewer x:Name="Section1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="0,0,14,0"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="{DynamicResource Str.SettingsStartup}" Style="{StaticResource CardTitleStyle}"/><Grid Style="{StaticResource SettingsRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,24,0"><TextBlock Text="{DynamicResource Str.StartupShort}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
            <TextBlock Text="{DynamicResource Str.StartupHint}" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
        <CheckBox x:Name="AutostartCheck" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Str.StartupShort}" />
    </Grid><Grid Style="{StaticResource SettingsRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,24,0"><TextBlock Text="{DynamicResource Str.TrayShort}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
            <TextBlock Text="{DynamicResource Str.TrayHint}" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
        <CheckBox x:Name="TrayCheck" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Str.TrayShort}" />
    </Grid><Grid Style="{StaticResource SettingsRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,24,0"><TextBlock Text="{DynamicResource Str.HotkeyShort}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
            <TextBlock Text="{DynamicResource Str.HotkeyHint}" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
        <CheckBox x:Name="HotkeyCheck" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Str.HotkeyShort}" />
    </Grid><Grid Style="{StaticResource SettingsRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,24,0"><TextBlock Text="{DynamicResource Str.NotifyShort}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
            <TextBlock Text="{DynamicResource Str.NotifyHint}" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
        <CheckBox x:Name="NotifyCheck" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Str.NotifyShort}" />
    </Grid></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><StackPanel><TextBlock Text="{DynamicResource Str.SettingsPerformance}" Style="{StaticResource CardTitleStyle}"/><Grid Style="{StaticResource SettingsRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,24,0"><TextBlock Text="{DynamicResource Str.LowSpecShort}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
            <TextBlock Text="{DynamicResource Str.LowSpecHint}" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
        <CheckBox x:Name="LowSpecCheck" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Str.LowSpecShort}" />
    </Grid></StackPanel></Border></StackPanel></ScrollViewer><ScrollViewer x:Name="Section2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="0,0,12,0">
            <!-- 游戏 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.SectionGame}" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Str.GamePathDesc}"
                               Style="{StaticResource MutedTextStyle}" FontSize="13" TextWrapping="Wrap"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GamePathBox"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 VerticalContentAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                            <Button Content="{DynamicResource Str.Browse}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="76" Margin="0,0,8,0"
                                    Click="BrowseGame_Click"/>
                            <Button Content="{DynamicResource Str.Clear}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    MinWidth="56"
                                    Click="ClearGame_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="GamePathHint"
                               Text="{DynamicResource Str.NotSpecified}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 按游戏自动应用 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.AutoApplyByGame}" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Str.AutoApplyDesc}"
                               Style="{StaticResource MutedTextStyle}" FontSize="13" TextWrapping="Wrap"/>
                    <CheckBox x:Name="AutoProfileCheck"
                              Style="{StaticResource SettingsToggleStyle}"
                              Content="{DynamicResource Str.AutoApplyToggle}"
                              Margin="0,10,0,0"
                              Checked="AutoProfileSetting_Changed"
                              Unchecked="AutoProfileSetting_Changed"/>

                    <UniformGrid Columns="2" Margin="0,14,100,6"><TextBlock Text="{DynamicResource Str.SectionGame}" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{DynamicResource Str.TipSavedProfiles}" Style="{StaticResource MutedTextStyle}"/></UniformGrid>
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="GameCandidateCombo"
                                  Style="{StaticResource SelectComboBoxStyle}"
                                  MinHeight="34"
                                  Margin="0,0,8,0"
                                  ToolTip="{DynamicResource Str.TipScannedGames}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding ExePath}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox x:Name="ProfileCombo"
                                  Grid.Column="1"
                                  Style="{StaticResource SelectComboBoxStyle}"
                                  MinHeight="34"
                                  Margin="0,0,8,0"
                                  ToolTip="{DynamicResource Str.TipSavedProfiles}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="2"
                                Content="{DynamicResource Str.AddBinding}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="92"
                                Click="AddAutoProfileBinding_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{DynamicResource Str.RescanGamesProfiles}"
                                Style="{StaticResource GhostButtonStyle}"
                                MinWidth="140"
                                Margin="0,0,10,0"
                                Click="RefreshAutoProfileData_Click"/>
                        <TextBlock x:Name="AutoProfileStatusText"
                                   Text="{DynamicResource Str.NotScannedYet}"
                                   Style="{StaticResource MutedTextStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <ListBox x:Name="AutoBindingList"
                             Margin="0,12,0,0"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource CardListItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="13">
                                            <Run Text="{DynamicResource Str.LabelProcess}"/>
                                            <Run Text="{Binding ProcessName, Mode=OneWay}" FontFamily="{StaticResource FontMono}"/>
                                            <Run Text="{DynamicResource Str.LabelProfile}"/>
                                            <Run Text="{Binding ProfileName, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ExePath}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              Style="{StaticResource SettingsToggleStyle}"
                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="12,0,12,0"
                                              Checked="AutoProfileBinding_Changed"
                                              Unchecked="AutoProfileBinding_Changed"/>
                                    <Button Grid.Column="2"
                                            Content="{DynamicResource Str.Delete}"
                                            Style="{StaticResource GhostButtonStyle}"
                                            MinWidth="48"
                                            VerticalAlignment="Center"
                                            Click="RemoveAutoProfileBinding_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

<Expander Header="{DynamicResource Str.ActivityLogTitle}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,18,0,0"><StackPanel Margin="0,12,0,0">                    <!-- 活动中心：本地审计事件，可解释自动应用都发生了什么 -->
                    <Grid>
                        <TextBlock Text="{DynamicResource Str.ActivityLogTitle}" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBox x:Name="ActivityFilter"
                                      Style="{StaticResource SelectComboBoxStyle}"
                                      MinHeight="28" MinWidth="96" Margin="0,0,8,0"
                                      SelectionChanged="ActivityFilter_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource Str.GroupAll}" IsSelected="True"/>
                                <ComboBoxItem Content="{DynamicResource Str.ActivityApplied}"/>
                                <ComboBoxItem Content="{DynamicResource Str.ActivitySkipped}"/>
                                <ComboBoxItem Content="{DynamicResource Str.ActivityFailed}"/>
                                <ComboBoxItem Content="{DynamicResource Str.ActivityMatched}"/>
                            </ComboBox>
                            <Button Content="{DynamicResource Str.ClearActivity}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    MinWidth="76"
                                    Click="ClearActivity_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ActivityScanText"
                               Style="{StaticResource MutedTextStyle}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                    <ListBox x:Name="ActivityList"
                             Margin="0,10,0,0"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="210"
                             ItemContainerStyle="{StaticResource CardListItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource ChipStyle}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding KindText}" FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="13" FontFamily="{StaticResource FontMono}"
                                               Margin="10,0,10,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="13"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ActivityEmptyText"
                               Text="{DynamicResource Str.NoActivity}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,10,0,0" TextWrapping="Wrap"/>
</StackPanel></Expander>
                </StackPanel>
            </Border>


            </StackPanel></ScrollViewer><ScrollViewer x:Name="Section3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="0,0,12,0">
            <!-- 高级 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.SectionAdvanced}" Style="{StaticResource CardTitleStyle}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="AdminStatusText"
                                   Text="{DynamicResource Str.NotAdminNow}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="AdminRestartButton"
                                Content="{DynamicResource Str.RestartAsAdmin}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="150" Margin="14,0,0,0"
                                Click="AdminRestartButton_Click"/>
                    </StackPanel>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="{DynamicResource Str.OpenDataDir}"
                                Style="{StaticResource GhostButtonStyle}"
                                MinWidth="110" Margin="0,0,6,0"
                                Click="OpenData_Click"/>
                        <Button Content="{DynamicResource Str.OpenLogDir}"
                                Style="{StaticResource GhostButtonStyle}"
                                MinWidth="110" Margin="0,0,6,0"
                                Click="OpenLogs_Click"/>
                        <Button Content="{DynamicResource Str.OpenBackupDir}"
                                Style="{StaticResource GhostButtonStyle}"
                                MinWidth="110" Margin="0,0,6,0"
                                Click="OpenBackups_Click"/>
                        <Button Content="{DynamicResource Str.ExportDiagnostics}"
                                Style="{StaticResource GhostButtonStyle}"
                                MinWidth="110"
                                Click="ExportDiagnostics_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

</StackPanel></ScrollViewer>
<ScrollViewer x:Name="Section4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="0,0,14,0">                <Border Style="{StaticResource CardStyle}" Margin="0"><StackPanel>
                    <TextBlock Text="{DynamicResource Str.Wallpaper}" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Str.WallpaperIntro}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="WallpaperPreviewFrame" Width="176" Height="176" CornerRadius="16"
                                Background="{DynamicResource AppBackdropBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Border x:Name="WallpaperPreviewImage" Margin="1" CornerRadius="15"
                                        Opacity="{Binding ElementName=WallpaperOpacitySlider, Path=Value}"/>
                                <StackPanel x:Name="WallpaperPreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M 2,22 L 12,10 L 19,18 L 25,12 L 34,22 M 24,5 A 3,3 0 1 0 30,5 A 3,3 0 1 0 24,5"
                                          Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5" Width="36" Height="26" Stretch="Uniform" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Str.WallpaperChoose}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,12,0,0"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="7,3" CornerRadius="5" Background="{DynamicResource ElevatedBrush}">
                                    <TextBlock Text="{DynamicResource Str.WallpaperPreview}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="24,0,0,0" Width="300" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <CheckBox x:Name="WallpaperEnabledCheck" Content="{DynamicResource Str.WallpaperShow}" Style="{StaticResource SettingsToggleStyle}" Checked="WallpaperEnabled_Changed" Unchecked="WallpaperEnabled_Changed"/>
                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="{DynamicResource Str.WallpaperOpacity}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}" Padding="8,3">
                                    <TextBlock x:Name="WallpaperOpacityValue" Text="{Binding ElementName=WallpaperOpacitySlider, Path=Value, StringFormat={}{0:P0}}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                            <Slider x:Name="WallpaperOpacitySlider" Style="{StaticResource WallpaperSliderStyle}" Margin="0,4,0,0"
                                    AutomationProperties.Name="{DynamicResource Str.WallpaperOpacity}"
                                    Minimum="0.05" Maximum="0.35" Value="0.18" SmallChange="0.01" LargeChange="0.05" ValueChanged="WallpaperOpacity_Changed"/>
                            <Grid Margin="4,-2,4,12"><TextBlock Text="5%" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                <TextBlock Text="35%" HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/></Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource Str.WallpaperChoose}" Click="WallpaperChoose_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                                <Button Content="{DynamicResource Str.WallpaperRemove}" Click="WallpaperRemove_Click" Style="{StaticResource GhostButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="WallpaperStatus" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel></Border>
            </StackPanel></ScrollViewer>
<ScrollViewer x:Name="Section5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="0,0,14,0">            <!-- 关于 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.SectionAbout}" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock x:Name="VersionText" Text="{DynamicResource Str.VersionLabel}"
                               Foreground="{DynamicResource AccentBrush}" FontFamily="{StaticResource FontMono}" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource Str.AboutLine1}"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Text="{DynamicResource Str.AboutLine2}"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="CheckUpdateButton"
                                Content="{DynamicResource Str.CheckUpdate}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="110" Margin="0,0,10,0"
                                Click="CheckUpdateButton_Click"/>
                        <Button Content="{DynamicResource Str.GitHubHome}"
                                Style="{StaticResource GhostButtonStyle}"
                                MinWidth="100" Margin="0,0,14,0"
                                Click="OpenGitHub_Click"/>
                        <Button Content="{DynamicResource Str.Licenses}" Style="{StaticResource GhostButtonStyle}"
                                Margin="0,0,12,0" Click="OpenLicenses_Click"/>
                        <TextBlock x:Name="UpdateStatusText"
                                   Text="{DynamicResource Str.NotChecked}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </WrapPanel>
                    <ProgressBar x:Name="UpdateProgressBar"
                                 Style="{StaticResource ThinMeterStyle}"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Maximum="100"
                                 Visibility="Collapsed"
                                 Margin="0,10,0,0"/>
<Grid Style="{StaticResource SettingsRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,24,0"><TextBlock Text="{DynamicResource Str.CheckUpdatesOnStartup}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
            <TextBlock Text="{DynamicResource Str.UpdateHint}" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
        <CheckBox x:Name="StartupUpdateCheck" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Str.CheckUpdatesOnStartup}" Checked="StartupUpdate_Changed" Unchecked="StartupUpdate_Changed"/>
    </Grid>
                    <TextBlock Text="{DynamicResource Str.ContactNote}"
                               Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>


            </StackPanel></ScrollViewer>
</Grid></Grid></Grid>
</UserControl>
