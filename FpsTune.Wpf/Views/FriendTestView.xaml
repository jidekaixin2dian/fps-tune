<UserControl x:Class="FpsTune.Wpf.Views.FriendTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str.NavFriend}" Style="{StaticResource SectionLabelStyle}"/>
                <TextBlock Text="{DynamicResource Str.FriendIntro}"
                           Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button x:Name="GenerateButton"
                        Content="{DynamicResource Str.GenerateRecord}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="130" Margin="0,0,10,0"
                        Click="GenerateButton_Click"/>
                <Button x:Name="OpenOutputButton"
                        Content="{DynamicResource Str.OpenOutputDir}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="120"
                        Click="OpenOutputButton_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="54*"/>
            </Grid.ColumnDefinitions>

            <!-- 表单 -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <ScrollViewer x:Name="FormScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.BasicInfo}" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Str.Nickname}" Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                        <TextBox x:Name="NameBox" Style="{StaticResource InputTextBoxStyle}" Margin="0,4,0,14"/>

                        <TextBlock Text="{DynamicResource Str.SceneQualitySettings}" Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                        <TextBox x:Name="SceneBox" Style="{StaticResource InputTextBoxStyle}" Margin="0,4,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Str.FpsBeforeAvg}" Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                                <TextBox x:Name="BeforeAvgBox" Style="{StaticResource InputTextBoxStyle}" Margin="0,4,0,14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Str.FpsBeforeLow}" Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                                <TextBox x:Name="BeforeP1Box" Style="{StaticResource InputTextBoxStyle}" Margin="0,4,0,14"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Str.FpsAfterAvg}" Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                                <TextBox x:Name="AfterAvgBox" Style="{StaticResource InputTextBoxStyle}" Margin="0,4,0,14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Str.FpsAfterLow}" Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                                <TextBox x:Name="AfterP1Box" Style="{StaticResource InputTextBoxStyle}" Margin="0,4,0,14"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{DynamicResource Str.Remarks}" Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                        <!-- 多行输入框: 滚到边时把滚轮还给外层表单滚动, 由 code-behind 处理 -->
                        <TextBox x:Name="NotesBox"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Height="84"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 PreviewMouseWheel="NotesBoxWheelToRoot"
                                 Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 预览 -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource Str.MarkdownPreview}" Style="{StaticResource CardTitleStyle}"/>
                    <TextBox Grid.Row="1"
                             x:Name="PreviewBox"
                             Style="{StaticResource MonoTextBoxStyle}"
                             IsReadOnly="True"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
