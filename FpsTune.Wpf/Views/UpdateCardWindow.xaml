<Window x:Class="FpsTune.Wpf.Views.UpdateCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.UpdateAvailable}" Width="420" Height="360"
        ResizeMode="NoResize" WindowStyle="ToolWindow" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource FontBody}" WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel>
            <Button x:Name="FoldButton" DockPanel.Dock="Right" Content="{DynamicResource Str.UpdateCollapse}"
                    Click="Fold_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <StackPanel><TextBlock Text="{DynamicResource Str.UpdateAvailable}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
        </DockPanel>
        <Grid x:Name="Details" Grid.Row="1" Margin="0,18,0,0">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="13"/></ScrollViewer>
            <StackPanel Grid.Row="1" Margin="0,12,0,12"><TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12"/>
                <ProgressBar x:Name="DownloadProgress" Height="4" Maximum="100" Visibility="Collapsed" Margin="0,8,0,0"/></StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Str.UpdateLater}" Click="Fold_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                <Button x:Name="InstallButton" Content="{DynamicResource Str.UpdateNow}" Click="Install_Click" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
