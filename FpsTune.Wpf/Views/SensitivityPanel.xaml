<UserControl x:Class="FpsTune.Wpf.Views.SensitivityPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top"><StackPanel>
        <TextBlock Text="{DynamicResource Str.SensTitle}" Style="{StaticResource CardTitleStyle}"/>
        <TextBlock Text="{DynamicResource Str.SensHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>

        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Str.SensDpi}" VerticalAlignment="Center" Margin="0,0,12,8"/>
            <TextBox x:Name="DpiBox" Grid.Column="1" Text="800" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,12,8"
                     VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource Str.SensDpi}"/>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Str.SensValue}" VerticalAlignment="Center" Margin="0,0,12,8"/>
            <TextBox x:Name="SensBox" Grid.Column="1" Text="1.00" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,12,8"
                     VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource Str.SensValue}"/>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Str.SensGame}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <ComboBox x:Name="GameCombo" Grid.Column="1" Style="{StaticResource SelectComboBoxStyle}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{DynamicResource Str.SensGame}" SelectionChanged="Input_Changed"/>
        </Grid>

        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusControl}" Padding="16,12" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock x:Name="CmText" Style="{StaticResource CardTitleStyle}" Text="—"/>
                <TextBlock x:Name="EdpiText" Style="{StaticResource MutedTextStyle}" Text="" Margin="0,6,0,0"/>
                <TextBlock x:Name="OtherText" Style="{StaticResource MutedTextStyle}" Text="" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="SensError" Style="{StaticResource MutedTextStyle}" Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
    </StackPanel></Border>
</UserControl>
