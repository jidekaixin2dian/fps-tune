<UserControl x:Class="FpsTune.Wpf.Views.GameLibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FpsTune.Wpf.Views.Controls"
    Background="{DynamicResource AppBackgroundBrush}" FontFamily="{StaticResource FontBody}">
    <Grid Margin="32,26,32,28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button x:Name="DiscoverButton" Content="{DynamicResource Str.LibraryDiscover}" Style="{StaticResource SecondaryButtonStyle}" Click="Discover_Click" Margin="0,0,8,0"/>
                <Button x:Name="AddGameButton" Content="{DynamicResource Str.LibraryAdd}" Style="{StaticResource PrimaryButtonStyle}" Click="Add_Click"/>
            </WrapPanel>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="{DynamicResource Str.NavGames}" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="{DynamicResource Str.LibraryIntro}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid><TextBox x:Name="SearchBox" Style="{StaticResource InputTextBoxStyle}" MaxLength="160" TextChanged="Search_Changed" AutomationProperties.Name="{DynamicResource Str.LibrarySearch}"/>
                <TextBlock Text="{DynamicResource Str.LibrarySearch}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </Grid>
            <Button Grid.Column="1" x:Name="RefreshButton" Content="{DynamicResource Str.Refresh}" Style="{StaticResource GhostButtonStyle}" Click="Refresh_Click" Margin="12,0,0,0"/>
        </Grid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="8">
                <Grid><ListBox x:Name="GameList" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource CardListItemStyle}" SelectionChanged="Game_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,3">
                        <DockPanel><TextBlock Text="{Binding CurrentLabel}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="8,0,0,0"/><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="{DynamicResource SmallEmphasisWeight}" TextTrimming="CharacterEllipsis"/></DockPanel>
                        <TextBlock Text="{Binding ProcessLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,6,0,0"/>
                        <controls:FileNameLabel Text="{Binding Profile.ExePath}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" ToolTip="{Binding Profile.ExePath}" Margin="0,4,0,0"/>
                    </StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Text="{DynamicResource Str.LibraryEmpty}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="16"/>
                </Grid>
            </Border>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DetailPanel" IsEnabled="False" Margin="0,0,6,0">
                    <Border x:Name="GameDetailCard" Style="{StaticResource CardStyle}"><StackPanel>
                        <TextBlock x:Name="GameNameText" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="GamePathText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                        <TextBlock x:Name="ProcessText" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>
                        <WrapPanel><Button x:Name="SelectGameButton" Content="{DynamicResource Str.LibrarySelect}" Style="{StaticResource PrimaryButtonStyle}" Click="Select_Click" Margin="0,0,8,6"/><Button x:Name="DetectGameButton" Content="{DynamicResource Str.LibraryDetect}" Style="{StaticResource SecondaryButtonStyle}" Click="Route_Click" Tag="detect" Margin="0,0,0,6"/></WrapPanel>
                    </StackPanel></Border>
                    <Border x:Name="GameWorkflowCard" Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel>
                        <TextBlock Text="{DynamicResource Str.LibraryWorkspace}" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock x:Name="PlanText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock x:Name="RecordingText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,20"/>
                        <WrapPanel>
                            <Button x:Name="PlanButton" Content="{DynamicResource Str.PrepareSettings}" Style="{StaticResource SecondaryButtonStyle}" Click="Plan_Click" Margin="0,0,8,8"/>
                            <Button x:Name="TuningButton" Content="{DynamicResource Str.TuningTitle}" Style="{StaticResource PrimaryButtonStyle}" Click="Tuning_Click" Margin="0,0,8,8" Visibility="Collapsed"/>
                            <Button x:Name="PreparationHistoryButton" Content="{DynamicResource Str.PreparationHistory}" Style="{StaticResource GhostButtonStyle}" Click="PreparationHistory_Click" Margin="0,0,8,8"/>
                            <Button x:Name="RecordButton" Content="{DynamicResource Str.NavSession}" Style="{StaticResource SecondaryButtonStyle}" Click="Route_Click" Tag="session" Margin="0,0,8,8"/>
                            <Button x:Name="DisplayButton" Content="{DynamicResource Str.NavDisplay}" Style="{StaticResource SecondaryButtonStyle}" Click="Route_Click" Tag="display" Margin="0,0,8,8"/>
                            <Button x:Name="AutoRecordButton" Content="{DynamicResource Str.AutoRecordTitle}" Style="{StaticResource GhostButtonStyle}" Click="AutoRecord_Click" Margin="0,0,0,8"/>
                        </WrapPanel>
                    </StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel>
                        <TextBlock Text="{DynamicResource Str.LibraryManage}" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Str.LibraryName}" Style="{StaticResource MutedTextStyle}"/>
                        <TextBox x:Name="NameBox" Style="{StaticResource InputTextBoxStyle}" MaxLength="80" Margin="0,6,0,10" AutomationProperties.Name="{DynamicResource Str.LibraryName}"/>
                        <WrapPanel><Button x:Name="RenameButton" Content="{DynamicResource Str.LibraryRename}" Style="{StaticResource SecondaryButtonStyle}" Click="Rename_Click" Margin="0,0,8,0"/><Button x:Name="RemoveButton" Content="{DynamicResource Str.LibraryRemove}" Style="{StaticResource GhostButtonStyle}" Click="Remove_Click"/></WrapPanel>
                    </StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,16,0,0" LastChildFill="True">
            <Button x:Name="UndoRemoveButton" Content="{DynamicResource Str.LibraryUndoRemove}" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" IsEnabled="False" Click="UndoRemove_Click" Margin="12,0,0,0"/>
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
    </Grid>
</UserControl>
