<UserControl x:Class="FpsTune.Wpf.Views.CommandPaletteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PreviewKeyDown="Palette_KeyDown" KeyboardNavigation.TabNavigation="Cycle"
    AutomationProperties.Name="{DynamicResource Str.CommandTitle}">
    <Border Style="{StaticResource CardStyle}" Padding="0" Background="{DynamicResource AppBackdropBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="22,18,16,14">
                <Button x:Name="DismissButton" DockPanel.Dock="Right" Content="{DynamicResource Str.Close}" Click="Close_Click" Style="{StaticResource GhostButtonStyle}"/>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.CommandTitle}" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                    <TextBlock Text="{DynamicResource Str.CommandSubtitle}" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0"/>
                </StackPanel>
            </DockPanel>
            <TextBox x:Name="QueryBox" Grid.Row="1" Style="{StaticResource InputTextBoxStyle}" Margin="20,0,20,12" MinHeight="44"
                MaxLength="160" FontSize="16" TextChanged="Query_Changed" AutomationProperties.Name="{DynamicResource Str.CommandQuery}"/>
            <Grid Grid.Row="2" MinHeight="100" MaxHeight="350">
                <ListBox x:Name="ResultsList" BorderThickness="0" Background="Transparent" Margin="10,0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                    MouseLeftButtonUp="Result_Click"
                    AutomationProperties.Name="{DynamicResource Str.CommandResults}">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource CardListItemStyle}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                        <Setter Property="AutomationProperties.HelpText" Value="{Binding Description}"/>
                    </Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid Margin="12,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="{StaticResource SmallEmphasisWeight}"/>
                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Group}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Text="{DynamicResource Str.CommandEmpty}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="Collapsed"/>
            </Grid>
            <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12" Margin="0,10,0,0">
                <TextBlock Text="{DynamicResource Str.CommandKeys}" Style="{StaticResource MutedTextStyle}" FontSize="13" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
