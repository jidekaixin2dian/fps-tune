<UserControl x:Class="FpsTune.Wpf.Views.GameDriverSettings"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource FontBody}" Foreground="{DynamicResource TextPrimaryBrush}"><StackPanel>
 <TextBlock x:Name="GameTitle" Visibility="Collapsed" Style="{StaticResource ItemTitleStyle}" Margin="0,0,0,20"/>
                <Border Style="{StaticResource CardStyle}"><StackPanel>
                    <TextBlock Text="{DynamicResource Str.TuningDriverTitle}" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Str.TuningDriverScope}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <TextBlock x:Name="DriverCurrent" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <StackPanel x:Name="DriverInputs">
                    <ComboBox x:Name="SyncBox" SelectedIndex="0" SelectionChanged="Sync_Changed" AutomationProperties.Name="{DynamicResource Str.TuningSync}"><ComboBoxItem Content="{DynamicResource Str.FrameKeep}"/><ComboBoxItem Content="{DynamicResource Str.TuningLatency}"/><ComboBoxItem Content="{DynamicResource Str.TuningSmooth}"/></ComboBox>
                    <TextBlock x:Name="SyncHint" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,14"/>
                    <CheckBox x:Name="VrrConfirmed" Content="{DynamicResource Str.TuningVrrConfirmed}" Margin="0,0,0,14" Visibility="Collapsed" Checked="DriverInput_Changed" Unchecked="DriverInput_Changed"/>
                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                        <CheckBox x:Name="ForegroundCheck" Content="{DynamicResource Str.TuningForeground}" VerticalAlignment="Center" Checked="DriverInput_Changed" Unchecked="DriverInput_Changed"/>
                        <TextBox Grid.Column="1" x:Name="ForegroundBox" Text="240" MaxLength="4" IsEnabled="{Binding IsChecked, ElementName=ForegroundCheck}" AutomationProperties.Name="{DynamicResource Str.TuningForeground}" TextChanged="DriverInput_Changed"/>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                        <CheckBox x:Name="BackgroundCheck" Content="{DynamicResource Str.TuningBackground}" VerticalAlignment="Center" Checked="DriverInput_Changed" Unchecked="DriverInput_Changed"/>
                        <TextBox Grid.Column="1" x:Name="BackgroundBox" Text="30" MaxLength="3" IsEnabled="{Binding IsChecked, ElementName=BackgroundCheck}" AutomationProperties.Name="{DynamicResource Str.TuningBackground}" TextChanged="DriverInput_Changed"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource Str.FrameRange}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <Expander Header="{DynamicResource Str.DriverMoreOptions}" Margin="0,18,0,0">
                    <CheckBox x:Name="PowerCheck" Content="{DynamicResource Str.TuningMaximumPower}" Margin="0,10,0,0" Checked="DriverInput_Changed" Unchecked="DriverInput_Changed"/>
                    </Expander>
                    </StackPanel>
                    <WrapPanel Margin="0,16,0,0"><Button x:Name="ApplyDriverButton" Content="{DynamicResource Str.TuningApplyDriver}" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" Click="ApplyDriver_Click" Margin="0,0,10,0"/>
                        <Button x:Name="RestoreDriverButton" Content="{DynamicResource Str.TuningRestoreDriver}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" Click="RestoreDriver_Click"/></WrapPanel>
                    <TextBlock x:Name="DriverStatus" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                </StackPanel></Border>

                <!-- 高级参数：逐项显示驱动里的当前值与三态，可改成固定值或恢复继承 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0"><StackPanel>
                    <Expander x:Name="AdvancedExpander" IsExpanded="False">
                        <Expander.Header><TextBlock Text="{DynamicResource Str.AdvancedTitle}" Style="{StaticResource CardTitleStyle}"/></Expander.Header>
                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="{DynamicResource Str.AdvancedIntro}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="AdvancedStateText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <ItemsControl x:Name="AdvancedList" Margin="0,14,0,0">
                                <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Note}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding DefaultHint}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding CurrentLabel}" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource ChipStyle}" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding StateLabel}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <Grid Grid.Column="2" VerticalAlignment="Center">
                                            <ComboBox x:Name="AdvancedChoiceBox" Style="{StaticResource SelectComboBoxStyle}"
                                                      Visibility="{Binding ChoiceVisibility}" DisplayMemberPath="Label"
                                                      ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                                      AutomationProperties.Name="{Binding Name}"/>
                                            <StackPanel Visibility="{Binding RangeVisibility}">
                                                <TextBox x:Name="AdvancedRangeBox" MaxLength="4"
                                                         Text="{Binding RangeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="{Binding Name}">
                                                    <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
                                                        <Style.Triggers><DataTrigger Binding="{Binding UseInherited}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
                                                    </Style></TextBox.Style>
                                                </TextBox>
                                                <CheckBox x:Name="AdvancedInheritCheck" Content="{DynamicResource Str.AdvancedUseInherited}" FontSize="13"
                                                          IsChecked="{Binding UseInherited, Mode=TwoWay}" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="AdvancedWriteButton" Content="{DynamicResource Str.AdvancedWrite}" Style="{StaticResource SecondaryButtonStyle}"
                                        Click="AdvancedWrite_Click" Margin="0,0,10,0"/>
                            </WrapPanel>
                            <TextBlock x:Name="AdvancedStatus" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Expander>
                </StackPanel></Border>
</StackPanel></UserControl>
