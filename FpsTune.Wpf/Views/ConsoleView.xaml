<UserControl x:Class="FpsTune.Wpf.Views.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:FpsTune.Wpf.Views.Controls"
             Background="{DynamicResource AppBackgroundBrush}"
             FontFamily="{StaticResource FontBody}">
    <UserControl.Resources>
        <Style x:Key="MetricNumber" TargetType="TextBlock" BasedOn="{StaticResource StatValueStyle}">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Margin" Value="0,3,0,6"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,24">
            <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,16">
                <UniformGrid Columns="4">
                    <Border Padding="20,11,20,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                        <StackPanel>
                            <TextBlock Text="CPU" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock x:Name="CpuText" Text="—" Style="{StaticResource MetricNumber}"/>
                            <ProgressBar x:Name="CpuMeter" Style="{StaticResource ThinMeterStyle}" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="20,11,20,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.Memory}" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock x:Name="MemoryText" Text="—" Style="{StaticResource MetricNumber}"/>
                            <ProgressBar x:Name="MemoryMeter" Style="{StaticResource ThinMeterStyle}" Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="20,11,20,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                        <StackPanel>
                            <TextBlock Text="GPU" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock x:Name="GpuText" Text="—" Style="{StaticResource MetricNumber}"/>
                            <ProgressBar x:Name="GpuMeter" Style="{StaticResource ThinMeterStyle}" Foreground="{DynamicResource OkBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="20,11,20,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.ItemsOptimized}" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock x:Name="TunedText" Text="—" Style="{StaticResource MetricNumber}" Foreground="{DynamicResource AccentBrush}"/>
                            <ProgressBar x:Name="TunedMeter" Style="{StaticResource ThinMeterStyle}" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Border>

            <Grid x:Name="HomeTasks" SizeChanged="HomeTasks_SizeChanged" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/><ColumnDefinition x:Name="HomeTaskGap" Width="16"/><ColumnDefinition x:Name="HomeToolColumn" Width="2*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <Border x:Name="HomePreparationCard" Style="{StaticResource CardStyle}" Padding="20,17">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="GameReadyTitle" Text="{DynamicResource Str.MatchPrep}" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                            <ComboBox Grid.Column="1" x:Name="GameSwitcher" Width="226" Height="34" FontSize="14" Padding="12,0,32,0"
                                      Style="{StaticResource SelectComboBoxStyle}" Background="{DynamicResource SurfaceBrush}" HorizontalContentAlignment="Stretch"
                                      AutomationProperties.Name="{DynamicResource Str.GameSwitcherLabel}" SelectionChanged="GameSwitcher_SelectionChanged">
                                <ComboBox.ItemTemplate><DataTemplate><controls:FileNameLabel Text="{Binding DisplayLabel}" ToolTip="{Binding ExePath}" VerticalAlignment="Center"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="GameReadyText" Text="{DynamicResource Str.ConsoleIntro}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="{DynamicResource RadiusChip}" Padding="10,7" Margin="0,12,0,12">
                            <TextBlock x:Name="PreparationPlanText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        </Border>
                        <WrapPanel x:Name="PreparationActions">
                            <Button x:Name="StartPreparationButton" Content="{DynamicResource Str.PrepareTitle}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="112" Height="36" Margin="0,0,8,0" Click="StartPreparation_Click"/>
                            <Button x:Name="ConfigurePreparationButton" Content="{DynamicResource Str.PrepareSettings}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0,0,8,0" Click="ConfigurePreparation_Click"/>
                            <Button x:Name="CancelPreparationButton" Content="{DynamicResource Str.PrepareStop}" Style="{StaticResource GhostButtonStyle}" Height="36" Visibility="Collapsed" Click="CancelPreparation_Click"/>
                        </WrapPanel>
                        <WrapPanel Margin="-8,6,0,-3">
                            <Button x:Name="LocateDeltaButton" Content="{DynamicResource Str.LocateGame}" Style="{StaticResource GhostButtonStyle}" Click="LocateDelta_Click"/>
                            <Button x:Name="PrepareDeltaButton" Content="{DynamicResource Str.BasicAdvice}" Style="{StaticResource GhostButtonStyle}" Click="PrepareDelta_Click" ToolTip="{DynamicResource Str.BasicAdviceGuideTip}"/>
                            <Button x:Name="RecordMatchButton" Content="{DynamicResource Str.RecordMatch}" Style="{StaticResource GhostButtonStyle}" Height="34" Click="DeltaSession_Click" ToolTip="{DynamicResource Str.TipRecordMatch}"/>
                            <Button x:Name="PreparationRestoreButton" Content="{DynamicResource Str.BackupRestore}" Style="{StaticResource GhostButtonStyle}" Click="DeltaRestore_Click"/>
                            <Button x:Name="PreparationHistoryButton" Content="{DynamicResource Str.PreparationHistory}" Style="{StaticResource GhostButtonStyle}" Click="PreparationHistory_Click"/>
                            <Button x:Name="TuningButton" Content="{DynamicResource Str.TuningTitle}" Style="{StaticResource GhostButtonStyle}" Click="Tuning_Click" Visibility="Collapsed"/>
                        </WrapPanel>
                        <TextBlock x:Name="PreparationStatus" Style="{StaticResource MutedTextStyle}" Margin="0,9,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" x:Name="HomeOptimizationCard" Style="{StaticResource CardStyle}" Padding="20,17">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.HomeQuickCardTitle}" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="{DynamicResource Str.HomeQuickCardBody}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,14,0,8">
                                <Button Content="{DynamicResource Str.PlanBalanced}" Style="{StaticResource SecondaryButtonStyle}" Height="32" Margin="0,0,6,6" Click="HomeQuickPreset_Click" Tag="balanced"/>
                                <Button Content="{DynamicResource Str.PlanSafe}" Style="{StaticResource SecondaryButtonStyle}" Height="32" Margin="0,0,6,6" Click="HomeQuickPreset_Click" Tag="safe-only"/>
                                <Button Content="{DynamicResource Str.PlanFull}" Style="{StaticResource SecondaryButtonStyle}" Height="32" Margin="0,0,0,6" Click="HomeQuickPreset_Click" Tag="full"/>
                            </WrapPanel>
                        </StackPanel>
                        <Button Grid.Row="2" x:Name="HomeQuickCardButton" Content="{DynamicResource Str.HomeQuickCardCta}" Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="132" Height="36" HorizontalAlignment="Left" Click="HomeQuickCard_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.HomeCommon}" Style="{StaticResource CardTitleStyle}"/>
                    <UniformGrid Columns="3" Margin="0,10,0,0">
                        <Button x:Name="GameLibraryButton" Content="{DynamicResource Str.HomeEntryGames}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0,0,8,8" Click="GameLibrary_Click"/>
                        <Button x:Name="QuickFiltersButton" Content="{DynamicResource Str.HomeEntryFilters}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0,0,8,8" Click="QuickFilters_Click"/>
                        <Button x:Name="QuickDeltaFixButton" Content="{DynamicResource Str.HomeEntryDeltaFix}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0,0,0,8" Click="QuickDeltaFix_Click"/>
                        <Button Content="{DynamicResource Str.HomeEntrySession}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0,0,8,0" Click="HomeSession_Click"/>
                        <Button x:Name="HomeStutterHistoryButton" Content="{DynamicResource Str.StutterHistory}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0,0,8,0" Click="StutterHistory_Click"/>
                        <Button Content="{DynamicResource Str.HomeEntryTools}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Click="HomeTools_Click"/>
                    </UniformGrid>
                    <StackPanel x:Name="RecentPagesSection" Visibility="Collapsed" Margin="0,14,0,-5">
                        <TextBlock Text="{DynamicResource Str.HomeRecent}" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6"/>
                        <WrapPanel x:Name="RecentPagesPanel"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
