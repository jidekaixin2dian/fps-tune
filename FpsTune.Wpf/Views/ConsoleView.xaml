<UserControl x:Class="FpsTune.Wpf.Views.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:FpsTune.Wpf.Views.Controls"
             Background="{DynamicResource AppBackgroundBrush}"
             FontFamily="{StaticResource FontBody}">
    <!-- 0.4.0：首页化（对标 1U 首页）——一键优化大卡置顶 + 开局准备 / 指标 / 继续使用与常用入口；
         优化项精细列表在「优化」页，首页不再平铺（用户 2026-11-01 反馈） -->
    <UserControl.Resources>
        <Style x:Key="MetricNumber" TargetType="TextBlock" BasedOn="{StaticResource StatValueStyle}">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Margin" Value="0,6,0,8"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,14,28,18">

            <!-- 卡 0：一键优化大卡（点进统一页，方案 chips 快捷预选） -->
            <Border Style="{StaticResource CardStyle}" Padding="24,20" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.HomeQuickCardTitle}" Style="{StaticResource CardTitleStyle}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Str.HomeQuickCardBody}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"/>
                        <WrapPanel Margin="0,18,0,0">
                            <Button Content="{DynamicResource Str.PlanBalanced}" Style="{StaticResource GhostButtonStyle}" Height="32" Margin="0,0,8,6" Click="HomeQuickPreset_Click" Tag="balanced"/>
                            <Button Content="{DynamicResource Str.PlanSafe}" Style="{StaticResource GhostButtonStyle}" Height="32" Margin="0,0,8,6" Click="HomeQuickPreset_Click" Tag="safe-only"/>
                            <Button Content="{DynamicResource Str.PlanFull}" Style="{StaticResource GhostButtonStyle}" Height="32" Margin="0,0,8,6" Click="HomeQuickPreset_Click" Tag="full"/>
                        </WrapPanel>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="HomeQuickCardButton" Content="{DynamicResource Str.HomeQuickCardCta}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="150" Height="44" VerticalAlignment="Center" Click="HomeQuickCard_Click"/>
                </Grid>
            </Border>

            <!-- 卡 1：开局准备（游戏上下文 + 动作组） -->
            <Border Style="{StaticResource CardStyle}" Padding="24,20" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="GameReadyTitle" Text="{DynamicResource Str.MatchPrep}" Style="{StaticResource CardTitleStyle}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,18,0"/>
                        <ComboBox Grid.Column="1" x:Name="GameSwitcher" Width="300" Height="38" FontSize="14" Padding="14,0,34,0" Background="{DynamicResource SurfaceBrush}" HorizontalContentAlignment="Stretch"
                                  Style="{StaticResource SelectComboBoxStyle}" AutomationProperties.Name="{DynamicResource Str.GameSwitcherLabel}"
                                  SelectionChanged="GameSwitcher_SelectionChanged">
                            <ComboBox.ItemTemplate><DataTemplate><controls:FileNameLabel Text="{Binding DisplayLabel}" ToolTip="{Binding ExePath}" VerticalAlignment="Center"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="GameReadyText" Text="{DynamicResource Str.ConsoleIntro}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <WrapPanel x:Name="PreparationActions">
                            <Button x:Name="StartPreparationButton" Content="{DynamicResource Str.PrepareTitle}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="112" Height="36" Margin="0,0,8,0" Click="StartPreparation_Click"/>
                            <Button x:Name="ConfigurePreparationButton" Content="{DynamicResource Str.PrepareSettings}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0,0,8,0" Click="ConfigurePreparation_Click"/>
                            <Button x:Name="CancelPreparationButton" Content="{DynamicResource Str.PrepareStop}" Style="{StaticResource GhostButtonStyle}" Height="36" Visibility="Collapsed" Click="CancelPreparation_Click"/>
                        </WrapPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Button x:Name="GameLibraryButton" Content="{DynamicResource Str.NavGames}" Style="{StaticResource GhostButtonStyle}" Height="36" Margin="0,0,6,0" Click="GameLibrary_Click"/>
                            <Button x:Name="QuickFiltersButton" Content="{DynamicResource Str.TabFilters}" Style="{StaticResource GhostButtonStyle}" Height="36" Margin="0,0,6,0" Click="QuickFilters_Click"/>
                            <Button x:Name="QuickDeltaFixButton" Content="{DynamicResource Str.DeltaFixTab}" Style="{StaticResource GhostButtonStyle}" Height="36" Click="QuickDeltaFix_Click"/>
                            <Button x:Name="RecordMatchButton" Content="{DynamicResource Str.RecordMatch}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Click="DeltaSession_Click" ToolTip="{DynamicResource Str.TipRecordMatch}"/>
                        </WrapPanel>
                    </Grid>
                    <Border Grid.Row="3" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="{DynamicResource RadiusChip}" Padding="10,8" Margin="0,16,0,0">
                        <TextBlock x:Name="PreparationPlanText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap"/>
                    </Border>
                    <WrapPanel Grid.Row="4" Margin="-10,6,0,-4">
                        <Button x:Name="LocateDeltaButton" Content="{DynamicResource Str.LocateGame}" Style="{StaticResource GhostButtonStyle}" Click="LocateDelta_Click"/>
                        <Button x:Name="PrepareDeltaButton" Content="{DynamicResource Str.BasicAdvice}" Style="{StaticResource GhostButtonStyle}" Click="PrepareDelta_Click" ToolTip="{DynamicResource Str.BasicAdviceGuideTip}"/>
                        <Button x:Name="PreparationRestoreButton" Content="{DynamicResource Str.BackupRestore}" Style="{StaticResource GhostButtonStyle}" Click="DeltaRestore_Click"/>
                        <Button x:Name="PreparationHistoryButton" Content="{DynamicResource Str.PreparationHistory}" Style="{StaticResource GhostButtonStyle}" Click="PreparationHistory_Click"/>
                        <Button x:Name="TuningButton" Content="{DynamicResource Str.TuningTitle}" Style="{StaticResource GhostButtonStyle}" Click="Tuning_Click" Visibility="Collapsed"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="5" x:Name="PreparationStatus" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- 卡 2：指标通栏（发丝分隔四格，与检测页硬件条同构） -->
            <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,20">
                <UniformGrid Columns="4">
                    <Border Padding="20,12,20,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                        <StackPanel>
                            <TextBlock Text="CPU" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock x:Name="CpuText" Text="—" Style="{StaticResource MetricNumber}"/>
                            <ProgressBar x:Name="CpuMeter" Style="{StaticResource ThinMeterStyle}" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="20,12,20,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.Memory}" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock x:Name="MemoryText" Text="—" Style="{StaticResource MetricNumber}"/>
                            <ProgressBar x:Name="MemoryMeter" Style="{StaticResource ThinMeterStyle}" Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="20,12,20,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                        <StackPanel>
                            <TextBlock Text="GPU" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock x:Name="GpuText" Text="—" Style="{StaticResource MetricNumber}"/>
                            <ProgressBar x:Name="GpuMeter" Style="{StaticResource ThinMeterStyle}" Foreground="{DynamicResource OkBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="20,12,20,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.ItemsOptimized}" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock x:Name="TunedText" Text="—" Style="{StaticResource MetricNumber}" Foreground="{DynamicResource AccentBrush}"/>
                            <ProgressBar x:Name="TunedMeter" Style="{StaticResource ThinMeterStyle}" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Border>

            <!-- 卡 3：继续使用 + 常用入口（最近访问 + 六入口网格） -->
            <Border Style="{StaticResource CardStyle}" Padding="24,20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.HomeRecent}" Style="{StaticResource CardTitleStyle}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <WrapPanel x:Name="RecentPagesPanel" Margin="0,10,0,0"/>
                    <TextBlock x:Name="RecentEmptyText" Text="{DynamicResource Str.HomeRecentEmpty}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,8,0,0"/>
                    <TextBlock Text="{DynamicResource Str.HomeCommon}" Style="{StaticResource CardTitleStyle}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,0"/>
                    <UniformGrid Columns="3" Margin="0,10,0,-6">
                        <Button Content="{DynamicResource Str.HomeEntryPrep}" Style="{StaticResource SecondaryButtonStyle}" Height="44" Margin="0,0,10,10" HorizontalAlignment="Stretch" Click="StartPreparation_Click"/>
                        <Button Content="{DynamicResource Str.HomeEntryGames}" Style="{StaticResource SecondaryButtonStyle}" Height="44" Margin="0,0,10,10" HorizontalAlignment="Stretch" Click="GameLibrary_Click"/>
                        <Button Content="{DynamicResource Str.HomeEntryFilters}" Style="{StaticResource SecondaryButtonStyle}" Height="44" Margin="0,0,0,10" HorizontalAlignment="Stretch" Click="QuickFilters_Click"/>
                        <Button Content="{DynamicResource Str.HomeEntryDeltaFix}" Style="{StaticResource SecondaryButtonStyle}" Height="44" Margin="0,0,10,0" HorizontalAlignment="Stretch" Click="QuickDeltaFix_Click"/>
                        <Button Content="{DynamicResource Str.HomeEntrySession}" Style="{StaticResource SecondaryButtonStyle}" Height="44" Margin="0,0,10,0" HorizontalAlignment="Stretch" Click="HomeSession_Click"/>
                        <Button Content="{DynamicResource Str.HomeEntryTools}" Style="{StaticResource SecondaryButtonStyle}" Height="44" HorizontalAlignment="Stretch" Click="HomeTools_Click"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
