<Window x:Class="FpsTune.Wpf.Views.PreparationHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{DynamicResource Str.PreparationHistory}" Style="{StaticResource WindowTypographyStyle}" Width="900" Height="600" MinWidth="760" MinHeight="480"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="{DynamicResource AppBackdropBrush}">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="24"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
            <ComboBox x:Name="ScopeBox" DockPanel.Dock="Right" Width="160" SelectionChanged="Scope_Changed" AutomationProperties.Name="{DynamicResource Str.PreparationHistoryScope}">
                <ComboBoxItem Content="{DynamicResource Str.PlanCurrentGame}"/><ComboBoxItem Content="{DynamicResource Str.PreparationHistoryAll}"/>
            </ComboBox>
            <StackPanel Margin="0,0,20,0" Background="Transparent" MouseLeftButtonDown="Header_Drag"><TextBlock Text="{DynamicResource Str.PreparationHistory}" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="{DynamicResource Str.PreparationHistoryHint}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
        </DockPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid><ListBox x:Name="RunList" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource CardListItemStyle}" SelectionChanged="Run_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{DynamicResource Str.PreparationHistory}">
                <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,5">
                    <TextBlock Text="{Binding GameName}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="{DynamicResource SmallEmphasisWeight}"/>
                    <TextBlock Text="{Binding Time}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding Outcome}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox><TextBlock x:Name="EmptyText" Text="{DynamicResource Str.PreparationHistoryEmpty}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="12"/>
            </Grid>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Details" Visibility="Collapsed" Margin="0,0,8,0">
                <TextBlock x:Name="GameText" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap"/>
                <TextBlock x:Name="TimeText" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"/>
                <TextBlock x:Name="OutcomeText" FontWeight="{DynamicResource SmallEmphasisWeight}" FontSize="16" Margin="0,16,0,8" TextWrapping="Wrap"/>
                <TextBlock x:Name="PlanText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource WarningBrush}" Margin="0,16,0,0" TextWrapping="Wrap"/>
                <ItemsControl x:Name="StepList" Margin="0,16,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,18">
                    <TextBlock Text="{Binding Title}" FontWeight="{DynamicResource SmallEmphasisWeight}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Succeeded}" Value="True"><Setter Property="Foreground" Value="{DynamicResource OkBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></ScrollViewer>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,18,0,0">
            <WrapPanel DockPanel.Dock="Right"><Button x:Name="ExportButton" Content="{DynamicResource Str.PreparationHistoryExport}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" Click="Export_Click" Margin="0,0,10,0"/>
                <Button Content="{DynamicResource Str.Close}" Style="{StaticResource GhostButtonStyle}" IsCancel="True" Click="Close_Click"/></WrapPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,18,0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
    </Grid></Border>
</Window>
