<UserControl x:Class="FpsTune.Wpf.Views.NetworkToolsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:FpsTune.Wpf.Views.Controls" FontFamily="{StaticResource FontBody}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,14"><RadioButton x:Name="ProbeTab" Content="{DynamicResource Str.NetworkProbeTitle}" GroupName="networkTools" IsChecked="True" Checked="Tab_Checked" Style="{StaticResource SectionNavigationStyle}" Margin="0,0,8,0"/><RadioButton x:Name="PortsTab" Content="{DynamicResource Str.NetworkPortsTitle}" GroupName="networkTools" Checked="Tab_Checked" Style="{StaticResource SectionNavigationStyle}"/></StackPanel>
  <ScrollViewer x:Name="ProbePane" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,14,0">
   <Border Style="{StaticResource CardStyle}"><StackPanel>
    <DockPanel><Button x:Name="AdaptersRefreshButton" Content="{DynamicResource Str.NetworkRefreshAdapters}" DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}" Click="AdaptersRefresh_Click"/><TextBlock Text="{DynamicResource Str.NetworkCurrentConnection}" Style="{StaticResource CardTitleStyle}"/></DockPanel>
    <ComboBox x:Name="AdapterBox" Style="{StaticResource SelectComboBoxStyle}" DisplayMemberPath="Name" SelectionChanged="Adapter_Changed" AutomationProperties.Name="{DynamicResource Str.NetworkAdapter}" Margin="0,8,0,10"/>
    <Expander Header="{DynamicResource Str.NetworkAddressDns}" IsExpanded="False"><TextBlock x:Name="AdapterText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0"/></Expander>
   </StackPanel></Border>
   <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel>
    <TextBlock Text="{DynamicResource Str.NetworkQualityTitle}" Style="{StaticResource CardTitleStyle}"/>
    <TextBlock Text="{DynamicResource Str.NetworkQualityHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
    <Grid Margin="0,14,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Str.NetworkTarget}" Style="{StaticResource MutedTextStyle}"/><TextBox x:Name="HostBox" Style="{StaticResource InputTextBoxStyle}" MaxLength="253" Margin="0,5,8,0" AutomationProperties.Name="{DynamicResource Str.NetworkTarget}"/></StackPanel><Button x:Name="GatewayButton" Grid.Column="1" Content="{DynamicResource Str.NetworkUseGateway}" Style="{StaticResource SecondaryButtonStyle}" Click="Gateway_Click" VerticalAlignment="Bottom"/></Grid>
    <Grid Margin="0,0,0,2">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0" Margin="0,0,12,10"><TextBlock Text="{DynamicResource Str.NetworkMode}" Style="{StaticResource MutedTextStyle}"/><ComboBox x:Name="ModeBox" Width="148" Height="30" Style="{StaticResource SelectComboBoxStyle}" SelectedIndex="0" SelectionChanged="Mode_Changed" Margin="0,5,0,0" VerticalAlignment="Top" AutomationProperties.Name="{DynamicResource Str.NetworkMode}"><ComboBoxItem Content="ICMP Ping"/><ComboBoxItem Content="{DynamicResource Str.NetworkTcpMode}"/></ComboBox></StackPanel>
     <StackPanel Grid.Column="1" Margin="0,0,12,10"><TextBlock Text="{DynamicResource Str.NetworkTcpPort}" Style="{StaticResource MutedTextStyle}"/><TextBox x:Name="PortBox" Text="443" Width="96" Height="30" IsEnabled="False" Style="{StaticResource InputTextBoxStyle}" Margin="0,5,0,0" VerticalAlignment="Top" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource Str.NetworkTcpPort}" MaxLength="5"/></StackPanel>
     <StackPanel Grid.Column="2" Margin="0,0,0,10"><TextBlock Text="{DynamicResource Str.NetworkSampleCount}" Style="{StaticResource MutedTextStyle}"/><ComboBox x:Name="CountBox" SelectedIndex="1" Width="96" Height="30" Style="{StaticResource SelectComboBoxStyle}" Margin="0,5,0,0" VerticalAlignment="Top" AutomationProperties.Name="{DynamicResource Str.NetworkSampleCount}"><ComboBoxItem Content="4"/><ComboBoxItem Content="8"/><ComboBoxItem Content="16"/></ComboBox></StackPanel>
    </Grid>
    <WrapPanel Margin="0,4,0,0"><Button x:Name="StartButton" Content="{DynamicResource Str.NetworkStart}" Style="{StaticResource PrimaryButtonStyle}" Click="Start_Click" Margin="0,0,8,0"/><Button x:Name="StopButton" Content="{DynamicResource Str.NetworkStop}" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" Click="Stop_Click" Margin="0,0,8,0"/><Button x:Name="ExportProbeButton" Content="{DynamicResource Str.NetworkExport}" IsEnabled="False" Style="{StaticResource GhostButtonStyle}" Click="ExportProbe_Click"/></WrapPanel>
    <TextBlock x:Name="ProbeStatus" Text="{DynamicResource Str.NetworkReady}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,16,0,0" AutomationProperties.LiveSetting="Polite"/>
    <ProgressBar x:Name="ProbeProgress" Style="{StaticResource ThinMeterStyle}" Foreground="{DynamicResource AccentBrush}" Maximum="16" Value="0" Margin="0,10,0,0"/>
   </StackPanel></Border>
   <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="{DynamicResource Str.NetworkResults}" Style="{StaticResource CardTitleStyle}"/><TextBlock x:Name="ResultTarget" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
    <UniformGrid Columns="3" Margin="0,12,0,10"><StackPanel><TextBlock Text="{DynamicResource Str.NetworkAverage}" Style="{StaticResource MutedTextStyle}"/><TextBlock x:Name="AverageText" Text="—" Style="{StaticResource CardTitleStyle}" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock x:Name="FailureLabel" Text="{DynamicResource Str.NetworkNoResponse}" Style="{StaticResource MutedTextStyle}"/><TextBlock x:Name="FailureText" Text="—" Style="{StaticResource CardTitleStyle}" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource Str.NetworkVariation}" ToolTip="{DynamicResource Str.NetworkVariationHint}" Style="{StaticResource MutedTextStyle}"/><TextBlock x:Name="VariationText" Text="—" Style="{StaticResource CardTitleStyle}" Margin="0,5,0,0"/></StackPanel></UniformGrid>
    <TextBlock x:Name="RangeText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
    <ItemsControl x:Name="ProbeRows" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,4"><TextBlock DockPanel.Dock="Left" Text="{Binding Number}" Width="26" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock DockPanel.Dock="Left" Text="{Binding Duration}" Width="100" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></Border>
  </StackPanel></ScrollViewer>
  <Grid x:Name="PortsPane" Grid.Row="1" Visibility="Collapsed" Margin="0,0,14,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><DockPanel><WrapPanel DockPanel.Dock="Right"><Button x:Name="PortsRefreshButton" Content="{DynamicResource Str.NetworkRefreshPorts}" Style="{StaticResource SecondaryButtonStyle}" Click="PortsRefresh_Click"/><Button x:Name="ExportPortsButton" Content="{DynamicResource Str.NetworkExportPorts}" IsEnabled="False" Style="{StaticResource GhostButtonStyle}" Click="ExportPorts_Click" Margin="8,0,0,0"/></WrapPanel><TextBlock Text="{DynamicResource Str.NetworkPortsTitle}" Style="{StaticResource CardTitleStyle}"/></DockPanel>
    <TextBlock Text="{DynamicResource Str.NetworkPortsHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,5,0,12"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Str.NetworkLocalPort}" Style="{StaticResource MutedTextStyle}"/><TextBox x:Name="PortFilterBox" Style="{StaticResource InputTextBoxStyle}" MaxLength="5" TextChanged="Filter_Changed" Margin="0,5,8,0" AutomationProperties.Name="{DynamicResource Str.NetworkFilterPort}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Str.NetworkSearch}" Style="{StaticResource MutedTextStyle}"/><TextBox x:Name="EndpointSearchBox" Style="{StaticResource InputTextBoxStyle}" MaxLength="160" TextChanged="Filter_Changed" Margin="0,5,0,0" AutomationProperties.Name="{DynamicResource Str.NetworkSearchAccessible}"/></StackPanel></Grid>
    <CheckBox x:Name="ListenersOnly" Content="{DynamicResource Str.NetworkListenersOnly}" IsChecked="True" Checked="ListenerFilter_Changed" Unchecked="ListenerFilter_Changed" Margin="0,12,0,12"/>
   </StackPanel>
   <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8"><ListBox x:Name="EndpointList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource CardListItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,4">
    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding State}" Foreground="{DynamicResource AccentBrush}" Margin="12,0,0,0"/><TextBlock DockPanel.Dock="Left" Text="{Binding Protocol}" Width="62" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock Text="{Binding Local}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="{DynamicResource SmallEmphasisWeight}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Local}"/></DockPanel>
    <DockPanel Margin="62,5,0,0"><TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource TextSecondaryBrush}" Typography.NumeralAlignment="Tabular"><Run Text=" · PID "/><Run Text="{Binding Pid, Mode=OneWay}"/></TextBlock><controls:FileNameLabel Text="{Binding Process}"/></DockPanel><TextBlock Text="{Binding Remote}" Foreground="{DynamicResource TextMutedBrush}" Margin="62,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Remote}"/>
   </StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
   <TextBlock x:Name="PortsStatus" Grid.Row="2" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,16,0,0" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
 </Grid>
</UserControl>
