<UserControl x:Class="FpsTune.Wpf.Views.NetworkToolsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="{StaticResource FontBody}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,14"><RadioButton x:Name="ProbeTab" Content="网络诊断" GroupName="networkTools" IsChecked="True" Checked="Tab_Checked" Style="{StaticResource SectionNavigationStyle}" Margin="0,0,8,0"/><RadioButton x:Name="PortsTab" Content="端口占用" GroupName="networkTools" Checked="Tab_Checked" Style="{StaticResource SectionNavigationStyle}"/></StackPanel>
  <ScrollViewer x:Name="ProbePane" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,14,0">
   <Border Style="{StaticResource CardStyle}"><StackPanel>
    <DockPanel><Button x:Name="AdaptersRefreshButton" Content="刷新网卡" DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}" Click="AdaptersRefresh_Click"/><TextBlock Text="当前连接" Style="{StaticResource CardTitleStyle}"/></DockPanel>
    <ComboBox x:Name="AdapterBox" Style="{StaticResource SelectComboBoxStyle}" DisplayMemberPath="Name" SelectionChanged="Adapter_Changed" AutomationProperties.Name="网卡" Margin="0,8,0,10"/>
    <Expander Header="地址与 DNS" IsExpanded="False"><TextBlock x:Name="AdapterText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0"/></Expander>
   </StackPanel></Border>
   <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0"><StackPanel>
    <TextBlock Text="测试连接质量" Style="{StaticResource CardTitleStyle}"/>
    <TextBlock Text="输入目标域名或 IP，连续采样延迟与响应情况。也可直接测试当前网关。" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
    <Grid Margin="0,14,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="目标域名或 IP" Style="{StaticResource MutedTextStyle}"/><TextBox x:Name="HostBox" Style="{StaticResource InputTextBoxStyle}" MaxLength="253" Margin="0,5,8,0" AutomationProperties.Name="目标域名或 IP"/></StackPanel><Button x:Name="GatewayButton" Grid.Column="1" Content="使用网关" Style="{StaticResource SecondaryButtonStyle}" Click="Gateway_Click" VerticalAlignment="Bottom"/></Grid>
    <WrapPanel><StackPanel Margin="0,0,12,10"><TextBlock Text="测试方式" Style="{StaticResource MutedTextStyle}"/><ComboBox x:Name="ModeBox" Width="148" Style="{StaticResource SelectComboBoxStyle}" SelectedIndex="0" SelectionChanged="Mode_Changed" Margin="0,5,0,0" AutomationProperties.Name="测试方式"><ComboBoxItem Content="ICMP Ping"/><ComboBoxItem Content="TCP 端口连接"/></ComboBox></StackPanel>
     <StackPanel Margin="0,0,12,10"><TextBlock Text="TCP 端口" Style="{StaticResource MutedTextStyle}"/><TextBox x:Name="PortBox" Text="443" Width="84" IsEnabled="False" Style="{StaticResource InputTextBoxStyle}" Margin="0,5,0,0" AutomationProperties.Name="TCP 端口" MaxLength="5"/></StackPanel>
     <StackPanel Margin="0,0,0,10"><TextBlock Text="采样次数" Style="{StaticResource MutedTextStyle}"/><ComboBox x:Name="CountBox" SelectedIndex="1" Width="88" Style="{StaticResource SelectComboBoxStyle}" Margin="0,5,0,0" AutomationProperties.Name="采样次数"><ComboBoxItem Content="4"/><ComboBoxItem Content="8"/><ComboBoxItem Content="16"/></ComboBox></StackPanel>
    </WrapPanel>
    <WrapPanel Margin="0,4,0,0"><Button x:Name="StartButton" Content="开始测试" Style="{StaticResource PrimaryButtonStyle}" Click="Start_Click" Margin="0,0,8,0"/><Button x:Name="StopButton" Content="停止" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" Click="Stop_Click" Margin="0,0,8,0"/><Button x:Name="ExportProbeButton" Content="导出结果" IsEnabled="False" Style="{StaticResource GhostButtonStyle}" Click="ExportProbe_Click"/></WrapPanel>
    <TextBlock x:Name="ProbeStatus" Text="选择目标后开始测试。" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
    <ProgressBar x:Name="ProbeProgress" Style="{StaticResource ThinMeterStyle}" Foreground="{DynamicResource AccentBrush}" Maximum="16" Value="0" Margin="0,10,0,0"/>
   </StackPanel></Border>
   <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0"><StackPanel><TextBlock Text="测试结果" Style="{StaticResource CardTitleStyle}"/><TextBlock x:Name="ResultTarget" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
    <UniformGrid Columns="3" Margin="0,12,0,10"><StackPanel><TextBlock Text="平均延迟" Style="{StaticResource MutedTextStyle}"/><TextBlock x:Name="AverageText" Text="—" Style="{StaticResource CardTitleStyle}" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock x:Name="FailureLabel" Text="未响应比例" Style="{StaticResource MutedTextStyle}"/><TextBlock x:Name="FailureText" Text="—" Style="{StaticResource CardTitleStyle}" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock Text="相邻响应波动" ToolTip="相邻两次均成功响应时，耗时差的绝对值平均数。" Style="{StaticResource MutedTextStyle}"/><TextBlock x:Name="VariationText" Text="—" Style="{StaticResource CardTitleStyle}" Margin="0,5,0,0"/></StackPanel></UniformGrid>
    <TextBlock x:Name="RangeText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
    <ItemsControl x:Name="ProbeRows" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,4"><TextBlock DockPanel.Dock="Left" Text="{Binding Number}" Width="26" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock DockPanel.Dock="Left" Text="{Binding Duration}" Width="100" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></Border>
  </StackPanel></ScrollViewer>
  <Grid x:Name="PortsPane" Grid.Row="1" Visibility="Collapsed" Margin="0,0,14,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><DockPanel><WrapPanel DockPanel.Dock="Right"><Button x:Name="PortsRefreshButton" Content="刷新快照" Style="{StaticResource SecondaryButtonStyle}" Click="PortsRefresh_Click"/><Button x:Name="ExportPortsButton" Content="导出列表" IsEnabled="False" Style="{StaticResource GhostButtonStyle}" Click="ExportPorts_Click" Margin="8,0,0,0"/></WrapPanel><TextBlock Text="端口占用" Style="{StaticResource CardTitleStyle}"/></DockPanel>
    <TextBlock Text="查看 TCP / UDP 的本地端口、远端地址和所属进程。列表按刷新时刻显示。" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,5,0,12"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="本地端口" Style="{StaticResource MutedTextStyle}"/><TextBox x:Name="PortFilterBox" Style="{StaticResource InputTextBoxStyle}" MaxLength="5" TextChanged="Filter_Changed" Margin="0,5,8,0" AutomationProperties.Name="筛选本地端口"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="搜索进程 / PID / 地址" Style="{StaticResource MutedTextStyle}"/><TextBox x:Name="EndpointSearchBox" Style="{StaticResource InputTextBoxStyle}" MaxLength="160" TextChanged="Filter_Changed" Margin="0,5,0,0" AutomationProperties.Name="搜索进程、PID或地址"/></StackPanel></Grid>
    <CheckBox x:Name="ListenersOnly" Content="仅监听端口与 UDP 绑定" IsChecked="True" Checked="ListenerFilter_Changed" Unchecked="ListenerFilter_Changed" Margin="0,12,0,12"/>
   </StackPanel>
   <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8"><ListBox x:Name="EndpointList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource CardListItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,4">
    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding State}" Foreground="{DynamicResource AccentBrush}" Margin="12,0,0,0"/><TextBlock DockPanel.Dock="Left" Text="{Binding Protocol}" Width="62" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock Text="{Binding Local}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="{StaticResource SmallEmphasisWeight}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Local}"/></DockPanel>
    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Margin="62,5,0,0" TextTrimming="CharacterEllipsis"><Run Text="{Binding Process}"/><Run Text=" · PID "/><Run Text="{Binding Pid}"/></TextBlock><TextBlock Text="{Binding Remote, StringFormat=远端：{0}}" Foreground="{DynamicResource TextMutedBrush}" Margin="62,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Remote}"/>
   </StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
   <TextBlock x:Name="PortsStatus" Grid.Row="2" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
 </Grid>
</UserControl>
