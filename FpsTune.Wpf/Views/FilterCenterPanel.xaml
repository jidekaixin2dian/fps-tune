<UserControl x:Class="FpsTune.Wpf.Views.FilterCenterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="PresetCardStyle" TargetType="RadioButton" BasedOn="{StaticResource ChoiceTabStyle}">
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0,0,14,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <!-- 搜索：预设多起来以后按名字/适用场景直接找，不用一屏屏翻。
                 占位文字叠在输入框内部、有输入即隐藏（与优化页搜索框同一写法）。 -->
            <Grid Width="300" Height="32" HorizontalAlignment="Left" Margin="0,0,0,8">
                <TextBox x:Name="SearchBox" Style="{StaticResource InputTextBoxStyle}"
                         VerticalContentAlignment="Center" FontSize="13"
                         TextChanged="Search_Changed" AutomationProperties.Name="{DynamicResource Str.FilterSearchHint}"/>
                <TextBlock Text="{DynamicResource Str.FilterSearchHint}" IsHitTestVisible="False"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <!-- 分类 chips（全部 + 按场景分组）。预设列表不套内层 ScrollViewer：
                 内层可滚动区域会吞掉鼠标滚轮，页面滚到这一块就卡住。 -->
            <WrapPanel x:Name="CategoryList" Margin="0,0,0,6"/>
            <WrapPanel x:Name="PresetList" Margin="0,0,0,8"/>
        </StackPanel>
        <!-- 不再套内层 ScrollViewer：嵌套滚动区会吞掉滚轮，整页只能滚一半（用户两次反馈）。 -->
            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <TextBlock x:Name="PresetFitText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                <TextBlock x:Name="PresetAvoidText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock x:Name="ApplyStatus" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="ApplyButton" Content="{DynamicResource Str.FilterApply}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Click="Apply_Click"/>
                    <Button x:Name="RestoreButton" Content="{DynamicResource Str.RestoreOriginal}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" Click="Restore_Click"/>
                    <Button x:Name="OpenFolderButton" Content="{DynamicResource Str.FilterOpenFolder}" Style="{StaticResource GhostButtonStyle}" Margin="0,0,0,8" Click="OpenFolder_Click"/>
                </WrapPanel>

                <!-- 编辑 ICC -->
                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><StackPanel>
                    <TextBlock Text="{DynamicResource Str.FilterEditorTitle}" Style="{StaticResource CardTitleStyle}"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="lbl"/><ColumnDefinition Width="220"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str.FilterEditorGamma}" VerticalAlignment="Center" Margin="0,0,10,6"/>
                        <Slider x:Name="GammaSlider" Grid.Column="1" Minimum="0.5" Maximum="2.5" Value="1" TickFrequency="0.01" IsSnapToTickEnabled="True" Margin="0,0,10,6" AutomationProperties.Name="{DynamicResource Str.FilterEditorGamma}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=GammaSlider, StringFormat={}{0:0.00}}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="lbl"/><ColumnDefinition Width="220"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str.FilterEditorBrightness}" VerticalAlignment="Center" Margin="0,0,10,6"/>
                        <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="-0.3" Maximum="0.3" Value="0" TickFrequency="0.01" IsSnapToTickEnabled="True" Margin="0,0,10,6" AutomationProperties.Name="{DynamicResource Str.FilterEditorBrightness}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=BrightnessSlider, StringFormat={}{0:0.00}}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="lbl"/><ColumnDefinition Width="220"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str.FilterEditorSaturation}" VerticalAlignment="Center" Margin="0,0,10,6"/>
                        <Slider x:Name="SaturationSlider" Grid.Column="1" Minimum="0.5" Maximum="1.5" Value="1" TickFrequency="0.01" IsSnapToTickEnabled="True" Margin="0,0,10,6" AutomationProperties.Name="{DynamicResource Str.FilterEditorSaturation}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SaturationSlider, StringFormat={}{0:0.00}}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="lbl"/><ColumnDefinition Width="220"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str.FilterEditorHighlight}" VerticalAlignment="Center" Margin="0,0,10,6"/>
                        <Slider x:Name="HighlightSlider" Grid.Column="1" Minimum="-25" Maximum="25" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,10,6" AutomationProperties.Name="{DynamicResource Str.FilterEditorHighlight}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=HighlightSlider, StringFormat={}{0:0}}" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- 暗部平衡：游戏加加同款 12 档幂律，单独突出显示（实时给出等效 γ） -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusControl}" Padding="14,12" Margin="0,4,0,6">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str.FilterEditorDarkBalance}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str.FilterEditorDarkBalanceTag}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="DarkBalanceGammaText" Text="γ 1.00"
                                           FontFamily="{StaticResource FontStat}" Typography.NumeralAlignment="Tabular"
                                           FontSize="17" FontWeight="{DynamicResource StrongEmphasisWeight}"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                           AutomationProperties.Name="{DynamicResource Str.FilterEditorDarkBalanceGamma}"/>
                            </Grid>
                            <Slider x:Name="DarkBalanceSlider" Minimum="0" Maximum="100" Value="45" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,8,0,0" Style="{StaticResource TuneSliderStyle}"
                                    ValueChanged="DarkBalance_Changed"
                                    AutomationProperties.Name="{DynamicResource Str.FilterEditorDarkBalance}"/>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str.FilterEditorDarkBalanceBright}" Style="{StaticResource MutedTextStyle}" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Str.FilterEditorDarkBalanceNeutral}" Style="{StaticResource MutedTextStyle}" FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{DynamicResource Str.FilterEditorDarkBalanceDark}" Style="{StaticResource MutedTextStyle}" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{DynamicResource Str.FilterEditorHighlightHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="{DynamicResource Str.FilterEditorDarkBalanceHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="CustomNameBox" Style="{StaticResource InputTextBoxStyle}" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource Str.FilterEditorName}"/>
                        <Button x:Name="SaveCustomButton" Grid.Column="1" Content="{DynamicResource Str.FilterEditorSave}" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="SaveCustom_Click"/>
                    </Grid>
                </StackPanel></Border>

                <!-- 独立程序滤镜 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><StackPanel>
                    <TextBlock Text="{DynamicResource Str.FilterAppsTitle}" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Str.FilterAppsHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <CheckBox x:Name="WatcherCheck" Content="{DynamicResource Str.FilterWatcherToggle}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,10,0,0" Checked="Watcher_Changed" Unchecked="Watcher_Changed"/>
                    <TextBlock x:Name="WatcherStatus" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <ItemsControl x:Name="RuleList" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Content="✕" Tag="{Binding}" Style="{StaticResource GhostButtonStyle}" Click="RemoveRule_Click" AutomationProperties.Name="{DynamicResource Str.FilterRuleRemove}"/>
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="RuleProcessBox" Style="{StaticResource InputTextBoxStyle}" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource Str.FilterRuleProcess}"/>
                        <Button x:Name="AddRuleButton" Grid.Column="1" Content="{DynamicResource Str.FilterRuleAdd}" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="AddRule_Click"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource Str.FilterAppsRuleHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel></Border>
            </StackPanel>
    </Grid>
</UserControl>
