<UserControl x:Class="FpsTune.Wpf.Views.FilterCenterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="PresetCardStyle" TargetType="RadioButton" BasedOn="{StaticResource ChoiceTabStyle}">
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
        <!-- 滤镜行：参考实现的 .icc-filter-item —— 一条一行、整行吃满、无边框，悬停浅底、选中强调底 + 强调文字。 -->
        <Style x:Key="FilterRowStyle" TargetType="RadioButton">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusControl}" Padding="8,6">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <!-- 没有内容就收起来：这三行在未选中预设时是空的，留着会撑出一大块空白 -->
        <Style x:Key="CollapseWhenEmpty" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0,0,14,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource Str.FilterPickerTitle}" Style="{StaticResource SectionLabelStyle}"/>
            <!-- 搜索：预设多起来以后按名字/适用场景直接找，不用一屏屏翻。
                 占位文字叠在输入框内部、有输入即隐藏（与优化页搜索框同一写法）。 -->
            <Grid Width="300" Height="32" HorizontalAlignment="Left" Margin="0,8,0,8">
                <TextBox x:Name="SearchBox" Style="{StaticResource InputTextBoxStyle}"
                         VerticalContentAlignment="Center" FontSize="13"
                         TextChanged="Search_Changed" AutomationProperties.Name="{DynamicResource Str.FilterSearchHint}"/>
                <TextBlock Text="{DynamicResource Str.FilterSearchHint}" IsHitTestVisible="False"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <!-- 分类：单行（放不下就横向滚动），不折行占掉半个面板 -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                <StackPanel x:Name="CategoryList" Orientation="Horizontal"/>
            </ScrollViewer>
            <!-- 滤镜列表：参考实现的一条一行，整行可点，右对齐分类标签 -->
            <StackPanel x:Name="PresetList" Margin="0,0,0,8"/>
            <Button x:Name="ShowAllButton" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left"
                    Click="ShowAll_Click" Margin="0,0,0,8" Visibility="Collapsed"/>
            <TextBlock x:Name="EmptyFilterText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Button x:Name="FavoriteButton" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left"
                    IsEnabled="False" Click="Favorite_Click" Margin="0,0,0,4"/>
        </StackPanel>
        <!-- 右侧唯一滚动区由宿主页提供；这里不再套内层 ScrollViewer。 -->
            <StackPanel Grid.Row="1" Margin="0,6,0,0">
                <TextBlock x:Name="ApplyStatus" Style="{StaticResource CollapseWhenEmpty}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                <!-- 编辑 ICC：默认收起，避免把选择滤镜的视线挤走。 -->
                <Expander Header="{DynamicResource Str.FilterEditorSection}" Margin="0,4,0,0" FocusVisualStyle="{x:Null}"><StackPanel Margin="0,12,0,0">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="lbl"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str.FilterEditorGamma}" VerticalAlignment="Center" Margin="0,0,10,6"/>
                        <Slider x:Name="GammaSlider" Grid.Column="1" Minimum="0.5" Maximum="2.5" Value="1" TickFrequency="0.01" IsSnapToTickEnabled="True" Margin="0,0,10,6" AutomationProperties.Name="{DynamicResource Str.FilterEditorGamma}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=GammaSlider, StringFormat={}{0:0.00}}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="lbl"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str.FilterEditorBrightness}" VerticalAlignment="Center" Margin="0,0,10,6"/>
                        <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="-0.3" Maximum="0.3" Value="0" TickFrequency="0.01" IsSnapToTickEnabled="True" Margin="0,0,10,6" AutomationProperties.Name="{DynamicResource Str.FilterEditorBrightness}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=BrightnessSlider, StringFormat={}{0:0.00}}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="lbl"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str.FilterEditorSaturation}" VerticalAlignment="Center" Margin="0,0,10,6"/>
                        <Slider x:Name="SaturationSlider" Grid.Column="1" Minimum="0.5" Maximum="1.5" Value="1" TickFrequency="0.01" IsSnapToTickEnabled="True" Margin="0,0,10,6" AutomationProperties.Name="{DynamicResource Str.FilterEditorSaturation}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SaturationSlider, StringFormat={}{0:0.00}}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="lbl"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str.FilterEditorHighlight}" VerticalAlignment="Center" Margin="0,0,10,6"/>
                        <Slider x:Name="HighlightSlider" Grid.Column="1" Minimum="-25" Maximum="25" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,10,6" AutomationProperties.Name="{DynamicResource Str.FilterEditorHighlight}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=HighlightSlider, StringFormat={}{0:0}}" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- 暗部场景平衡：与「画面与色彩」同一套形式（数值在上、暗/亮在两端），不再是自创的档位标签 + γ 读数。 -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusControl}" Padding="14,12" Margin="0,4,0,6">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str.FilterEditorDarkBalance}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="DarkBalanceGammaText" Text="50"
                                           FontFamily="{StaticResource FontStat}" Typography.NumeralAlignment="Tabular"
                                           FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="FilterEditorDarkBalanceValue"/>
                            </Grid>
                            <Slider x:Name="DarkBalanceSlider" Minimum="0" Maximum="100" Value="50" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,8,0,0" Style="{StaticResource TuneSliderStyle}"
                                    ValueChanged="DarkBalance_Changed"
                                    AutomationProperties.Name="{DynamicResource Str.FilterEditorDarkBalance}"/>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str.ColorDarkBalanceDark}" Style="{StaticResource MutedTextStyle}" FontSize="13"/>
                                <TextBlock Grid.Column="2" Text="{DynamicResource Str.ColorDarkBalanceBright}" Style="{StaticResource MutedTextStyle}" FontSize="13"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="CustomNameBox" Style="{StaticResource InputTextBoxStyle}" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource Str.FilterEditorName}"/>
                        <Button x:Name="SaveCustomButton" Grid.Column="1" Content="{DynamicResource Str.FilterEditorSave}" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="SaveCustom_Click"/>
                    </Grid>
                </StackPanel></Expander>
                <!-- 滤镜文件夹：工具入口，放到底部，不占滤镜与暗部平衡的位置。 -->
                <Button x:Name="OpenFolderButton" Content="{DynamicResource Str.FilterOpenFolder}" Style="{StaticResource GhostButtonStyle}"
                        HorizontalAlignment="Left" Margin="0,6,0,0" Click="OpenFolder_Click"/>
            </StackPanel>
    </Grid>
</UserControl>
