<UserControl x:Class="FpsTune.Wpf.Views.DisplayQualityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:FpsTune.Wpf.Views.Controls" xmlns:views="clr-namespace:FpsTune.Wpf.Views"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <!-- 预设卡片：与优化页 PresetChoice 同语言，两行内容（名称 + 说明） -->
        <Style x:Key="PresetCard" TargetType="RadioButton" BasedOn="{StaticResource ChoiceTabStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
        <Style x:Key="PresetCardText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="{StaticResource SmallEmphasisWeight}"/>
        </Style>
        <Style x:Key="PresetCardNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- 手动清单条目：继承全局 MutedTextStyle，统一行距与换行 -->
        <Style x:Key="ManualItem" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- 二级页签（P2-13 反馈：卡片太多滚动太长，按组切换）。
             0.1.12：页签带状态徽标——不点进去也能看到每组的当前状态 -->
        <Style x:Key="SubTabStyle" TargetType="RadioButton" BasedOn="{StaticResource ChoiceTabStyle}"/>
        <!-- 页签状态徽标：使用主题强调色，选中时保持文字对比。 -->
        <Style x:Key="TabBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TabBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 驱动 3D 字段组：上标签下控件，两列网格用 -->
        <Style x:Key="DrsFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <!-- 调节滑条（用户反馈默认 Slider 太粗笨）：细轨道 + 小圆点拇指 + accent 已选段 -->

    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,24">

            <!-- 页头：左标题说明，右当前游戏（DLSS / 驱动 3D 共用的上下文） -->
            <Grid Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.DisplayTitle}" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Str.DisplayIntro}"
                               Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"/>
                </StackPanel>
                <Border x:Name="GameChip" Style="{StaticResource ChipStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Padding="10,4" Visibility="Collapsed">
                    <TextBlock x:Name="GameChipText" Text=""
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </Grid>

            <!-- 二级页签（用户反馈：数字振动与 ICC 合并一签）：一次只看一组卡片，徽标显示当前状态 -->
            <WrapPanel Margin="0,0,0,14">
                <RadioButton x:Name="SubTabDlss" AutomationProperties.Name="{DynamicResource Str.TabDlss}" GroupName="dqSub"
                             IsChecked="True" Style="{StaticResource SubTabStyle}" Tag="dlss" Checked="SubTab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Str.TabDlss}" VerticalAlignment="Center"/>
                        <Border x:Name="TabBadgeDlss" Style="{StaticResource TabBadgeStyle}" Visibility="Collapsed">
                            <TextBlock x:Name="TabStatusDlss" Text="" Style="{StaticResource TabBadgeTextStyle}"/>
                        </Border>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="SubTabColor" GroupName="dqSub" AutomationProperties.Name="{DynamicResource Str.TabVibIcc}" Style="{StaticResource SubTabStyle}" Tag="vibicc" Checked="SubTab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Str.TabVibIcc}" VerticalAlignment="Center"/>
                        <Border x:Name="TabBadgeVib" Style="{StaticResource TabBadgeStyle}" Visibility="Collapsed">
                            <TextBlock x:Name="TabStatusVib" Text="" Style="{StaticResource TabBadgeTextStyle}"/>
                        </Border>
                        <Border x:Name="TabBadgeIcc" Style="{StaticResource TabBadgeStyle}" Visibility="Collapsed">
                            <TextBlock x:Name="TabStatusIcc" Text="" Style="{StaticResource TabBadgeTextStyle}"/>
                        </Border>
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="dqSub" AutomationProperties.Name="{DynamicResource Str.TabDrs}" Style="{StaticResource SubTabStyle}" Tag="drs" Checked="SubTab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Str.TabDrs}" VerticalAlignment="Center"/>
                        <Border x:Name="TabBadgeDrs" Style="{StaticResource TabBadgeStyle}" Visibility="Collapsed">
                            <TextBlock x:Name="TabStatusDrs" Text="" Style="{StaticResource TabBadgeTextStyle}"/>
                        </Border>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="SubTabGpuIdentity" GroupName="dqSub" AutomationProperties.Name="{DynamicResource Str.GpuIdentityTitle}" Style="{StaticResource SubTabStyle}" Tag="identity" Checked="SubTab_Checked">
                    <TextBlock Text="{DynamicResource Str.GpuIdentityTitle}"/>
                </RadioButton>
                <RadioButton GroupName="dqSub" AutomationProperties.Name="{DynamicResource Str.TabAdvice}" Style="{StaticResource SubTabStyle}" Tag="advice" Checked="SubTab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Str.TabAdvice}" VerticalAlignment="Center"/>
                        <Border x:Name="TabBadgeAdvice" Style="{StaticResource TabBadgeStyle}" Visibility="Collapsed">
                            <TextBlock x:Name="TabStatusAdvice" Text="" Style="{StaticResource TabBadgeTextStyle}"/>
                        </Border>
                    </StackPanel>
                </RadioButton>
            </WrapPanel>

            <!-- 主体卡片 -->
            <Border x:Name="CardDlss" Style="{StaticResource CardStyle}" Padding="20,18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.DlssCard}" Style="{StaticResource CardTitleStyle}"/>

                    <StackPanel x:Name="SupportedPanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Text="{DynamicResource Str.DlssOverrideNote}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <UniformGrid Columns="3" Margin="0,10,0,0">
                            <RadioButton x:Name="PresetK" GroupName="dlssPreset" Style="{StaticResource PresetCard}"
                                         Checked="Preset_Checked">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.PresetK}" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="{DynamicResource Str.PresetKDesc}" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetFollowGame" GroupName="dlssPreset" Style="{StaticResource PresetCard}"
                                         Checked="Preset_Checked">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.FollowGame}" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="{DynamicResource Str.FollowGameDesc}" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetLatest" GroupName="dlssPreset" Style="{StaticResource PresetCard}"
                                         Checked="Preset_Checked">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.PresetLatest}" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="{DynamicResource Str.PresetLatestDesc}" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetM" GroupName="dlssPreset" Style="{StaticResource PresetCard}"
                                         Checked="Preset_Checked">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.PresetM}" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="{DynamicResource Str.PresetMDesc}" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetJ" GroupName="dlssPreset" Style="{StaticResource PresetCard}"
                                         Checked="Preset_Checked">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.PresetJ}" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="{DynamicResource Str.PresetJDesc}" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetE" GroupName="dlssPreset" Style="{StaticResource PresetCard}"
                                         Checked="Preset_Checked">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.PresetE}" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="{DynamicResource Str.PresetEDesc}" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>

                        <TextBlock x:Name="StateText" Text="" Style="{StaticResource MutedTextStyle}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="ApplyButton" Content="{DynamicResource Str.ApplyOverride}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="110" Margin="0,0,8,0" Click="Apply_Click"/>
                            <Button x:Name="RestoreButton" Content="{DynamicResource Str.RestoreDefault}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="110" Click="Restore_Click"/>
                            <Button Content="{DynamicResource Str.ExportDiagnostics}" Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="8,0,0,0" Click="Diagnostics_Click"/>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource Str.DlssNote}"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock x:Name="UnsupportedText" Text="" Style="{StaticResource MutedTextStyle}"
                               Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- 振动与 ICC（用户反馈合并一签）：一卡两分区，细线分隔 -->
            <Border x:Name="CardDisplayTarget" Style="{StaticResource CardStyle}" Padding="20,18" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.DisplayTarget}" Style="{StaticResource CardTitleStyle}"/>
                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="DisplayTargetCombo" DisplayMemberPath="Label" Style="{StaticResource SelectComboBoxStyle}"
                                  AutomationProperties.Name="{DynamicResource Str.DisplayTarget}" SelectionChanged="DisplayTarget_Changed"/>
                        <Button x:Name="DisplayRefreshButton" Grid.Column="1" Content="{DynamicResource Str.DisplayRefresh}" Margin="10,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="DisplayRefresh_Click"/>
                    </Grid>
                    <TextBlock x:Name="DisplayTargetState" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border x:Name="CardVib" Style="{StaticResource CardStyle}" Padding="20,18" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel>
                    <!-- 分区一：数字振动（显示级饱和度，全桌面生效） -->
                    <TextBlock Text="{DynamicResource Str.VibCard}" Style="{StaticResource CardTitleStyle}"/>

                    <StackPanel x:Name="VibSupportedPanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Text="{DynamicResource Str.VibNote}"
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        <Grid Margin="0,16,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="VibPercentText" Text="—"
                                       FontFamily="{StaticResource FontStat}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" MinWidth="64"/>
                            <Slider Grid.Column="1" x:Name="VibSlider" Minimum="0" Maximum="100" TickFrequency="5"
                                    IsSnapToTickEnabled="False" ValueChanged="VibSlider_Changed"
                                    Style="{StaticResource TuneSliderStyle}"
                                    VerticalAlignment="Center" Margin="14,0,18,0"/>
                            <Button Grid.Column="2" x:Name="VibRecommendedButton" Content="{DynamicResource Str.VibRecommendedSet}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="120" VerticalAlignment="Center" Click="VibRecommended_Click"
                                    ToolTip="{DynamicResource Str.TipVibRecommended}"/>
                        </Grid>

                        <TextBlock x:Name="VibStateText" Text="{DynamicResource Str.Reading}" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="VibApplyButton" Content="{DynamicResource Str.Apply}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="110" Margin="0,0,8,0" Click="VibApply_Click"/>
                            <Button x:Name="VibRestoreButton" Content="{DynamicResource Str.RestoreOriginal}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="110" Click="VibRestore_Click"/>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource Str.VibRecommendedNote}"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="{DynamicResource Str.VibNote2}"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock x:Name="VibUnsupportedText" Text="" Style="{StaticResource MutedTextStyle}"
                               Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                    <!-- 分区二：ICC 滤镜（系统层色彩变换，A 卡/Intel 与整体桌面观感兜底） -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                            Margin="0,18,0,16"/>
                    <views:ScreenColorPanel x:Name="ColorPanel" Margin="0,0,0,20"/>
                    <Expander x:Name="IccAdvanced" Header="{DynamicResource Str.IccAdvanced}" IsExpanded="False"><StackPanel Margin="0,12,0,0">
                    <TextBlock Text="{DynamicResource Str.IccCard}" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock x:Name="IccCurrentText" Text="{DynamicResource Str.Reading}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <StackPanel x:Name="IccSupportedPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <TextBlock Text="{DynamicResource Str.IccPresetLabel}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <ItemsControl x:Name="IccPresetList" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <RadioButton GroupName="iccPreset" Style="{StaticResource PresetCard}" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                    <StackPanel><TextBlock controls:LocalizedText.Key="{Binding TitleKey}" Style="{StaticResource PresetCardText}"/>
                                        <TextBlock controls:LocalizedText.Key="{Binding DescriptionKey}" Style="{StaticResource PresetCardNote}"/>
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="IccStateText" Text="" Style="{StaticResource MutedTextStyle}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="IccApplyButton" Content="{DynamicResource Str.ApplyPreset}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="110" Margin="0,0,8,0" Click="IccApply_Click"/>
                            <Button x:Name="IccApplyFileButton" Content="{DynamicResource Str.IccApplyFromFile}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="120" Margin="0,0,8,0" Click="IccApplyFromFile_Click"
                                    ToolTip="{DynamicResource Str.IccApplyFromFileTip}"/>
                            <Button x:Name="IccRestoreButton" Content="{DynamicResource Str.RestoreOriginal}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="110" Click="IccRestore_Click"/>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource Str.IccNote}"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock x:Name="IccUnsupportedText" Text="" Style="{StaticResource MutedTextStyle}"
                               Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel></Expander>
                </StackPanel>
            </Border>

            <!-- M3：驱动 3D 设置（纹理/电源/透明度/低延迟/各向异性/垂直同步/着色器缓存）
                 0.1.12：两列字段网格，用足全宽；一键竞技推荐保持在卡头右侧 -->
            <Border x:Name="CardDrs" Style="{StaticResource CardStyle}" Padding="20,18" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{DynamicResource Str.DrsCard}" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" Margin="0"/>
                        <Button x:Name="DrsPresetButton" Content="{DynamicResource Str.OneClickEsports}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="130" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Click="DrsPreset_Click"
                                ToolTip="{DynamicResource Str.TipOneClickEsports}"/>
                    </Grid>
                    <TextBlock x:Name="DrsStateText" Text="{DynamicResource Str.Reading}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <StackPanel x:Name="DrsSupportedPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <TextBlock Text="{DynamicResource Str.DrsNote}"
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{DynamicResource Str.DrsTextureFilter}" Style="{StaticResource DrsFieldLabelStyle}" VerticalAlignment="Center"/>
                                <ComboBox Style="{StaticResource SelectComboBoxStyle}" x:Name="TexQualityCombo" Grid.Row="0" Grid.Column="1" Margin="8,2,0,2"
                                          HorizontalAlignment="Stretch" SelectionChanged="Drs_SelectionChanged"
                                          ToolTip="{DynamicResource Str.TipTextureFilter}">
                                    <ComboBoxItem Content="{DynamicResource Str.FollowDriverGame}" Tag=""/>
                                    <ComboBoxItem Content="{DynamicResource Str.TextureHighQuality}" Tag="4294967286"/>
                                    <ComboBoxItem Content="{DynamicResource Str.TextureQuality}" Tag="0"/>
                                    <ComboBoxItem Content="{DynamicResource Str.TexturePerformance}" Tag="10"/>
                                    <ComboBoxItem Content="{DynamicResource Str.TextureHighPerformance}" Tag="20"/>
                                </ComboBox>

                                <TextBlock Grid.Row="1" Text="{DynamicResource Str.DrsPowerManagement}" Style="{StaticResource DrsFieldLabelStyle}" VerticalAlignment="Center"/>
                                <ComboBox Style="{StaticResource SelectComboBoxStyle}" x:Name="PowerModeCombo" Grid.Row="1" Grid.Column="1" Margin="8,2,0,2"
                                          HorizontalAlignment="Stretch" SelectionChanged="Drs_SelectionChanged"
                                          ToolTip="{DynamicResource Str.TipPowerManagement}">
                                    <ComboBoxItem Content="{DynamicResource Str.FollowDriverGame}" Tag=""/>
                                    <ComboBoxItem Content="{DynamicResource Str.PowerPreferMax}" Tag="1"/>
                                    <ComboBoxItem Content="{DynamicResource Str.PowerAdaptive}" Tag="0"/>
                                    <ComboBoxItem Content="{DynamicResource Str.PowerDriverControlled}" Tag="2"/>
                                    <ComboBoxItem Content="{DynamicResource Str.PowerStablePerf}" Tag="3"/>
                                    <ComboBoxItem Content="{DynamicResource Str.PowerLowestConsumption}" Tag="4"/>
                                    <ComboBoxItem Content="{DynamicResource Str.PowerOptimal}" Tag="5"/>
                                </ComboBox>

                                <TextBlock Grid.Row="2" Text="{DynamicResource Str.DrsTransparencyAA}" Style="{StaticResource DrsFieldLabelStyle}" VerticalAlignment="Center"/>
                                <ComboBox Style="{StaticResource SelectComboBoxStyle}" x:Name="TransparencyCombo" Grid.Row="2" Grid.Column="1" Margin="8,2,0,2"
                                          HorizontalAlignment="Stretch" SelectionChanged="Drs_SelectionChanged"
                                          ToolTip="{DynamicResource Str.TipTransparencyAA}">
                                    <ComboBoxItem Content="{DynamicResource Str.FollowDriverGame}" Tag=""/>
                                    <ComboBoxItem Content="{DynamicResource Str.AaSuper2x}" Tag="2"/>
                                    <ComboBoxItem Content="{DynamicResource Str.AaSuper4x}" Tag="3"/>
                                    <ComboBoxItem Content="{DynamicResource Str.AaMultisample}" Tag="1"/>
                                    <ComboBoxItem Content="{DynamicResource Str.Off}" Tag="0"/>
                                </ComboBox>

                                <TextBlock Grid.Row="3" Text="{DynamicResource Str.DrsLowLatency}" Style="{StaticResource DrsFieldLabelStyle}" VerticalAlignment="Center"/>
                                <ComboBox Style="{StaticResource SelectComboBoxStyle}" x:Name="PreRenderCombo" Grid.Row="3" Grid.Column="1" Margin="8,2,0,2"
                                          HorizontalAlignment="Stretch" SelectionChanged="Drs_SelectionChanged"
                                          ToolTip="{DynamicResource Str.TipLowLatency}">
                                    <ComboBoxItem Content="{DynamicResource Str.AppControlled}" Tag=""/>
                                    <ComboBoxItem Content="{DynamicResource Str.Prerender1}" Tag="1"/>
                                    <ComboBoxItem Content="{DynamicResource Str.Prerender2}" Tag="2"/>
                                    <ComboBoxItem Content="{DynamicResource Str.Prerender3}" Tag="3"/>
                                </ComboBox>
                            </Grid>

                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{DynamicResource Str.DrsAnisotropic}" Style="{StaticResource DrsFieldLabelStyle}" VerticalAlignment="Center"/>
                                <ComboBox Style="{StaticResource SelectComboBoxStyle}" x:Name="AnisoCombo" Grid.Row="0" Grid.Column="1" Margin="8,2,0,2"
                                          HorizontalAlignment="Stretch" SelectionChanged="Drs_SelectionChanged"
                                          ToolTip="{DynamicResource Str.TipAnisotropic}">
                                    <ComboBoxItem Content="{DynamicResource Str.AppControlled}" Tag=""/>
                                    <ComboBoxItem Content="{DynamicResource Str.Af16x}" Tag="16"/>
                                    <ComboBoxItem Content="8x" Tag="8"/>
                                    <ComboBoxItem Content="4x" Tag="4"/>
                                    <ComboBoxItem Content="2x" Tag="2"/>
                                    <ComboBoxItem Content="{DynamicResource Str.Off}" Tag="0"/>
                                </ComboBox>

                                <TextBlock Grid.Row="1" Text="{DynamicResource Str.DrsVSync}" Style="{StaticResource DrsFieldLabelStyle}" VerticalAlignment="Center"/>
                                <ComboBox Style="{StaticResource SelectComboBoxStyle}" x:Name="VSyncCombo" Grid.Row="1" Grid.Column="1" Margin="8,2,0,2"
                                          HorizontalAlignment="Stretch" SelectionChanged="Drs_SelectionChanged"
                                          ToolTip="{DynamicResource Str.TipVSync}">
                                    <ComboBoxItem Content="{DynamicResource Str.AppControlled}" Tag=""/>
                                    <ComboBoxItem Content="{DynamicResource Str.VSyncForceOff}" Tag="off"/>
                                    <ComboBoxItem Content="{DynamicResource Str.VSyncForceOn}" Tag="on"/>
                                </ComboBox>

                                <TextBlock Grid.Row="2" Text="{DynamicResource Str.DrsShaderCache}" Style="{StaticResource DrsFieldLabelStyle}" VerticalAlignment="Center"/>
                                <ComboBox Style="{StaticResource SelectComboBoxStyle}" x:Name="ShaderCacheCombo" Grid.Row="2" Grid.Column="1" Margin="8,2,0,2"
                                          HorizontalAlignment="Stretch" SelectionChanged="Drs_SelectionChanged"
                                          ToolTip="{DynamicResource Str.TipShaderCache}">
                                    <ComboBoxItem Content="{DynamicResource Str.AppControlled}" Tag=""/>
                                    <ComboBoxItem Content="{DynamicResource Str.OnRecommended}" Tag="1"/>
                                    <ComboBoxItem Content="{DynamicResource Str.Off}" Tag="0"/>
                                </ComboBox>
                            </Grid>
                        </Grid>

                        <WrapPanel Margin="0,14,0,0">
                            <Button x:Name="DrsApplyButton" Content="{DynamicResource Str.ApplyDrs}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="110" Margin="0,0,8,0" Click="DrsApply_Click"/>
                            <Button x:Name="DrsRestoreButton" Content="{DynamicResource Str.RestoreDefault}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="110" Click="DrsRestore_Click"/>
                            <Button Content="{DynamicResource Str.ExportDiagnostics}" Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="8,0,0,0" Click="Diagnostics_Click"/>
                            <TextBlock Text="{DynamicResource Str.DrsDefaultHint}"
                                       Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </WrapPanel>

                        <TextBlock Text="{DynamicResource Str.DrsNote2}"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str.FrameLimitTitle}" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Str.FrameLimitIntro}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="FrameCurrentText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <Grid x:Name="FrameControls" IsEnabled="False" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <CheckBox x:Name="MainCapCheck" Content="{DynamicResource Str.FrameForeground}" Checked="FrameInputs_Changed" Unchecked="FrameInputs_Changed"/>
                                        <TextBox x:Name="MainCapBox" Text="144" MaxLength="4" Style="{StaticResource InputTextBoxStyle}" TextChanged="FrameInputs_Changed" Margin="0,6,0,0" AutomationProperties.Name="{DynamicResource Str.FrameForeground}"/>
                                        <TextBlock x:Name="FrameBudgetText" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/><WrapPanel Margin="0,10,0,0">
                                            <Button Content="60" Tag="60" Click="FramePreset_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
                                            <Button Content="120" Tag="120" Click="FramePreset_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
                                            <Button Content="144" Tag="144" Click="FramePreset_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
                                            <Button Content="165" Tag="165" Click="FramePreset_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
                                            <Button Content="240" Tag="240" Click="FramePreset_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <CheckBox x:Name="BackgroundCapCheck" Content="{DynamicResource Str.FrameBackground}" Checked="FrameInputs_Changed" Unchecked="FrameInputs_Changed"/>
                                        <TextBox x:Name="BackgroundCapBox" Text="30" MaxLength="3" Style="{StaticResource InputTextBoxStyle}" TextChanged="FrameInputs_Changed" Margin="0,6,0,0" AutomationProperties.Name="{DynamicResource Str.FrameBackground}"/>
                                        <TextBlock Text="{DynamicResource Str.FrameBackgroundHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="FrameApplyButton" Content="{DynamicResource Str.FrameApply}" Click="FrameApply_Click" IsEnabled="False" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                                    <Button x:Name="FrameRestoreButton" Content="{DynamicResource Str.FrameRestore}" Click="FrameRestore_Click" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}"/>
                                </WrapPanel>
                                <TextBlock x:Name="FrameStateText" Text="{DynamicResource Str.FrameRange}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="DrsUnsupportedText" Text="" Style="{StaticResource MutedTextStyle}"
                               Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- 建议与清单：两张信息卡归入同一页签；0.1.12 全宽下并排两列 -->
            <Grid x:Name="CardAdvice" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="11*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="9*"/>
                </Grid.ColumnDefinitions>

                <!-- 驱动版本建议：只读信息，本工具不下载也不安装驱动 -->
                <Border x:Name="CardAdviceD1" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.DriverCard}" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock x:Name="DriverAdviceText" Text="" Style="{StaticResource MutedTextStyle}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DriverAdviceSourceText" Text="" Style="{StaticResource MutedTextStyle}"
                                   Margin="0,10,0,0" TextWrapping="Wrap" FontSize="13"/>
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="DriverRefreshButton" Content="{DynamicResource Str.DriverRefresh}" Style="{StaticResource SecondaryButtonStyle}" Click="DriverRefresh_Click" Margin="0,0,8,8"/>
                            <Button x:Name="DriverOfficialButton" Content="{DynamicResource Str.DriverOfficial}" Style="{StaticResource SecondaryButtonStyle}" Click="DriverOfficial_Click" Margin="0,0,8,8"/>
                            <Button x:Name="DriverHotfixButton" Content="{DynamicResource Str.DriverHotfixLink}" Style="{StaticResource SecondaryButtonStyle}" Click="DriverOfficial_Click" Visibility="Collapsed" Margin="0,0,0,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 驱动内手动设置清单（P2-8）：按厂商生成，只读指引，不代改任何设置 -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.ManualCard}" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Str.ManualIntro}"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ManualGpuText" Text="" Style="{StaticResource MutedTextStyle}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>

                        <!-- N 卡：驱动 3D 设置卡已自动化，无需手动清单 -->
                        <TextBlock x:Name="ManualNvidiaText" Text="{DynamicResource Str.ManualNvidiaBody}"
                                   Style="{StaticResource ManualItem}" Visibility="Collapsed"/>

                        <!-- A 卡：Adrenalin 手动清单 -->
                        <StackPanel x:Name="ManualAmdPanel" Visibility="Collapsed" Margin="0,4,0,0">
                            <TextBlock Text="{DynamicResource Str.ManualAmdEntry}" Style="{StaticResource ManualItem}"/>
                            <TextBlock Text="{DynamicResource Str.ManualAmdItem1}" Style="{StaticResource ManualItem}"/>
                            <TextBlock Text="{DynamicResource Str.ManualAmdItem2}" Style="{StaticResource ManualItem}"/>
                            <TextBlock Text="{DynamicResource Str.ManualAmdItem3}" Style="{StaticResource ManualItem}"/>
                            <TextBlock Text="{DynamicResource Str.ManualAmdItem4}" Style="{StaticResource ManualItem}"/>
                            <TextBlock Text="{DynamicResource Str.ManualAmdItem5}" Style="{StaticResource ManualItem}"/>
                            <TextBlock Text="{DynamicResource Str.ManualAmdItem6}" Style="{StaticResource ManualItem}"/>
                            <TextBlock Text="{DynamicResource Str.ManualAmdItem7}" Style="{StaticResource ManualItem}"/>
                            <TextBlock Text="{DynamicResource Str.ManualAmdNote}" Style="{StaticResource ManualItem}" FontSize="13"/>
                        </StackPanel>

                        <!-- Intel：Graphics Software 手动清单 -->
                        <StackPanel x:Name="ManualIntelPanel" Visibility="Collapsed" Margin="0,4,0,0">
                            <TextBlock Text="{DynamicResource Str.ManualIntelEntry}" Style="{StaticResource ManualItem}"/>
                            <TextBlock Text="{DynamicResource Str.ManualIntelItem1}" Style="{StaticResource ManualItem}"/>
                            <TextBlock Text="{DynamicResource Str.ManualIntelItem2}" Style="{StaticResource ManualItem}"/>
                            <TextBlock Text="{DynamicResource Str.ManualIntelItem3}" Style="{StaticResource ManualItem}"/>
                            <TextBlock Text="{DynamicResource Str.ManualIntelItem4}" Style="{StaticResource ManualItem}"/>
                            <TextBlock Text="{DynamicResource Str.ManualIntelNote}" Style="{StaticResource ManualItem}" FontSize="13"/>
                        </StackPanel>

                        <!-- 识别不出厂商：明说，指向 ICC 兜底 -->
                        <TextBlock x:Name="ManualUnknownText" Text="{DynamicResource Str.ManualUnknownBody}"
                                   Style="{StaticResource ManualItem}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>
                <Border x:Name="CardGpuIdentity" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.GpuIdentityTitle}" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Str.GpuIdentityIntro}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,20"/>
                        <TextBlock Text="{DynamicResource Str.GpuIdentityDevice}" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="GpuIdentityDevices" MaxWidth="600" HorizontalAlignment="Left" MinWidth="320" Style="{StaticResource SelectComboBoxStyle}" SelectionChanged="GpuIdentitySelection_Changed" AutomationProperties.Name="{DynamicResource Str.GpuIdentityDevice}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button x:Name="GpuIdentityRefreshButton" Grid.Column="1" Content="{DynamicResource Str.GpuIdentityRefresh}" Click="GpuIdentityRefresh_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource Str.GpuIdentityChoose}" Style="{StaticResource SectionLabelStyle}" Margin="0,24,0,10"/>
                        <ListBox x:Name="GpuIdentityPresets" Background="Transparent" BorderThickness="0" SelectionChanged="GpuIdentitySelection_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{DynamicResource Str.GpuIdentityChoose}">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Padding" Value="14,14"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="PresetSurface" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter TargetName="PresetSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="PresetSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate></Setter.Value></Setter>
                            </Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="15" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding Series}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/><TextBlock Text="{DynamicResource Str.GpuIdentityRecommended}" Foreground="{DynamicResource AccentBrush}" FontSize="13" Margin="10,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsRecommended}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="16" Margin="0,10,0,18"><StackPanel>
                            <TextBlock Text="{DynamicResource Str.GpuIdentityPreview}" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock x:Name="GpuIdentityCurrentName" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,4"/>
                            <TextBlock x:Name="GpuIdentityPreviewName" Foreground="{DynamicResource AccentBrush}" FontSize="18" TextWrapping="Wrap"/>
                        </StackPanel></Border>
                        <WrapPanel>
                            <Button x:Name="GpuIdentityApplyButton" Content="{DynamicResource Str.GpuIdentityApply}" Click="GpuIdentityApply_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,8"/>
                            <Button x:Name="GpuIdentityRestoreButton" Content="{DynamicResource Str.GpuIdentityRestore}" Click="GpuIdentityRestore_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <TextBlock x:Name="GpuIdentityStatus" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>


        </StackPanel>
    </ScrollViewer>
</UserControl>
