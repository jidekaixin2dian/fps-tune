<UserControl x:Class="FpsTune.Wpf.Views.DisplayQualityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <!-- 预设卡片：与设置页的 SettingsChoice 同语言，两行内容（名称 + 说明） -->
        <Style x:Key="PresetCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="ChoiceBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14,10">
                    <ContentPresenter VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PresetCardText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PresetCardNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,24" MaxWidth="1060" HorizontalAlignment="Left">

            <!-- 页头 -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource Str.DisplayTitle}" Style="{StaticResource SectionLabelStyle}"/>
                <TextBlock Text="{DynamicResource Str.DisplayIntro}"
                           Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- 主体卡片 -->
            <Border Style="{StaticResource CardStyle}" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.DlssCard}" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock x:Name="GameStateText" Text="{DynamicResource Str.Reading}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <StackPanel x:Name="SupportedPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <TextBlock Text="{DynamicResource Str.DlssOverrideNote}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <UniformGrid Columns="3" Margin="0,10,0,0">
                            <RadioButton x:Name="PresetK" GroupName="dlssPreset" Style="{StaticResource PresetCard}"
                                         Checked="Preset_Checked">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.PresetK}" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="{DynamicResource Str.PresetKDesc}" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetFollowGame" GroupName="dlssPreset" Style="{StaticResource PresetCard}"
                                         Checked="Preset_Checked">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.FollowGame}" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="{DynamicResource Str.FollowGameDesc}" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetLatest" GroupName="dlssPreset" Style="{StaticResource PresetCard}"
                                         Checked="Preset_Checked">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.PresetLatest}" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="{DynamicResource Str.PresetLatestDesc}" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetM" GroupName="dlssPreset" Style="{StaticResource PresetCard}"
                                         Checked="Preset_Checked">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.PresetM}" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="{DynamicResource Str.PresetMDesc}" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetJ" GroupName="dlssPreset" Style="{StaticResource PresetCard}"
                                         Checked="Preset_Checked">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.PresetJ}" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="{DynamicResource Str.PresetJDesc}" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetE" GroupName="dlssPreset" Style="{StaticResource PresetCard}"
                                         Checked="Preset_Checked">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.PresetE}" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="{DynamicResource Str.PresetEDesc}" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>

                        <TextBlock x:Name="StateText" Text="" Style="{StaticResource MutedTextStyle}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="ApplyButton" Content="{DynamicResource Str.ApplyOverride}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="110" Margin="0,0,8,0" Click="Apply_Click"/>
                            <Button x:Name="RestoreButton" Content="{DynamicResource Str.RestoreDefault}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="110" Click="Restore_Click"/>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource Str.DlssNote}"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock x:Name="UnsupportedText" Text="" Style="{StaticResource MutedTextStyle}"
                               Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- 数字振动：显示级饱和度，全桌面生效 -->
            <Border Style="{StaticResource CardStyle}" Padding="20,18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.VibCard}" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock x:Name="VibStateText" Text="{DynamicResource Str.Reading}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <StackPanel x:Name="VibSupportedPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <TextBlock Text="{DynamicResource Str.VibNote}"
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Right" x:Name="VibPercentText" Text="—"
                                       Style="{StaticResource MutedTextStyle}" MinWidth="48" TextAlignment="Right"/>
                            <Slider x:Name="VibSlider" Minimum="0" Maximum="100" TickFrequency="5"
                                    IsSnapToTickEnabled="False" ValueChanged="VibSlider_Changed"/>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="VibApplyButton" Content="{DynamicResource Str.Apply}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="110" Margin="0,0,8,0" Click="VibApply_Click"/>
                            <Button x:Name="VibRestoreButton" Content="{DynamicResource Str.RestoreOriginal}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="110" Margin="0,0,8,0" Click="VibRestore_Click"/>
                            <Button x:Name="VibRecommendedButton" Content="{DynamicResource Str.VibRecommendedSet}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="130" Click="VibRecommended_Click"
                                    ToolTip="{DynamicResource Str.TipVibRecommended}"/>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource Str.VibRecommendedNote}"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="{DynamicResource Str.VibNote2}"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock x:Name="VibUnsupportedText" Text="" Style="{StaticResource MutedTextStyle}"
                               Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- ICC 滤镜卡片：系统层色彩变换，A 卡/Intel 与整体桌面观感兜底 -->
            <Border Style="{StaticResource CardStyle}" Padding="20,18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.IccCard}" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock x:Name="IccCurrentText" Text="{DynamicResource Str.Reading}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <StackPanel x:Name="IccSupportedPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <TextBlock Text="{DynamicResource Str.IccPresetLabel}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <UniformGrid Columns="4" Margin="0,10,0,0">
                            <RadioButton x:Name="IccPresetVivid" GroupName="iccPreset" Style="{StaticResource PresetCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.IccVivid}" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="{DynamicResource Str.IccVividDesc}" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="IccPresetShadowBoost" GroupName="iccPreset" Style="{StaticResource PresetCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.IccShadow}" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="{DynamicResource Str.IccShadowDesc}" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="IccPresetDehaze" GroupName="iccPreset" Style="{StaticResource PresetCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.IccDehaze}" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="{DynamicResource Str.IccDehazeDesc}" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="IccPresetNightGuard" GroupName="iccPreset" Style="{StaticResource PresetCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.IccNight}" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="{DynamicResource Str.IccNightDesc}" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="IccPresetWarm" GroupName="iccPreset" Style="{StaticResource PresetCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.IccWarm}" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="{DynamicResource Str.IccWarmDesc}" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="IccPresetCool" GroupName="iccPreset" Style="{StaticResource PresetCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.IccCool}" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="{DynamicResource Str.IccCoolDesc}" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="IccPresetSoft" GroupName="iccPreset" Style="{StaticResource PresetCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.IccSoft}" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="{DynamicResource Str.IccSoftDesc}" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="IccPresetStandard" GroupName="iccPreset" Style="{StaticResource PresetCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.IccStandard}" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="{DynamicResource Str.IccStandardDesc}" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>

                        <TextBlock x:Name="IccStateText" Text="" Style="{StaticResource MutedTextStyle}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="IccApplyButton" Content="{DynamicResource Str.ApplyPreset}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="110" Margin="0,0,8,0" Click="IccApply_Click"/>
                            <Button x:Name="IccRestoreButton" Content="{DynamicResource Str.RestoreOriginal}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="110" Click="IccRestore_Click"/>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource Str.IccNote}"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock x:Name="IccUnsupportedText" Text="" Style="{StaticResource MutedTextStyle}"
                               Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- M3：驱动 3D 设置（纹理/电源/透明度/低延迟） -->
            <Border Style="{StaticResource CardStyle}" Padding="20,18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.DrsCard}" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock x:Name="DrsStateText" Text="{DynamicResource Str.Reading}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <StackPanel x:Name="DrsSupportedPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <TextBlock Text="{DynamicResource Str.DrsNote}"
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="DrsPresetButton" Content="{DynamicResource Str.OneClickEsports}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="130" Margin="0,0,8,0" Click="DrsPreset_Click"
                                    ToolTip="{DynamicResource Str.TipOneClickEsports}"/>
                            <TextBlock Text="{DynamicResource Str.DrsDefaultHint}"
                                       Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{DynamicResource Str.DrsTextureFilter}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="TexQualityCombo" Grid.Row="0" Grid.Column="1" Margin="8,2" MinWidth="220"
                                      HorizontalAlignment="Left" SelectionChanged="Drs_SelectionChanged"
                                      ToolTip="{DynamicResource Str.TipTextureFilter}">
                                <ComboBoxItem Content="{DynamicResource Str.FollowDriverGame}" Tag=""/>
                                <ComboBoxItem Content="{DynamicResource Str.TextureHighQuality}" Tag="4294967286"/>
                                <ComboBoxItem Content="{DynamicResource Str.TextureQuality}" Tag="0"/>
                                <ComboBoxItem Content="{DynamicResource Str.TexturePerformance}" Tag="10"/>
                                <ComboBoxItem Content="{DynamicResource Str.TextureHighPerformance}" Tag="20"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="{DynamicResource Str.DrsPowerManagement}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PowerModeCombo" Grid.Row="1" Grid.Column="1" Margin="8,2" MinWidth="220"
                                      HorizontalAlignment="Left" SelectionChanged="Drs_SelectionChanged"
                                      ToolTip="{DynamicResource Str.TipPowerManagement}">
                                <ComboBoxItem Content="{DynamicResource Str.FollowDriverGame}" Tag=""/>
                                <ComboBoxItem Content="{DynamicResource Str.PowerPreferMax}" Tag="1"/>
                                <ComboBoxItem Content="{DynamicResource Str.PowerAdaptive}" Tag="0"/>
                                <ComboBoxItem Content="{DynamicResource Str.PowerDriverControlled}" Tag="2"/>
                                <ComboBoxItem Content="{DynamicResource Str.PowerStablePerf}" Tag="3"/>
                                <ComboBoxItem Content="{DynamicResource Str.PowerLowestConsumption}" Tag="4"/>
                                <ComboBoxItem Content="{DynamicResource Str.PowerOptimal}" Tag="5"/>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Text="{DynamicResource Str.DrsTransparencyAA}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="TransparencyCombo" Grid.Row="2" Grid.Column="1" Margin="8,2" MinWidth="220"
                                      HorizontalAlignment="Left" SelectionChanged="Drs_SelectionChanged"
                                      ToolTip="{DynamicResource Str.TipTransparencyAA}">
                                <ComboBoxItem Content="{DynamicResource Str.FollowDriverGame}" Tag=""/>
                                <ComboBoxItem Content="{DynamicResource Str.AaSuper2x}" Tag="2"/>
                                <ComboBoxItem Content="{DynamicResource Str.AaSuper4x}" Tag="3"/>
                                <ComboBoxItem Content="{DynamicResource Str.AaMultisample}" Tag="1"/>
                                <ComboBoxItem Content="{DynamicResource Str.Off}" Tag="0"/>
                            </ComboBox>

                            <TextBlock Grid.Row="3" Text="{DynamicResource Str.DrsLowLatency}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PreRenderCombo" Grid.Row="3" Grid.Column="1" Margin="8,2" MinWidth="220"
                                      HorizontalAlignment="Left" SelectionChanged="Drs_SelectionChanged"
                                      ToolTip="{DynamicResource Str.TipLowLatency}">
                                <ComboBoxItem Content="{DynamicResource Str.AppControlled}" Tag=""/>
                                <ComboBoxItem Content="{DynamicResource Str.Prerender1}" Tag="1"/>
                                <ComboBoxItem Content="{DynamicResource Str.Prerender2}" Tag="2"/>
                                <ComboBoxItem Content="{DynamicResource Str.Prerender3}" Tag="3"/>
                            </ComboBox>

                            <TextBlock Grid.Row="4" Text="{DynamicResource Str.DrsAnisotropic}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="AnisoCombo" Grid.Row="4" Grid.Column="1" Margin="8,2" MinWidth="220"
                                      HorizontalAlignment="Left" SelectionChanged="Drs_SelectionChanged"
                                      ToolTip="{DynamicResource Str.TipAnisotropic}">
                                <ComboBoxItem Content="{DynamicResource Str.AppControlled}" Tag=""/>
                                <ComboBoxItem Content="{DynamicResource Str.Af16x}" Tag="16"/>
                                <ComboBoxItem Content="8x" Tag="8"/>
                                <ComboBoxItem Content="4x" Tag="4"/>
                                <ComboBoxItem Content="2x" Tag="2"/>
                                <ComboBoxItem Content="{DynamicResource Str.Off}" Tag="0"/>
                            </ComboBox>

                            <TextBlock Grid.Row="5" Text="{DynamicResource Str.DrsVSync}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="VSyncCombo" Grid.Row="5" Grid.Column="1" Margin="8,2" MinWidth="220"
                                      HorizontalAlignment="Left" SelectionChanged="Drs_SelectionChanged"
                                      ToolTip="{DynamicResource Str.TipVSync}">
                                <ComboBoxItem Content="{DynamicResource Str.AppControlled}" Tag=""/>
                                <ComboBoxItem Content="{DynamicResource Str.VSyncForceOff}" Tag="off"/>
                                <ComboBoxItem Content="{DynamicResource Str.VSyncForceOn}" Tag="on"/>
                            </ComboBox>

                            <TextBlock Grid.Row="6" Text="{DynamicResource Str.DrsShaderCache}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ShaderCacheCombo" Grid.Row="6" Grid.Column="1" Margin="8,2" MinWidth="220"
                                      HorizontalAlignment="Left" SelectionChanged="Drs_SelectionChanged"
                                      ToolTip="{DynamicResource Str.TipShaderCache}">
                                <ComboBoxItem Content="{DynamicResource Str.AppControlled}" Tag=""/>
                                <ComboBoxItem Content="{DynamicResource Str.OnRecommended}" Tag="1"/>
                                <ComboBoxItem Content="{DynamicResource Str.Off}" Tag="0"/>
                            </ComboBox>
                        </Grid>

                        <TextBlock x:Name="DrsResultText" Text="" Style="{StaticResource MutedTextStyle}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="DrsApplyButton" Content="{DynamicResource Str.ApplyDrs}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="110" Margin="0,0,8,0" Click="DrsApply_Click"/>
                            <Button x:Name="DrsRestoreButton" Content="{DynamicResource Str.RestoreDefault}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="110" Click="DrsRestore_Click"/>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource Str.DrsNote2}"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock x:Name="DrsUnsupportedText" Text="" Style="{StaticResource MutedTextStyle}"
                               Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- 驱动版本建议：只读信息，本工具不下载也不安装驱动 -->
            <Border Style="{StaticResource CardStyle}" Padding="20,18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.DriverCard}" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock x:Name="DriverAdviceText" Text="" Style="{StaticResource MutedTextStyle}"
                               Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DriverAdviceSourceText" Text="" Style="{StaticResource MutedTextStyle}"
                               Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11.5"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
