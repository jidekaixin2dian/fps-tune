<UserControl x:Class="FpsTune.Wpf.Views.DisplayQualityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <!-- 预设卡片：与设置页的 SettingsChoice 同语言，两行内容（名称 + 说明） -->
        <Style x:Key="PresetCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="ChoiceBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14,10">
                    <ContentPresenter VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PresetCardText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PresetCardNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,24" MaxWidth="1060" HorizontalAlignment="Left">

            <!-- 页头 -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="显示与画质" Style="{StaticResource SectionLabelStyle}"/>
                <TextBlock Text="驱动层的按游戏画质设置：不修改游戏文件，随时一键还原"
                           Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- 主体卡片 -->
            <Border Style="{StaticResource CardStyle}" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="DLSS 超分模型覆盖（仅 NVIDIA RTX）" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock x:Name="GameStateText" Text="正在读取…" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <StackPanel x:Name="SupportedPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <TextBlock Text="覆盖预设（作用于当前定位的游戏；游戏内若自行选择超分设置，以本覆盖为准）"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <UniformGrid Columns="3" Margin="0,10,0,0">
                            <RadioButton x:Name="PresetFollowGame" GroupName="dlssPreset" Style="{StaticResource PresetCard}"
                                         Checked="Preset_Checked">
                                <StackPanel>
                                    <TextBlock Text="跟随游戏内" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="不覆盖，由游戏内设置决定" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetLatest" GroupName="dlssPreset" Style="{StaticResource PresetCard}"
                                         Checked="Preset_Checked">
                                <StackPanel>
                                    <TextBlock Text="最新" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="跟随驱动更新自动演进" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetM" GroupName="dlssPreset" Style="{StaticResource PresetCard}"
                                         Checked="Preset_Checked">
                                <StackPanel>
                                    <TextBlock Text="M 预设" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="新一代模型 · 高端画质首选" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetK" GroupName="dlssPreset" Style="{StaticResource PresetCard}"
                                         Checked="Preset_Checked">
                                <StackPanel>
                                    <TextBlock Text="K 预设" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="新一代模型 · 社区常用，稳定" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetJ" GroupName="dlssPreset" Style="{StaticResource PresetCard}"
                                         Checked="Preset_Checked">
                                <StackPanel>
                                    <TextBlock Text="J 预设" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="新一代模型 · 较早版本" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="PresetE" GroupName="dlssPreset" Style="{StaticResource PresetCard}"
                                         Checked="Preset_Checked">
                                <StackPanel>
                                    <TextBlock Text="E 预设" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="旧一代 CNN 模型 · 复古画质" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>

                        <TextBlock x:Name="StateText" Text="" Style="{StaticResource MutedTextStyle}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="ApplyButton" Content="应用覆盖"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="110" Margin="0,0,8,0" Click="Apply_Click"/>
                            <Button x:Name="RestoreButton" Content="还原默认"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="110" Click="Restore_Click"/>
                        </StackPanel>

                        <TextBlock Text="说明：覆盖写入本工具自建的驱动配置文件，删除即完全还原；不会触碰你或 NVIDIA App 自建的其他配置。画面差异需进游戏确认。"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock x:Name="UnsupportedText" Text="" Style="{StaticResource MutedTextStyle}"
                               Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- 数字振动：显示级饱和度，全桌面生效 -->
            <Border Style="{StaticResource CardStyle}" Padding="20,18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="数字振动（N 卡 · 显示器全局）" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock x:Name="VibStateText" Text="正在读取…" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <StackPanel x:Name="VibSupportedPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <TextBlock Text="作用于整块屏幕（桌面、网页、游戏都会变鲜艳），不是只在游戏内生效。主播常用 70–80%。"
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Right" x:Name="VibPercentText" Text="—"
                                       Style="{StaticResource MutedTextStyle}" MinWidth="48" TextAlignment="Right"/>
                            <Slider x:Name="VibSlider" Minimum="0" Maximum="100" TickFrequency="5"
                                    IsSnapToTickEnabled="False" ValueChanged="VibSlider_Changed"/>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="VibApplyButton" Content="应用"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="110" Margin="0,0,8,0" Click="VibApply_Click"/>
                            <Button x:Name="VibRestoreButton" Content="还原原始"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="110" Click="VibRestore_Click"/>
                        </StackPanel>

                        <TextBlock Text="说明：调整前自动记住当前档位，点「还原原始」一键恢复。与 ICC 滤镜独立，可叠加。对色准敏感请用较低档位或保持默认。"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock x:Name="VibUnsupportedText" Text="" Style="{StaticResource MutedTextStyle}"
                               Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- ICC 滤镜卡片：系统层色彩变换，A 卡/Intel 与整体桌面观感兜底 -->
            <Border Style="{StaticResource CardStyle}" Padding="20,18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="ICC 滤镜（系统层 · 仅主显示器）" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock x:Name="IccCurrentText" Text="正在读取…" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <StackPanel x:Name="IccSupportedPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <TextBlock Text="预设（作用于主显示器，全桌面生效：含桌面、网页与游戏窗口）"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <UniformGrid Columns="4" Margin="0,10,0,0">
                            <RadioButton x:Name="IccPresetVivid" GroupName="iccPreset" Style="{StaticResource PresetCard}">
                                <StackPanel>
                                    <TextBlock Text="FPS 鲜艳" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="微增饱和与对比，通用竞技" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="IccPresetShadowBoost" GroupName="iccPreset" Style="{StaticResource PresetCard}">
                                <StackPanel>
                                    <TextBlock Text="暗部增强" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="阴影段上抬，死角优先" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="IccPresetDehaze" GroupName="iccPreset" Style="{StaticResource PresetCard}">
                                <StackPanel>
                                    <TextBlock Text="去雾" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="S 型对比 + 微降蓝，雾天场景" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="IccPresetStandard" GroupName="iccPreset" Style="{StaticResource PresetCard}">
                                <StackPanel>
                                    <TextBlock Text="标准" Style="{StaticResource PresetCardText}"/>
                                    <TextBlock Text="还原为你原始的色彩配置" Style="{StaticResource PresetCardNote}"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>

                        <TextBlock x:Name="IccStateText" Text="" Style="{StaticResource MutedTextStyle}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="IccApplyButton" Content="应用预设"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="110" Margin="0,0,8,0" Click="IccApply_Click"/>
                            <Button x:Name="IccRestoreButton" Content="还原原始"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="110" Click="IccRestore_Click"/>
                        </StackPanel>

                        <TextBlock Text="说明：程序生成的 ICC 是简单曲线变换，效果弱于专业校色；对色准敏感请保留原 profile。任何页面回到这里点「标准」或「还原原始」即可恢复原状。多显示器暂不支持。"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock x:Name="IccUnsupportedText" Text="" Style="{StaticResource MutedTextStyle}"
                               Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- M3：驱动 3D 设置（纹理/电源/透明度/低延迟） -->
            <Border Style="{StaticResource CardStyle}" Padding="20,18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="驱动 3D 设置（按游戏 · N 卡）" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock x:Name="DrsStateText" Text="正在读取…" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <StackPanel x:Name="DrsSupportedPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <TextBlock Text="与 DLSS 覆盖写在同一游戏 profile 上，共用一键「还原默认」。SettingID 来自 NVIDIA 官方 NvApiDriverSettings.h。"
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="纹理过滤 · 质量" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="TexQualityCombo" Grid.Row="0" Grid.Column="1" Margin="8,2" MinWidth="220"
                                      HorizontalAlignment="Left" SelectionChanged="Drs_SelectionChanged">
                                <ComboBoxItem Content="跟随驱动/游戏" Tag=""/>
                                <ComboBoxItem Content="质量" Tag="0"/>
                                <ComboBoxItem Content="性能" Tag="10"/>
                                <ComboBoxItem Content="高性能" Tag="20"/>
                                <ComboBoxItem Content="高质量" Tag="4294967286"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="电源管理" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PowerModeCombo" Grid.Row="1" Grid.Column="1" Margin="8,2" MinWidth="220"
                                      HorizontalAlignment="Left" SelectionChanged="Drs_SelectionChanged">
                                <ComboBoxItem Content="跟随驱动/游戏" Tag=""/>
                                <ComboBoxItem Content="最高性能优先" Tag="1"/>
                                <ComboBoxItem Content="自适应" Tag="0"/>
                                <ComboBoxItem Content="由驱动控制" Tag="2"/>
                                <ComboBoxItem Content="最优电源" Tag="5"/>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Text="平滑处理 · 透明度" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="TransparencyCombo" Grid.Row="2" Grid.Column="1" Margin="8,2" MinWidth="220"
                                      HorizontalAlignment="Left" SelectionChanged="Drs_SelectionChanged">
                                <ComboBoxItem Content="跟随驱动/游戏" Tag=""/>
                                <ComboBoxItem Content="关闭" Tag="0"/>
                                <ComboBoxItem Content="多重采样" Tag="1"/>
                                <ComboBoxItem Content="超级采样 4x" Tag="2"/>
                            </ComboBox>

                            <TextBlock Grid.Row="3" Text="低延迟 · 预渲染帧" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PreRenderCombo" Grid.Row="3" Grid.Column="1" Margin="8,2" MinWidth="220"
                                      HorizontalAlignment="Left" SelectionChanged="Drs_SelectionChanged">
                                <ComboBoxItem Content="应用程序控制" Tag=""/>
                                <ComboBoxItem Content="1 帧（低延迟）" Tag="1"/>
                                <ComboBoxItem Content="2 帧" Tag="2"/>
                                <ComboBoxItem Content="3 帧" Tag="3"/>
                            </ComboBox>
                        </Grid>

                        <TextBlock x:Name="DrsResultText" Text="" Style="{StaticResource MutedTextStyle}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="DrsApplyButton" Content="应用 3D 设置"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="110" Margin="0,0,8,0" Click="DrsApply_Click"/>
                            <Button x:Name="DrsRestoreButton" Content="还原默认"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="110" Click="DrsRestore_Click"/>
                        </StackPanel>

                        <TextBlock Text="说明：写入驱动 profile，不改游戏文件；应用前自动备份原值，点「还原默认」一键恢复（与 DLSS 覆盖一起还原）。纹理选「性能」、电源选「最高性能优先」是社区高频组合，效果因游戏而异。"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock x:Name="DrsUnsupportedText" Text="" Style="{StaticResource MutedTextStyle}"
                               Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
