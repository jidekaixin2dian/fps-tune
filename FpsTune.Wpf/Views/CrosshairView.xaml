<UserControl x:Class="FpsTune.Wpf.Views.CrosshairView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource AppBackgroundBrush}" FontFamily="{StaticResource FontBody}">
    <UserControl.Resources>
        <!-- 预设色小方块：只留一块纯色，去掉按钮的默认边框与内边距。 -->
        <Style x:Key="CrosshairSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Swatch" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Swatch" Property="Opacity" Value="0.72"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="32,26,32,28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Str.CrosshairTitle}" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="{DynamicResource Str.CrosshairHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Padding="24,20" MaxWidth="900" HorizontalAlignment="Left"><StackPanel>
                    <CheckBox x:Name="CrosshairCheck" Content="{DynamicResource Str.CrosshairToggle}" Style="{StaticResource ToggleSwitchStyle}" Checked="Crosshair_Changed" Unchecked="Crosshair_Changed"/>
                    <!-- 两列栅格：每个滑杆都吃满自己那一列（以前挤在 WrapPanel 里只有一小截轨道）。 -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,20,14"><TextBlock Text="{DynamicResource Str.CrosshairStyleLabel}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CrosshairStyleBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource Str.CrosshairStyleLabel}" SelectionChanged="Crosshair_Changed">
                                <ComboBoxItem Content="{DynamicResource Str.CrosshairStyleCross}" Tag="cross"/>
                                <ComboBoxItem Content="{DynamicResource Str.CrosshairStyleDot}" Tag="dot"/>
                                <ComboBoxItem Content="{DynamicResource Str.CrosshairStyleCrossDot}" Tag="crossdot"/>
                                <ComboBoxItem Content="{DynamicResource Str.CrosshairStyleCircle}" Tag="circle"/>
                            </ComboBox></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,0,14"><TextBlock Text="{DynamicResource Str.CrosshairColorLabel}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                            <TextBox x:Name="CrosshairColorBox" Height="30" Style="{StaticResource InputTextBoxStyle}" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource Str.CrosshairColorLabel}" TextChanged="Crosshair_ColorChanged" LostFocus="Crosshair_ColorCommitted"/></StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,20,14"><TextBlock Text="{DynamicResource Str.CrosshairSizeLabel}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                            <Slider x:Name="CrosshairSizeSlider" Style="{StaticResource FillSliderStyle}" Minimum="4" Maximum="48" Value="12" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="{DynamicResource Str.CrosshairSizeLabel}" ValueChanged="Crosshair_Changed"/></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14"><TextBlock Text="{DynamicResource Str.CrosshairGapLabel}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                            <Slider x:Name="CrosshairGapSlider" Style="{StaticResource FillSliderStyle}" Minimum="0" Maximum="30" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="{DynamicResource Str.CrosshairGapLabel}" ValueChanged="Crosshair_Changed"/></StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,0,20,0"><TextBlock Text="{DynamicResource Str.CrosshairThicknessLabel}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                            <Slider x:Name="CrosshairThicknessSlider" Style="{StaticResource FillSliderStyle}" Minimum="1" Maximum="10" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="{DynamicResource Str.CrosshairThicknessLabel}" ValueChanged="Crosshair_Changed"/></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Text="{DynamicResource Str.CrosshairOpacityLabel}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                            <Slider x:Name="CrosshairOpacitySlider" Style="{StaticResource FillSliderStyle}" Minimum="10" Maximum="100" Value="90" TickFrequency="5" IsSnapToTickEnabled="True" AutomationProperties.Name="{DynamicResource Str.CrosshairOpacityLabel}" ValueChanged="Crosshair_Changed"/></StackPanel>
                    </Grid>
                    <!-- 调色盘：预设色 + HSV 三滑杆，与上面的十六进制框双向同步（改哪边另一侧立刻跟上）。 -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusControl}" Padding="14,12" Margin="0,0,0,16"
                            AutomationProperties.AutomationId="CrosshairPalette">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Border x:Name="CrosshairColorSwatch" DockPanel.Dock="Right" Width="48" Height="28" Background="#00FF66"
                                        CornerRadius="{DynamicResource RadiusControl}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        HorizontalAlignment="Right" AutomationProperties.AutomationId="CrosshairColorSwatch"
                                        AutomationProperties.Name="{DynamicResource Str.CrosshairColorCurrent}"/>
                                <TextBlock Text="{DynamicResource Str.CrosshairPaletteTitle}" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <WrapPanel x:Name="CrosshairSwatchPanel"/>
                            <!-- 单条最多 460：卡宽 900 时 0–360 的色相要拖 750px 才走完，手感极差。 -->
                            <Grid Margin="0,2,0,0" MaxWidth="460">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str.CrosshairHue}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                <Slider x:Name="CrosshairHueSlider" Grid.Column="1" Style="{StaticResource FillSliderStyle}" Minimum="0" Maximum="360" Value="140" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Margin="0,0,10,8" ValueChanged="Crosshair_HsvChanged" AutomationProperties.Name="{DynamicResource Str.CrosshairHue}"/>
                                <TextBlock x:Name="CrosshairHueValue" Grid.Column="2" FontSize="13" VerticalAlignment="Center" Margin="0,0,0,8"
                                           Typography.NumeralAlignment="Tabular" Text="140°"/>
                            </Grid>
                            <Grid MaxWidth="460">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str.CrosshairSaturation}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                <Slider x:Name="CrosshairSaturationSlider" Grid.Column="1" Style="{StaticResource FillSliderStyle}" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Margin="0,0,10,8" ValueChanged="Crosshair_HsvChanged" AutomationProperties.Name="{DynamicResource Str.CrosshairSaturation}"/>
                                <TextBlock x:Name="CrosshairSaturationValue" Grid.Column="2" FontSize="13" VerticalAlignment="Center" Margin="0,0,0,8"
                                           Typography.NumeralAlignment="Tabular" Text="100%"/>
                            </Grid>
                            <Grid MaxWidth="460">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str.CrosshairBrightness}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Slider x:Name="CrosshairBrightnessSlider" Grid.Column="1" Style="{StaticResource FillSliderStyle}" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Margin="0,0,10,0" ValueChanged="Crosshair_HsvChanged" AutomationProperties.Name="{DynamicResource Str.CrosshairBrightness}"/>
                                <TextBlock x:Name="CrosshairBrightnessValue" Grid.Column="2" FontSize="13" VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular" Text="100%"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <!-- 覆盖准星在本程序前台时会自动隐藏，光看屏幕看不出改没改；这里给一份同款图形的预览。 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="150" Height="150" Background="#0E1218" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}">
                            <ContentControl x:Name="CrosshairPreviewHost" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.AutomationId="CrosshairPreviewHost" AutomationProperties.Name="{DynamicResource Str.CrosshairPreviewTitle}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="14,0,0,0" MaxWidth="380">
                            <TextBlock Text="{DynamicResource Str.CrosshairPreviewTitle}" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="{DynamicResource Str.CrosshairPreviewHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,4,0,0"><StackPanel>
                        <CheckBox x:Name="CrosshairAdaptiveCheck" Content="{DynamicResource Str.CrosshairAdaptiveToggle}" Style="{StaticResource ToggleSwitchStyle}" Checked="Crosshair_Changed" Unchecked="Crosshair_Changed"/>
                        <TextBlock Text="{DynamicResource Str.CrosshairAdaptiveHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel></Border>
                </StackPanel></Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
