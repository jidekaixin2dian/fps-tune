<UserControl x:Class="FpsTune.Wpf.Views.ScreenColorPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:FpsTune.Wpf.Views.Controls">
  <UserControl.Resources>
   <Style x:Key="FilterChipStyle" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,7,7"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
     <Border x:Name="Chip" CornerRadius="{DynamicResource RadiusControl}" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ContentPresenter/></Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
      <DataTrigger Binding="{Binding Preset}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </UserControl.Resources>

  <!-- 版式对齐 1U：左列预设；右列「滚动区（上预览 + 下实时调色）」+ 底部常驻应用栏。
       窄窗口（< 980）收起预设列，改成一列滚动，避免把实拍图压扁。 -->
  <Grid x:Name="WorkspaceGrid" MaxWidth="2400" HorizontalAlignment="Stretch" SizeChanged="Workspace_SizeChanged">
   <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="PresetColumn" Width="380"/>
    <ColumnDefinition x:Name="PreviewColumn" Width="*"/>
   </Grid.ColumnDefinitions>

   <!-- 左：预设滤镜（分类 / 搜索 / 收藏 + 自定义滤镜入口） -->
   <Border x:Name="PresetPane" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18,16" Margin="0,0,16,0" VerticalAlignment="Top">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <ContentControl x:Name="FilterHost"/>
    </ScrollViewer>
   </Border>

   <!-- 右：滚动区 + 底部应用栏 -->
   <Grid x:Name="ControlsPane" Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <ScrollViewer x:Name="ControlsScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <!-- 预览：原图 / 调色后对比 -->
      <Border x:Name="PreviewPane" Style="{StaticResource CardStyle}" Padding="16,14">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
         <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Str.ColorPreviewTitle}" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center"/>
         <TextBlock x:Name="PreviewModeHint" DockPanel.Dock="Right" Text="{DynamicResource Str.ColorPreviewStickyHint}"
                    Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </DockPanel>
        <controls:ColorPreviewControl Grid.Row="1" x:Name="ColorPreview"/>

        <!-- 旧的重复滤镜选择区保留 namescope 和状态，但不再出现在界面上。 -->
        <Border Grid.Row="2" x:Name="FilterPickerBox" Visibility="Collapsed" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="{DynamicResource RadiusControl}" Padding="14" Margin="0,14,0,0">
         <StackPanel>
          <DockPanel Margin="0,0,0,10">
           <CheckBox x:Name="IccEnabledCheck" DockPanel.Dock="Right" Content="{DynamicResource Str.ColorIccEnabled}" Checked="IccToggle_Changed" Unchecked="IccToggle_Changed" VerticalAlignment="Center"/>
           <TextBlock Text="{DynamicResource Str.ColorChooseFilter}" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center"/>
          </DockPanel>
          <ComboBox x:Name="ColorModeCombo" Visibility="Collapsed" SelectedIndex="0" SelectionChanged="Mode_Changed">
           <ComboBoxItem Content="{DynamicResource Str.ColorScreenMode}"/><ComboBoxItem Content="{DynamicResource Str.ColorIccMode}"/>
          </ComboBox>
          <ComboBox x:Name="IccPresetCombo" Visibility="Collapsed" SelectionChanged="IccPreset_Changed"/>
          <ListBox x:Name="FilterChips" PreviewMouseLeftButtonUp="FilterChips_Click" BorderThickness="0" Background="Transparent" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{Binding ItemsSource, ElementName=IccPresetCombo}" SelectedItem="{Binding SelectedItem, ElementName=IccPresetCombo, Mode=TwoWay}" ItemContainerStyle="{StaticResource FilterChipStyle}" AutomationProperties.Name="{DynamicResource Str.ColorChooseFilter}">
           <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
           <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" FontSize="13"/></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="FilterDescription" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,3,0,0"/>
          <TextBlock x:Name="IccFileText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
         </StackPanel>
        </Border>
       </Grid>
      </Border>

      <StackPanel x:Name="CurrentModePanel">
       <!-- 实时调色：3 列参数网格（标签 + 数值在上，滑杆在下），与 1U 的排布一致。 -->
       <Border Style="{StaticResource CardStyle}" Padding="20,16" Margin="0,12,0,0">
        <StackPanel>
         <DockPanel Margin="0,0,0,4">
          <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Str.ColorLiveTuning}" Style="{StaticResource CardTitleStyle}"/>
         </DockPanel>
         <UniformGrid x:Name="ParameterGrid" Columns="3" Margin="0,10,0,0"/>
         <Expander Header="{DynamicResource Str.ColorParameterPresets}" Margin="0,10,0,0">
          <ComboBox x:Name="ColorPresetCombo" Style="{StaticResource SelectComboBoxStyle}" SelectionChanged="Preset_Changed" AutomationProperties.Name="{DynamicResource Str.ColorPreset}" Margin="0,8,0,0"/>
         </Expander>
        </StackPanel>
       </Border>

       <!-- 暗部场景平衡：跟在调色参数后面，不进折叠区。 -->
       <Border Style="{StaticResource CardStyle}" Padding="20,16" Margin="0,12,0,0" AutomationProperties.AutomationId="DarkBalanceCard">
        <StackPanel>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="{DynamicResource Str.ColorDarkBalance}" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" Margin="0,0,14,0"/>
          <CheckBox x:Name="DarkBalanceToggle" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                    Checked="DarkBalance_Toggled" Unchecked="DarkBalance_Toggled"
                    AutomationProperties.Name="{DynamicResource Str.ColorDarkBalance}"/>
          <Button x:Name="DarkBalanceResetButton" Grid.Column="2" Content="{DynamicResource Str.ColorDarkBalanceReset}"
                  Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Margin="14,0,0,0" Click="DarkBalance_Reset_Click"/>
         </Grid>
         <TextBlock x:Name="DarkBalanceValue" Text="50" FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,0"
                    Typography.NumeralAlignment="Tabular" AutomationProperties.AutomationId="DarkBalanceValue"/>
         <StackPanel x:Name="DarkBalanceRowHost" Margin="0,4,0,0"/>
         <Grid Margin="0,2,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{DynamicResource Str.ColorDarkBalanceDark}" Style="{StaticResource MutedTextStyle}" FontSize="13"/>
          <TextBlock Grid.Column="2" Text="{DynamicResource Str.ColorDarkBalanceBright}" Style="{StaticResource MutedTextStyle}" FontSize="13"/>
         </Grid>
        </StackPanel>
       </Border>

       <Border Style="{StaticResource CardStyle}" Padding="20,16" Margin="0,12,0,0">
        <StackPanel>
         <TextBlock Text="{DynamicResource Str.VibCard}" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10"/>
         <ContentControl x:Name="VibranceHost"/>
        </StackPanel>
       </Border>

       <Border Style="{StaticResource CardStyle}" Padding="20,16" Margin="0,12,0,0">
        <ContentControl x:Name="IccHost"/>
       </Border>

       <Expander x:Name="AutomationExpander" Header="{DynamicResource Str.FilterAutomationSection}" IsExpanded="False" Margin="0,12,0,0">
        <ContentControl x:Name="AutomationHost" Margin="0,12,0,0"/>
       </Expander>
      </StackPanel>

      <Border x:Name="PerAppCard" Style="{StaticResource CardStyle}" Padding="20,16" Visibility="Collapsed">
       <ContentControl x:Name="PerAppHost"/>
      </Border>
     </StackPanel>
    </ScrollViewer>

    <!-- 底部常驻应用栏（1U：先调参数，再决定怎么应用） -->
    <Border x:Name="ActionBar" Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusControl}" Padding="14,12" Margin="0,12,0,0">
     <StackPanel Grid.IsSharedSizeScope="True">
      <DockPanel>
       <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Str.ColorApplyBarTitle}" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center"/>
       <WrapPanel HorizontalAlignment="Right">
        <Button x:Name="ColorApplyButton" Content="{DynamicResource Str.FilterApplyAll}" Style="{StaticResource PrimaryButtonStyle}" Click="Apply_Click" Margin="0,0,8,0"/>
        <Button x:Name="ColorRestoreButton" Content="{DynamicResource Str.FilterRestoreAll}" Style="{StaticResource SecondaryButtonStyle}" Click="Restore_Click" Margin="0,0,8,0"/>
        <Button x:Name="ColorResetButton" Content="{DynamicResource Str.ColorReset}" Style="{StaticResource GhostButtonStyle}" Click="Reset_Click"/>
       </WrapPanel>
      </DockPanel>
      <!-- 应用到：桌面 / 全部游戏（全自动模板）/ 进游戏时·xxx.exe -->
      <Grid Margin="0,12,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="applyBarLabel"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Text="{DynamicResource Str.ColorApplyTarget}" VerticalAlignment="Center" Margin="0,0,10,0"/>
       <ComboBox x:Name="ApplyTargetCombo" Grid.Column="1" MinWidth="240" MaxWidth="340"
                 Style="{StaticResource SelectComboBoxStyle}" SelectionChanged="ApplyTarget_Changed" DropDownOpened="ApplyTarget_DropDownOpened"
                 AutomationProperties.Name="{DynamicResource Str.ColorApplyTarget}"/>
       <Button x:Name="SaveSchemeButton" Grid.Column="2" Content="{DynamicResource Str.FilterSchemeSave}" Style="{StaticResource GhostButtonStyle}"
               Margin="12,0,0,0" Click="SaveScheme_Click"/>
      </Grid>
      <!-- 存下来的滤镜方案：载入回来继续调，或直接删掉；可整体导出/导入备份 -->
      <Grid Margin="0,8,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="applyBarLabel"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Text="{DynamicResource Str.FilterSchemeTitle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
       <ComboBox x:Name="SchemeCombo" Grid.Column="1" MinWidth="240" MaxWidth="340"
                 Style="{StaticResource SelectComboBoxStyle}" AutomationProperties.Name="{DynamicResource Str.FilterSchemeTitle}"/>
       <Button x:Name="LoadSchemeButton" Grid.Column="2" Content="{DynamicResource Str.FilterSchemeLoad}" Style="{StaticResource GhostButtonStyle}"
               Margin="12,0,0,0" Click="LoadScheme_Click"/>
       <Button x:Name="DeleteSchemeButton" Grid.Column="3" Content="{DynamicResource Str.FilterSchemeDelete}" Style="{StaticResource GhostButtonStyle}"
               Margin="8,0,0,0" Click="DeleteScheme_Click"/>
       <Button x:Name="ExportSchemesButton" Grid.Column="4" Content="{DynamicResource Str.FilterSchemeExport}" Style="{StaticResource GhostButtonStyle}"
               Margin="8,0,0,0" Click="ExportSchemes_Click"/>
       <Button x:Name="ImportSchemesButton" Grid.Column="5" Content="{DynamicResource Str.FilterSchemeImport}" Style="{StaticResource GhostButtonStyle}"
               Margin="8,0,0,0" Click="ImportSchemes_Click"/>
      </Grid>
      <TextBlock x:Name="ColorStatus" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
  </Grid>
</UserControl>
