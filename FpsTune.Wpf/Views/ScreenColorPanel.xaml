<UserControl x:Class="FpsTune.Wpf.Views.ScreenColorPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:FpsTune.Wpf.Views.Controls">
  <UserControl.Resources>
   <Style x:Key="FilterChipStyle" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,7,7"/>
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
     <Border x:Name="Chip" CornerRadius="{DynamicResource RadiusControl}" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ContentPresenter/></Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
      <DataTrigger Binding="{Binding Preset}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </UserControl.Resources>
 <StackPanel MaxWidth="1520" HorizontalAlignment="Stretch">
  <TextBlock Text="{DynamicResource Str.ColorPanelTitle}" Style="{StaticResource CardTitleStyle}"/>
  <TextBlock Text="{DynamicResource Str.ColorPanelHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,16"/>

  <Grid x:Name="WorkspaceGrid" SizeChanged="Workspace_SizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="PreviewColumn" Width="*"/><ColumnDefinition x:Name="ControlsColumn" Width="420"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel x:Name="PreviewPane" Margin="0,0,24,0">
    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="{DynamicResource RadiusControl}" Padding="14" Margin="0,0,0,14">
     <StackPanel>
      <DockPanel Margin="0,0,0,10">
       <CheckBox x:Name="IccEnabledCheck" DockPanel.Dock="Right" Content="{DynamicResource Str.ColorIccEnabled}" Checked="IccToggle_Changed" Unchecked="IccToggle_Changed" VerticalAlignment="Center"/>
       <TextBlock Text="{DynamicResource Str.ColorChooseFilter}" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center"/>
      </DockPanel>
      <ComboBox x:Name="ColorModeCombo" Visibility="Collapsed" SelectedIndex="0" SelectionChanged="Mode_Changed">
       <ComboBoxItem Content="{DynamicResource Str.ColorScreenMode}"/><ComboBoxItem Content="{DynamicResource Str.ColorIccMode}"/>
      </ComboBox>
      <ComboBox x:Name="IccPresetCombo" Visibility="Collapsed" SelectionChanged="IccPreset_Changed"/>
      <ListBox x:Name="FilterChips" PreviewMouseLeftButtonUp="FilterChips_Click" BorderThickness="0" Background="Transparent" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{Binding ItemsSource, ElementName=IccPresetCombo}" SelectedItem="{Binding SelectedItem, ElementName=IccPresetCombo, Mode=TwoWay}" ItemContainerStyle="{StaticResource FilterChipStyle}" AutomationProperties.Name="{DynamicResource Str.ColorChooseFilter}">
       <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
       <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" FontSize="13"/></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="FilterDescription" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,3,0,0"/>
      <TextBlock x:Name="IccFileText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
      <ContentControl x:Name="IccHost" Margin="0,10,0,0"/>
     </StackPanel>
    </Border>
    <controls:ColorPreviewControl x:Name="ColorPreview"/>

   </StackPanel>
   <StackPanel x:Name="ControlsPane" Grid.Column="1">
  <Border Margin="0,0,0,14">
   <StackPanel>
    <WrapPanel>
     <Button x:Name="ColorApplyButton" Content="{DynamicResource Str.ColorApplyTitle}" Style="{StaticResource PrimaryButtonStyle}" Click="Apply_Click" Margin="0,0,8,8"/>
     <Button x:Name="ColorRestoreButton" Content="{DynamicResource Str.ColorRestoreAll}" Style="{StaticResource SecondaryButtonStyle}" Click="Restore_Click" Margin="0,0,0,8"/>
    </WrapPanel>
    <TextBlock x:Name="ColorStatus" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
   </StackPanel>
  </Border>
    <TextBlock Text="{DynamicResource Str.ColorParametersLayer}" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
    <Expander Header="{DynamicResource Str.ColorParameterPresets}" Margin="0,0,0,6"><ComboBox x:Name="ColorPresetCombo" Style="{StaticResource SelectComboBoxStyle}" SelectionChanged="Preset_Changed" AutomationProperties.Name="{DynamicResource Str.ColorPreset}" Margin="0,8,0,0"/></Expander>
    <UniformGrid x:Name="ParameterGrid" Columns="2" Margin="0,14,0,0"/>
    <Button x:Name="ColorResetButton" Content="{DynamicResource Str.ColorReset}" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Click="Reset_Click" Margin="0,0,0,12"/>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0"><ContentControl x:Name="VibranceHost"/></Border>

   </StackPanel>
  </Grid>

 </StackPanel>
</UserControl>
