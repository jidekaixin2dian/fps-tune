<UserControl x:Class="FpsTune.Wpf.Views.ScreenColorPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:FpsTune.Wpf.Views.Controls">
  <UserControl.Resources>
   <Style x:Key="FilterChipStyle" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,7,7"/>
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
     <Border x:Name="Chip" CornerRadius="{DynamicResource RadiusControl}" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ContentPresenter/></Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
      <DataTrigger Binding="{Binding Preset}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </UserControl.Resources>

  <Grid x:Name="WorkspaceGrid" MaxWidth="1640" HorizontalAlignment="Stretch" SizeChanged="Workspace_SizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="PreviewColumn" Width="*"/><ColumnDefinition x:Name="ControlsColumn" Width="420"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

   <!-- 左侧固定：无论右侧筛选、调参、编辑 ICC 或切到独立方案，这块实机图始终在旁边。 -->
   <Border x:Name="PreviewPane" Style="{StaticResource CardStyle}" Padding="24,20" Margin="0,0,22,0" VerticalAlignment="Stretch">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Str.ColorPreviewTitle}" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center"/>
      <TextBlock x:Name="PreviewModeHint" DockPanel.Dock="Right" Text="{DynamicResource Str.ColorPreviewStickyHint}"
                 Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
     </DockPanel>
     <!-- 图片占满剩余高度：下面的说明行永远是 Auto，高度不够时缩的是图，不再是字。 -->
     <controls:ColorPreviewControl Grid.Row="1" x:Name="ColorPreview"/>

     <!-- 旧的重复滤镜选择区保留 namescope 和状态，但不再出现在界面上。 -->
     <Border Grid.Row="2" x:Name="FilterPickerBox" Visibility="Collapsed" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="{DynamicResource RadiusControl}" Padding="14" Margin="0,14,0,0">
      <StackPanel>
       <DockPanel Margin="0,0,0,10">
        <CheckBox x:Name="IccEnabledCheck" DockPanel.Dock="Right" Content="{DynamicResource Str.ColorIccEnabled}" Checked="IccToggle_Changed" Unchecked="IccToggle_Changed" VerticalAlignment="Center"/>
        <TextBlock Text="{DynamicResource Str.ColorChooseFilter}" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center"/>
       </DockPanel>
       <ComboBox x:Name="ColorModeCombo" Visibility="Collapsed" SelectedIndex="0" SelectionChanged="Mode_Changed">
        <ComboBoxItem Content="{DynamicResource Str.ColorScreenMode}"/><ComboBoxItem Content="{DynamicResource Str.ColorIccMode}"/>
       </ComboBox>
       <ComboBox x:Name="IccPresetCombo" Visibility="Collapsed" SelectionChanged="IccPreset_Changed"/>
       <ListBox x:Name="FilterChips" PreviewMouseLeftButtonUp="FilterChips_Click" BorderThickness="0" Background="Transparent" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{Binding ItemsSource, ElementName=IccPresetCombo}" SelectedItem="{Binding SelectedItem, ElementName=IccPresetCombo, Mode=TwoWay}" ItemContainerStyle="{StaticResource FilterChipStyle}" AutomationProperties.Name="{DynamicResource Str.ColorChooseFilter}">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" FontSize="13"/></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock x:Name="FilterDescription" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,3,0,0"/>
       <TextBlock x:Name="IccFileText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>

   <Grid x:Name="ControlsPane" Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <!-- 一套按钮只服务一个完整方案：应用时同时处理滤镜、画面参数和振动；还原同样一次处理。 -->
    <Border x:Name="ActionBar" Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusControl}" Padding="14,12" Margin="0,0,0,12">
     <StackPanel>
      <WrapPanel>
       <Button x:Name="ColorApplyButton" Content="{DynamicResource Str.FilterApplyAll}" Style="{StaticResource PrimaryButtonStyle}" Click="Apply_Click" Margin="0,0,8,8"/>
       <Button x:Name="ColorRestoreButton" Content="{DynamicResource Str.FilterRestoreAll}" Style="{StaticResource SecondaryButtonStyle}" Click="Restore_Click" Margin="0,0,0,8"/>
      </WrapPanel>
      <TextBlock x:Name="ColorStatus" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
     </StackPanel>
    </Border>

    <ScrollViewer x:Name="ControlsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
     <StackPanel x:Name="CurrentModePanel" Margin="0,0,4,0">
      <!-- 滤镜选择、收藏、搜索与编辑 ICC 统一在这一栏。 -->
      <Border Style="{StaticResource CardStyle}" Padding="24,20" Margin="0,0,0,20">
       <ContentControl x:Name="FilterHost"/>
      </Border>

      <!-- 暗部平衡：选滤镜时最常调的项，单独一张卡放在滤镜列表正下方；滑块本体仍由下方循环生成（与画面参数同一份状态）。 -->
      <Border Style="{StaticResource CardStyle}" Padding="24,20" Margin="0,0,0,20" AutomationProperties.AutomationId="DarkBalanceCard">
       <StackPanel>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource Str.ColorDarkBalance}" Style="{StaticResource CardTitleStyle}"/>
          <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
           <TextBlock Text="{DynamicResource Str.FilterEditorDarkBalanceTag}" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
          </Border>
         </StackPanel>
         <TextBlock Grid.Column="1" x:Name="DarkBalanceGammaText" Text="γ 1.00"
                    FontFamily="{StaticResource FontStat}" Typography.NumeralAlignment="Tabular" FontSize="17"
                    FontWeight="{DynamicResource StrongEmphasisWeight}" Foreground="{DynamicResource AccentBrush}"
                    VerticalAlignment="Center" AutomationProperties.AutomationId="DarkBalanceGammaText"
                    AutomationProperties.Name="{DynamicResource Str.FilterEditorDarkBalanceGamma}"/>
        </Grid>
        <StackPanel x:Name="DarkBalanceRowHost" Margin="0,12,0,0"/>
        <Grid Margin="0,2,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="{DynamicResource Str.FilterEditorDarkBalanceBright}" Style="{StaticResource MutedTextStyle}" FontSize="13"/>
         <TextBlock Grid.Column="1" Text="{DynamicResource Str.FilterEditorDarkBalanceNeutral}" Style="{StaticResource MutedTextStyle}" FontSize="13" HorizontalAlignment="Center"/>
         <TextBlock Grid.Column="2" Text="{DynamicResource Str.FilterEditorDarkBalanceDark}" Style="{StaticResource MutedTextStyle}" FontSize="13"/>
        </Grid>
        <TextBlock Text="{DynamicResource Str.FilterEditorDarkBalanceHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
       </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}" Padding="24,20" Margin="0,0,0,20">
       <StackPanel>
        <TextBlock Text="{DynamicResource Str.ColorParametersLayer}" Style="{StaticResource CardTitleStyle}"/>
        <Expander Header="{DynamicResource Str.ColorParameterPresets}" Margin="0,10,0,4">
         <ComboBox x:Name="ColorPresetCombo" Style="{StaticResource SelectComboBoxStyle}" SelectionChanged="Preset_Changed" AutomationProperties.Name="{DynamicResource Str.ColorPreset}" Margin="0,8,0,0"/>
        </Expander>
        <UniformGrid x:Name="ParameterGrid" Columns="2" Margin="0,14,0,0"/>
        <Button x:Name="ColorResetButton" Content="{DynamicResource Str.ColorReset}" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Click="Reset_Click" Margin="0,4,0,0"/>
       </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}" Padding="24,20" Margin="0,0,0,20">
       <StackPanel>
        <TextBlock Text="{DynamicResource Str.VibCard}" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10"/>
        <ContentControl x:Name="VibranceHost"/>
       </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}" Padding="24,20" Margin="0,0,0,20">
       <ContentControl x:Name="IccHost"/>
      </Border>

      <Expander x:Name="AutomationExpander" Header="{DynamicResource Str.FilterAutomationSection}" IsExpanded="False" Margin="0,0,0,14">
       <ContentControl x:Name="AutomationHost" Margin="0,12,0,0"/>
      </Expander>
     </StackPanel>

     <Border x:Name="PerAppCard" Style="{StaticResource CardStyle}" Padding="24,20" Visibility="Collapsed">
      <ContentControl x:Name="PerAppHost"/>
     </Border>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </Grid>
</UserControl>
