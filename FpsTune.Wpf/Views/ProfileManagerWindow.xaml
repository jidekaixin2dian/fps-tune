<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FpsTune.Wpf.Views.ProfileManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.MyProfiles}"
        Width="500"
        Height="560"
        MinWidth="440"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource FontBody}">
    <Border Margin="18"
            Background="{DynamicResource AppBackdropBrush}"
            BorderBrush="{DynamicResource BorderHoverBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusCard}"
            Padding="24,22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="4"
                              Opacity="0.35"
                              Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38"
                        CornerRadius="{StaticResource RadiusControl}"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE8EC;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Str.MyProfiles}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="SelectionSummaryText" Text=""
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- 保存当前勾选 -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}"
                    Padding="14,12"
                    Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.ProfileSaveCurrent}"
                               Style="{StaticResource MutedTextStyle}"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ProfileNameBox"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Height="34"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 KeyDown="ProfileNameBox_KeyDown"/>
                        <Button Grid.Column="1"
                                Content="{DynamicResource Str.Save}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="76"
                                Margin="10,0,0,0"
                                Click="Save_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 已保存方案列表 -->
            <TextBlock Grid.Row="2" Text="{DynamicResource Str.ProfileSavedList}"
                       Style="{StaticResource MutedTextStyle}"
                       Margin="0,18,0,0"/>
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock x:Name="EmptyHint"
                               Text="{DynamicResource Str.ProfilesEmpty}"
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap"
                               Margin="2,10,0,10"/>
                    <ItemsControl x:Name="ProfileList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="2,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayName}"/>
                                            <TextBlock Text="{Binding CountText}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="12"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{DynamicResource Str.Load}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    MinWidth="64"
                                                    Margin="0,0,6,0"
                                                    Click="LoadRow_Click"
                                                    Tag="{Binding}"/>
                                            <Button Content="{DynamicResource Str.Export}"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    MinWidth="64"
                                                    Margin="0,0,6,0"
                                                    Click="ExportRow_Click"
                                                    Tag="{Binding}"/>
                                            <Button Content="{DynamicResource Str.Delete}"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    MinWidth="64"
                                                    Click="DeleteRow_Click"
                                                    Tag="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部操作 -->
            <Grid Grid.Row="4" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="{DynamicResource Str.Import}"
                        Style="{StaticResource GhostButtonStyle}"
                        MinWidth="88"
                        Click="Import_Click"/>
                <Button Grid.Column="2"
                        Content="{DynamicResource Str.Close}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="88"
                        Click="Close_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
