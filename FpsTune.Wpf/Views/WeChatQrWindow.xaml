<Window x:Class="FpsTune.Wpf.Views.WeChatQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="微信二维码"
        Width="340"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource FontBody}">
    <Border Margin="18"
            Background="{DynamicResource AppBackdropBrush}"
            BorderBrush="{DynamicResource BorderHoverBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusCard}"
            Padding="22"
            MouseLeftButtonDown="DragMove_Click">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="4"
                              Opacity="0.35"
                              Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="微信二维码"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="WeChatNameText"
                               Text="记得开心1点"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>
                <Button Content="✕"
                        Style="{StaticResource CaptionButtonStyle}"
                        Width="28" Height="28"
                        FontSize="11"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="Close_Click"/>
            </Grid>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}"
                    Padding="8">
                <Image Source="/Assets/wechat-qr.jpg"
                       Width="252" Height="358"
                       Stretch="Uniform"/>
            </Border>

            <TextBlock x:Name="WeChatIdText"
                       Text="微信号：jiaxindeyang"
                       FontSize="12"
                       FontFamily="{StaticResource FontMono}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,14,0,2"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="仅接受合作/反馈"
                       FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,0,0,14"
                       HorizontalAlignment="Center"/>
            <Button Content="复制微信号"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="132"
                    HorizontalAlignment="Center"
                    Click="CopyWeChat_Click"/>
        </StackPanel>
    </Border>
</Window>
