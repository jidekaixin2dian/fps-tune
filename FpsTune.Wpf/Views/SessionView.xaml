<UserControl x:Class="FpsTune.Wpf.Views.SessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str.NavSession}" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="{DynamicResource Str.SessionIntro}"
                           Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                    <Expander x:Name="GettingStarted" Header="{DynamicResource Str.SessionGuideTitle}" IsExpanded="True" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14">
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="{DynamicResource Str.SessionGuideSteps}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="23"/>
                            <TextBlock Text="{DynamicResource Str.SessionChartGuide}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="22"/>
                        </StackPanel>
                    </Expander>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 采样控制 -->
        <Border x:Name="SamplingCard" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str.SamplingControl}" Style="{StaticResource CardTitleStyle}"/>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SessionNameBox"
                             Style="{StaticResource InputTextBoxStyle}"
                             VerticalContentAlignment="Center"
                             MaxLength="60"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                        <Button x:Name="StartButton" Content="{DynamicResource Str.StartSession}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="110" Margin="0,0,8,0"
                                Click="Start_Click"/>
                        <Button x:Name="StopButton" Content="{DynamicResource Str.StopAndSave}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="110" Margin="0,0,8,0" IsEnabled="False"
                                Click="Stop_Click"/>
                        <Button x:Name="CancelButton" Content="{DynamicResource Str.Cancel}"
                                Style="{StaticResource GhostButtonStyle}"
                                MinWidth="64" IsEnabled="False"
                                Click="Cancel_Click"/>
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="ConditionsPanel" Margin="0,14,0,0">
                    <TextBlock Text="{DynamicResource Str.ConditionTitle}" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="ConditionGameText" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,6"/>
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource Str.ConditionResolution}" Style="{StaticResource MutedTextStyle}"/>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ResolutionWidthBox" MaxLength="5" Style="{StaticResource InputTextBoxStyle}"/>
                                <TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBox x:Name="ResolutionHeightBox" Grid.Column="2" MaxLength="5" Style="{StaticResource InputTextBoxStyle}"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource Str.ConditionQuality}" Style="{StaticResource MutedTextStyle}"/>
                            <TextBox x:Name="QualityBox" MaxLength="120" Margin="0,5,0,0" Style="{StaticResource InputTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.ConditionScene}" Style="{StaticResource MutedTextStyle}"/>
                            <TextBox x:Name="SceneBox" MaxLength="160" Margin="0,5,0,0" Style="{StaticResource InputTextBoxStyle}"/>
                        </StackPanel>
                    </UniformGrid>
                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock Text="{DynamicResource Str.ConditionTarget}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TargetSecondsBox" Text="60" Width="80" MaxLength="5" Style="{StaticResource InputTextBoxStyle}"/>
                        <Button x:Name="ReuseConditionsButton" Content="{DynamicResource Str.ConditionReuse}" Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0" Click="ReuseConditions_Click"/>
                    </WrapPanel>
                    <TextBlock Text="{DynamicResource Str.ConditionInputHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0"/>
                </StackPanel>
                <TextBlock x:Name="RunStateText"
                           Text="{DynamicResource Str.SessionReady}"
                           Style="{StaticResource MutedTextStyle}" FontSize="13" TextWrapping="Wrap"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- 实时指标：发丝分隔通栏 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="14,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="CPU" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock x:Name="CpuNowText" Text="--" Style="{StaticResource StatValueStyle}"
                                       FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Canvas x:Name="CpuChart" Height="60" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="14,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{DynamicResource Str.Memory}" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock x:Name="MemNowText" Text="--" Style="{StaticResource StatValueStyle}"
                                       FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Canvas x:Name="MemChart" Height="60" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="14,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="GPU" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock x:Name="GpuNowText" Text="--" Style="{StaticResource StatValueStyle}"
                                       FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Canvas x:Name="GpuChart" Height="60" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Padding="14,12" ToolTipService.ShowOnDisabled="True">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{DynamicResource Str.VramDedicatedShort}" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock x:Name="VramNowText" Text="--" Style="{StaticResource StatValueStyle}"
                                       FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Canvas x:Name="VramChart" Height="60" Margin="0,8,0,0"/>
                        <TextBlock x:Name="VramTotalText" Text="" Style="{StaticResource MutedTextStyle}" FontSize="13"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 性能洞察 -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str.PerformanceInsights}" Style="{StaticResource CardTitleStyle}"/>
                <TextBlock x:Name="InsightTargetText" Text="{DynamicResource Str.SelectSessionHint}"
                           Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"/>
                <ItemsControl x:Name="InsightList" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6"
                                    Padding="12,9"
                                    CornerRadius="{StaticResource RadiusControl}"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource OkBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="attention">
                                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Title}" FontWeight="{StaticResource SmallEmphasisWeight}" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding KindLabel}" FontSize="13" Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="15,6,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding WindowText}" FontSize="13" Margin="15,4,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 历史会话 -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="14,14,4,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,10,10">
                    <TextBlock Text="{DynamicResource Str.HistorySessions}" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="{DynamicResource Str.Refresh}" Style="{StaticResource GhostButtonStyle}"
                                MinWidth="56" Margin="0,0,8,0" Click="Refresh_Click"/>
                        <Button x:Name="ExportJsonButton" Content="{DynamicResource Str.ExportJson}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="92" Margin="0,0,8,0" IsEnabled="False" Click="ExportJson_Click"/>
                        <Button x:Name="ExportCsvButton" Content="{DynamicResource Str.ExportCsv}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="92" Margin="0,0,8,0" IsEnabled="False" Click="ExportCsv_Click"/>
                        <Button x:Name="DeleteButton" Content="{DynamicResource Str.DeleteSelected}"
                                Style="{StaticResource GhostButtonStyle}"
                                MinWidth="76" IsEnabled="False" Click="Delete_Click"/>
                    </StackPanel>
                </Grid>
                <ListBox x:Name="HistoryList" Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource CardListItemStyle}"
                         MaxHeight="220"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="HistoryList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="{StaticResource SmallEmphasisWeight}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding MetaText}" FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding AvgText}" FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="HistoryEmptyText" Grid.Row="1"
                           Text="{DynamicResource Str.NoSessionsYet}"
                           FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,18,0,18" TextWrapping="Wrap" MaxWidth="460"
                           TextAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 并排比较 -->
        <Border x:Name="ComparisonCard" Grid.Row="5" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str.SessionCompare}" Style="{StaticResource CardTitleStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <ComboBox x:Name="CompareA" Style="{StaticResource SelectComboBoxStyle}"
                              MinHeight="34" Width="240" MaxWidth="240" Margin="0,0,10,0"
                              SelectionChanged="Compare_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox x:Name="CompareB" Style="{StaticResource SelectComboBoxStyle}"
                              MinHeight="34" Width="240" MaxWidth="240"
                              SelectionChanged="Compare_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <TextBlock x:Name="CompareHint" Text="{DynamicResource Str.SelectTwoSessions}" Style="{StaticResource MutedTextStyle}" FontSize="13" Margin="0,8,0,0"/>
                <TextBlock x:Name="CompareConditionsText" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,8,0,10" Visibility="Collapsed"/>
                <!-- 表头：四列含义不再依赖上方提示文本反推 -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str.CompareHeaderMetric}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Grid.Column="1" Text="{DynamicResource Str.CompareHeaderSessionA}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource Str.CompareHeaderSessionB}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Grid.Column="3" Text="{DynamicResource Str.CompareHeaderDelta}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                </Grid>
                <ItemsControl x:Name="CompareRows" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Metric}" FontWeight="{StaticResource SmallEmphasisWeight}" FontSize="13"
                                           TextWrapping="Wrap" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding AVal}" FontSize="13" FontFamily="{StaticResource FontBody}"
                                           TextWrapping="Wrap" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding BVal}" FontSize="13" FontFamily="{StaticResource FontBody}"
                                           TextWrapping="Wrap" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="{Binding Delta}" FontSize="13" FontFamily="{StaticResource FontBody}"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
