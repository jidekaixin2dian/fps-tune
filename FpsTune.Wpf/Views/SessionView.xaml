<UserControl x:Class="FpsTune.Wpf.Views.SessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FpsTune.Wpf.Views.Controls"
             Background="{DynamicResource AppBackgroundBrush}">
    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="32,26,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource Str.NavSession}" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="{DynamicResource Str.SessionIntro}"
                           Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
                <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                    <Expander x:Name="GettingStarted" Header="{DynamicResource Str.SessionGuideTitle}" IsExpanded="True" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14">
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="{DynamicResource Str.SessionGuideSteps}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="23"/>
                            <TextBlock Text="{DynamicResource Str.SessionChartGuide}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="22"/>
                        </StackPanel>
                    </Expander>
                </Border>
        </Grid>

        <!-- 采样控制 -->
        <Border x:Name="SamplingCard" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str.SamplingControl}" Style="{StaticResource CardTitleStyle}"/>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SessionNameBox"
                             Style="{StaticResource InputTextBoxStyle}"
                             AutomationProperties.Name="{DynamicResource Str.SessionName}"
                             VerticalContentAlignment="Center"
                             MaxLength="60"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                        <Button x:Name="StartButton" Content="{DynamicResource Str.StartSession}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="110" Margin="0,0,8,0"
                                Click="Start_Click"/>
                        <Button x:Name="StopButton" Content="{DynamicResource Str.StopAndSave}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="110" Margin="0,0,8,0" IsEnabled="False"
                                Click="Stop_Click"/>
                        <Button x:Name="CancelButton" Content="{DynamicResource Str.Cancel}"
                                Style="{StaticResource GhostButtonStyle}"
                                MinWidth="64" IsEnabled="False"
                                Click="Cancel_Click"/>
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="ConditionsPanel" Margin="0,18,0,0">
                    <TextBlock Text="{DynamicResource Str.ConditionTitle}" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="ConditionGameText" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,6"/>
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource Str.ConditionResolution}" Style="{StaticResource MutedTextStyle}"/>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ResolutionWidthBox" MaxLength="5" Style="{StaticResource InputTextBoxStyle}"
                                         AutomationProperties.Name="{DynamicResource Str.ConditionResolutionWidth}"/>
                                <TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBox x:Name="ResolutionHeightBox" Grid.Column="2" MaxLength="5" Style="{StaticResource InputTextBoxStyle}"
                                         AutomationProperties.Name="{DynamicResource Str.ConditionResolutionHeight}"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource Str.ConditionQuality}" Style="{StaticResource MutedTextStyle}"/>
                            <TextBox x:Name="QualityBox" MaxLength="120" Margin="0,5,0,0" Style="{StaticResource InputTextBoxStyle}"
                                     AutomationProperties.Name="{DynamicResource Str.ConditionQuality}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.ConditionScene}" Style="{StaticResource MutedTextStyle}"/>
                            <TextBox x:Name="SceneBox" MaxLength="160" Margin="0,5,0,0" Style="{StaticResource InputTextBoxStyle}"
                                     AutomationProperties.Name="{DynamicResource Str.ConditionScene}"/>
                        </StackPanel>
                    </UniformGrid>
                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock Text="{DynamicResource Str.ConditionTarget}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TargetSecondsBox" Text="60" Width="80" MaxLength="5" Style="{StaticResource InputTextBoxStyle}"
                                 AutomationProperties.Name="{DynamicResource Str.ConditionTarget}"/>
                        <Button x:Name="ReuseConditionsButton" Content="{DynamicResource Str.ConditionReuse}" Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0" Click="ReuseConditions_Click"/>
                    </WrapPanel>
                    <TextBlock Text="{DynamicResource Str.ConditionInputHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0"/>
                    <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="SaveTemplateButton" Content="{DynamicResource Str.SessionTemplateSave}" Style="{StaticResource SecondaryButtonStyle}" Click="SaveTemplate_Click" Margin="0,0,8,6" controls:UiMotion.Character="Spring"/>
                        <Button x:Name="LoadTemplateButton" Content="{DynamicResource Str.SessionTemplateLoad}" Style="{StaticResource SecondaryButtonStyle}" Click="LoadTemplate_Click" Margin="0,0,8,6"/>
                        <Button x:Name="DeleteTemplateButton" Content="{DynamicResource Str.SessionTemplateDelete}" Style="{StaticResource GhostButtonStyle}" Click="DeleteTemplate_Click" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <TextBlock Text="{DynamicResource Str.SessionTemplateHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" FontSize="13"/>
                    <TextBlock x:Name="TemplateStatus" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <TextBlock x:Name="RunStateText"
                           Text="{DynamicResource Str.SessionReady}"
                           Style="{StaticResource MutedTextStyle}" FontSize="13" TextWrapping="Wrap"
                           Margin="0,10,0,0"/>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0"><StackPanel>
                    <Expander x:Name="AutoRecordOptions" Header="{DynamicResource Str.AutoRecordTitle}" Margin="0,18,0,0"><StackPanel Margin="0,10,0,0">
                        <TextBlock Text="{DynamicResource Str.AutoRecordHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        <CheckBox x:Name="AutoRecordEnabled" Content="{DynamicResource Str.AutoRecordEnable}" Margin="0,12,0,8"/>
                        <ItemsControl x:Name="AutoRecordGames"><ItemsControl.ItemTemplate><DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Margin="0,6"><StackPanel>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
                                <controls:FileNameLabel Text="{Binding Path}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" MaxWidth="680" HorizontalAlignment="Left"/>
                            </StackPanel></CheckBox>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock x:Name="AutoRecordEmpty" Text="{DynamicResource Str.AutoRecordEmpty}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,16,0,0">
                            <Button x:Name="AutoRecordSave" Content="{DynamicResource Str.Save}" Style="{StaticResource SecondaryButtonStyle}" Click="AutoRecordSave_Click" Margin="0,0,8,0"/>
                            <Button Content="{DynamicResource Str.AutoRecordRefresh}" Style="{StaticResource GhostButtonStyle}" Click="AutoGamesRefresh_Click"/>
                        </WrapPanel>
                    </StackPanel></Expander>
                    <TextBlock x:Name="AutoRecordStatus" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel></Border>
            </StackPanel>
        </Border>

        <!-- 实时指标：发丝分隔通栏 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="14,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="CPU" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock x:Name="CpuNowText" Text="--" Style="{StaticResource StatValueStyle}"
                                       FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Canvas x:Name="CpuChart" Height="60" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="14,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{DynamicResource Str.Memory}" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock x:Name="MemNowText" Text="--" Style="{StaticResource StatValueStyle}"
                                       FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Canvas x:Name="MemChart" Height="60" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="14,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="GPU" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock x:Name="GpuNowText" Text="--" Style="{StaticResource StatValueStyle}"
                                       FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Canvas x:Name="GpuChart" Height="60" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Padding="14,12" ToolTipService.ShowOnDisabled="True">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{DynamicResource Str.VramDedicatedShort}" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock x:Name="VramNowText" Text="--" Style="{StaticResource StatValueStyle}"
                                       FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Canvas x:Name="VramChart" Height="60" Margin="0,8,0,0"/>
                        <TextBlock x:Name="VramTotalText" Text="" Style="{StaticResource MutedTextStyle}" FontSize="13"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 性能洞察 -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str.PerformanceInsights}" Style="{StaticResource CardTitleStyle}"/>
                <TextBlock x:Name="InsightTargetText" Text="{DynamicResource Str.SelectSessionHint}"
                           Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"/>
                <ItemsControl x:Name="InsightList" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6"
                                    Padding="12,9"
                                    CornerRadius="{DynamicResource RadiusControl}"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource OkBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="attention">
                                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Title}" FontWeight="{DynamicResource SmallEmphasisWeight}" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding KindLabel}" FontSize="13" Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="15,6,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding WindowText}" FontSize="13" Margin="15,4,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 历史会话 -->
        <Border x:Name="HistoryCard" Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,0,0,20" Padding="14,14,4,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,10,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CompareSelectedButton" Content="{DynamicResource Str.ComparisonSelected}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" IsEnabled="False" Click="CompareSelected_Click"/>
                        <Button Content="{DynamicResource Str.Refresh}" Style="{StaticResource GhostButtonStyle}"
                                MinWidth="56" Margin="0,0,8,0" Click="Refresh_Click"/>
                        <Button x:Name="ExportJsonButton" Content="{DynamicResource Str.ExportJson}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="92" Margin="0,0,8,0" IsEnabled="False" Click="ExportJson_Click"/>
                        <Button x:Name="ExportCsvButton" Content="{DynamicResource Str.ExportCsv}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="92" Margin="0,0,8,0" IsEnabled="False" Click="ExportCsv_Click"/>
                        <Button x:Name="DeleteButton" Content="{DynamicResource Str.DeleteSelected}"
                                Style="{StaticResource GhostButtonStyle}"
                                MinWidth="76" IsEnabled="False" Click="Delete_Click"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{DynamicResource Str.HistorySessions}" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                        <TextBlock Text="{DynamicResource Str.SessionHistoryRetention}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,0,10,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource Str.SessionHistorySearch}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,5"/>
                        <TextBox x:Name="HistorySearchBox" Style="{StaticResource InputTextBoxStyle}" MaxLength="160" TextChanged="HistorySearch_Changed" AutomationProperties.Name="{DynamicResource Str.SessionHistorySearch}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource Str.ConditionGame}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="HistoryGameFilter" Style="{StaticResource SelectComboBoxStyle}" Height="{Binding ActualHeight, ElementName=HistorySearchBox}" DisplayMemberPath="Label" SelectionChanged="HistoryFilter_Changed" AutomationProperties.Name="{DynamicResource Str.ConditionGame}"/>
                    </StackPanel>
                </Grid>
                <DockPanel Grid.Row="2" Margin="0,0,10,10" LastChildFill="False">
                    <TextBlock x:Name="HistoryCountText" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" DockPanel.Dock="Right" AutomationProperties.LiveSetting="Polite"/>
                    <CheckBox x:Name="HistoryFpsOnly" Content="{DynamicResource Str.SessionHistoryFpsOnly}" VerticalAlignment="Center" Checked="HistoryFilter_Changed" Unchecked="HistoryFilter_Changed" Margin="0,0,12,0"/>
                    <Button Content="{DynamicResource Str.SessionHistoryReset}" x:Name="ResetHistoryFiltersButton" Style="{StaticResource GhostButtonStyle}" Click="ResetHistoryFilters_Click"/>
                </DockPanel>
                <ListBox x:Name="HistoryList" Grid.Row="3" SelectionMode="Extended"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource CardListItemStyle}"
                         MaxHeight="220"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="HistoryList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" FontWeight="{DynamicResource SmallEmphasisWeight}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding MetaText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding MetaText}" FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding AvgText}" FontSize="13" MaxWidth="300" TextWrapping="Wrap" Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="HistoryEmptyText" Grid.Row="3"
                           Text="{DynamicResource Str.NoSessionsYet}"
                           FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,18,0,18" TextWrapping="Wrap" MaxWidth="460"
                           TextAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 并排比较 -->
        <Border x:Name="ComparisonCard" Grid.Row="5" Style="{StaticResource CardStyle}">
            <StackPanel>
                <DockPanel Margin="0,0,0,20">
                    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button x:Name="SwapComparisonButton" Content="{DynamicResource Str.ComparisonSwap}" Style="{StaticResource GhostButtonStyle}" Click="SwapComparison_Click" IsEnabled="False" Margin="0,0,8,0"/>
                        <Button x:Name="ExportComparisonButton" Content="{DynamicResource Str.ComparisonExport}" Style="{StaticResource SecondaryButtonStyle}" Click="ExportComparison_Click" IsEnabled="False"/>
                    </WrapPanel>
                    <TextBlock Text="{DynamicResource Str.SessionCompare}" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="{DynamicResource Str.ComparisonSelectionHint}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,2,0,0">
                    <StackPanel Margin="0,0,12,8"><TextBlock Text="{DynamicResource Str.ComparisonBaseline}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CompareA" Style="{StaticResource SelectComboBoxStyle}"
                              MinHeight="34" Width="240" MaxWidth="240" AutomationProperties.Name="{DynamicResource Str.ComparisonBaseline}"
                              SelectionChanged="Compare_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    </StackPanel><StackPanel Margin="0,0,0,8"><TextBlock Text="{DynamicResource Str.ComparisonCandidate}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CompareB" Style="{StaticResource SelectComboBoxStyle}"
                              MinHeight="34" Width="240" MaxWidth="240" AutomationProperties.Name="{DynamicResource Str.ComparisonCandidate}"
                              SelectionChanged="Compare_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    </StackPanel>
                </WrapPanel>
                <TextBlock x:Name="CompareHint" Text="{DynamicResource Str.SelectTwoSessions}" Style="{StaticResource MutedTextStyle}" FontSize="13" Margin="0,8,0,0"/>
                <TextBlock x:Name="CompareConditionsText" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,8,0,10" Visibility="Collapsed"/>
                <TextBlock x:Name="ComparisonExportStatus" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <ItemsControl x:Name="CompareHighlights" Margin="0,12,0,8">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Metric}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                                <TextBlock Text="{Binding Delta}" FontSize="22" FontWeight="{DynamicResource SmallEmphasisWeight}" Margin="0,8,0,0" TextWrapping="Wrap">
                                    <TextBlock.Style><Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Trend}" Value="good"><Setter Property="Foreground" Value="{DynamicResource OkBrush}"/></DataTrigger><DataTrigger Binding="{Binding Trend}" Value="attention"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,3,0,12" TextWrapping="Wrap"><Run Text="{DynamicResource Str.ComparisonRelativeShort}"/><Run Text="{Binding Relative, Mode=OneWay}"/></TextBlock>
                                <DockPanel><TextBlock Text="A" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding AVal}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="13"/></DockPanel>
                                <ProgressBar Style="{StaticResource ThinMeterStyle}" Maximum="{Binding Maximum}" Value="{Binding AChartValue}" Foreground="{DynamicResource ChartSecondaryBrush}" Margin="0,6,0,10"/>
                                <DockPanel><TextBlock Text="B" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding BVal}" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="13"/></DockPanel>
                                <ProgressBar Style="{StaticResource ThinMeterStyle}" Maximum="{Binding Maximum}" Value="{Binding BChartValue}" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- 表头：四列含义不再依赖上方提示文本反推 -->
                <Expander x:Name="ComparisonDetails" Header="{DynamicResource Str.ComparisonDetails}" Margin="0,8,0,0"><StackPanel>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str.CompareHeaderMetric}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Grid.Column="1" Text="{DynamicResource Str.CompareHeaderSessionA}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource Str.CompareHeaderSessionB}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Grid.Column="3" Text="{DynamicResource Str.CompareHeaderDelta}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                </Grid>
                <ItemsControl x:Name="CompareRows" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Metric}" FontWeight="{DynamicResource SmallEmphasisWeight}" FontSize="13"
                                           TextWrapping="Wrap" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding AVal}" FontSize="13" FontFamily="{StaticResource FontBody}"
                                           TextWrapping="Wrap" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding BVal}" FontSize="13" FontFamily="{StaticResource FontBody}"
                                           TextWrapping="Wrap" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="{Binding Delta}" FontSize="13" FontFamily="{StaticResource FontBody}"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel></Expander>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
