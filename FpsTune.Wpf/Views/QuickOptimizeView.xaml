<UserControl x:Class="FpsTune.Wpf.Views.QuickOptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}"
             FontFamily="{StaticResource FontBody}">
    <Grid Margin="32,26,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{DynamicResource Str.QuickOptTitle}" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="{DynamicResource Str.QuickOptIntro}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 卡 1：选择 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="24,20" Margin="0,0,0,20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str.QuickOptGameLabel}" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="GameBox" MinWidth="320" Height="36" HorizontalAlignment="Left"
                              Style="{StaticResource SelectComboBoxStyle}" AutomationProperties.Name="{DynamicResource Str.QuickOptGameLabel}"
                              SelectionChanged="GameBox_SelectionChanged">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" ToolTip="{Binding ExePath}"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str.QuickOptPlanLabel}" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center"/>
                    <!-- 方案改成下拉：一排七个单选太吵，方案内容是固定的，选一个就够。 -->
                    <ComboBox Grid.Column="1" x:Name="PlanBox" MinWidth="320" Height="36" HorizontalAlignment="Left"
                              Style="{StaticResource SelectComboBoxStyle}" AutomationProperties.Name="{DynamicResource Str.QuickOptPlanLabel}"
                              SelectionChanged="Plan_Changed"/>
                </Grid>
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str.QuickOptPowerLabel}" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" x:Name="PowerCheck" Content="{DynamicResource Str.QuickOptPowerToggle}" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str.QuickOptResolutionLabel}" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="ResolutionBox" MinWidth="320" Height="36" HorizontalAlignment="Left"
                              Style="{StaticResource SelectComboBoxStyle}" AutomationProperties.Name="{DynamicResource Str.QuickOptResolutionLabel}"/>
                </Grid>
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str.QuickOptDlssLabel}" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="DlssBox" MinWidth="320" Height="36" HorizontalAlignment="Left"
                              Style="{StaticResource SelectComboBoxStyle}" AutomationProperties.Name="{DynamicResource Str.QuickOptDlssLabel}"/>
                </Grid>
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str.QuickOptFilterLabel}" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="FilterBox" MinWidth="320" Height="36" HorizontalAlignment="Left"
                              Style="{StaticResource SelectComboBoxStyle}" AutomationProperties.Name="{DynamicResource Str.QuickOptFilterLabel}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button x:Name="RunButton" Content="{DynamicResource Str.QuickOptRun}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="140" Height="40" Click="Run_Click"/>
                    <TextBlock x:Name="RunStatus" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 方案预览：选了哪些项目、还会附带做什么，一眼看清再点开始 -->
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusControl}" Padding="16,14" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.QuickOptPlanPreviewTitle}" Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="{DynamicResource SmallEmphasisWeight}" FontSize="14"/>
                        <TextBlock x:Name="PlanPreviewText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock x:Name="PlanPreviewExtras" Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 卡 2：执行结果 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" Visibility="Collapsed" x:Name="ResultCard">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="18,14,18,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str.QuickOptDoneTitle}" Style="{StaticResource CardTitleStyle}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SummaryText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{DynamicResource Str.QuickOptBackupHint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Right"/>
                </Grid>
                <ListBox x:Name="ResultList" Grid.Row="1" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionMode="Single">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardListItemStyle}">
                            <Setter Property="Padding" Value="18,11"/>
                            <Setter Property="MinHeight" Value="48"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AccentBrush}" Style="{StaticResource ItemTitleStyle}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="13" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Ok}" Value="True"><Setter Property="Foreground" Value="{DynamicResource OkBrush}"/></DataTrigger><DataTrigger Binding="{Binding Ok}" Value="False"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
