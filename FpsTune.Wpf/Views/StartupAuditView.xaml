<UserControl x:Class="FpsTune.Wpf.Views.StartupAuditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="32,26,32,28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource Str.StartupAuditTitle}" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="{DynamicResource Str.StartupIntro}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock x:Name="AuditStatus" Style="{StaticResource MutedTextStyle}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="{DynamicResource Str.StartupRefresh}" Style="{StaticResource SecondaryButtonStyle}"
                    Click="Refresh_Click" VerticalAlignment="Top" Margin="20,0,0,0"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,14,0">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{DynamicResource Str.StartupItemsTitle}" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                                <TextBlock Text="{DynamicResource Str.StartupItemsHint}" Style="{StaticResource MutedTextStyle}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button x:Name="OpenStartupSettings" Tag="startup" Content="{DynamicResource Str.StartupOpenSettings}" Style="{StaticResource GhostButtonStyle}"
                                        Click="OpenSystemTool_Click" Margin="0,0,8,0"/>
                                <Button x:Name="OpenTaskManager" Tag="taskmanager" Content="{DynamicResource Str.StartupOpenTaskManager}" Style="{StaticResource GhostButtonStyle}"
                                        Click="OpenSystemTool_Click"/>
                            </WrapPanel>
                        </DockPanel>
                        <WrapPanel Margin="0,14,0,0">
                            <RadioButton x:Name="FilterAll" Content="{DynamicResource Str.StartupFilterAll}" GroupName="startupFilter" Tag="all"
                                         Style="{StaticResource PillRadioStyle}" IsChecked="True" Checked="StartupFilter_Changed" Margin="0,0,8,8"/>
                            <RadioButton Content="{DynamicResource Str.StartupCategoryGame}" GroupName="startupFilter" Tag="Game"
                                         Style="{StaticResource PillRadioStyle}" Checked="StartupFilter_Changed" Margin="0,0,8,8"/>
                            <RadioButton Content="{DynamicResource Str.StartupCategoryAccelerator}" GroupName="startupFilter" Tag="Accelerator"
                                         Style="{StaticResource PillRadioStyle}" Checked="StartupFilter_Changed" Margin="0,0,8,8"/>
                            <RadioButton Content="{DynamicResource Str.StartupCategoryCloud}" GroupName="startupFilter" Tag="Cloud"
                                         Style="{StaticResource PillRadioStyle}" Checked="StartupFilter_Changed" Margin="0,0,8,8"/>
                            <RadioButton Content="{DynamicResource Str.StartupCategoryPeripheral}" GroupName="startupFilter" Tag="Peripheral"
                                         Style="{StaticResource PillRadioStyle}" Checked="StartupFilter_Changed" Margin="0,0,8,8"/>
                            <RadioButton Content="{DynamicResource Str.StartupCategorySecurity}" GroupName="startupFilter" Tag="Security"
                                         Style="{StaticResource PillRadioStyle}" Checked="StartupFilter_Changed" Margin="0,0,8,8"/>
                            <RadioButton Content="{DynamicResource Str.StartupCategoryMedia}" GroupName="startupFilter" Tag="Media"
                                         Style="{StaticResource PillRadioStyle}" Checked="StartupFilter_Changed" Margin="0,0,8,8"/>
                            <RadioButton Content="{DynamicResource Str.StartupCategoryUpdater}" GroupName="startupFilter" Tag="Updater"
                                         Style="{StaticResource PillRadioStyle}" Checked="StartupFilter_Changed" Margin="0,0,8,8"/>
                            <RadioButton Content="{DynamicResource Str.StartupCategoryOther}" GroupName="startupFilter" Tag="Other"
                                         Style="{StaticResource PillRadioStyle}" Checked="StartupFilter_Changed" Margin="0,0,8,8"/>
                            <CheckBox x:Name="OnlySuggested" Content="{DynamicResource Str.StartupFilterSuggested}" Foreground="{DynamicResource TextSecondaryBrush}"
                                      VerticalAlignment="Center" Margin="6,0,0,8" Checked="StartupFilter_Changed" Unchecked="StartupFilter_Changed"/>
                        </WrapPanel>
                        <ItemsControl x:Name="StartupItems" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="{DynamicResource RadiusControl}" Padding="14,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <WrapPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="{DynamicResource SmallEmphasisWeight}" TextWrapping="Wrap"/>
                                                    <Border Style="{StaticResource ChipStyle}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource ChipStyle}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding State}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding Advice}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                <TextBlock Text="{Binding Source}" Style="{StaticResource MutedTextStyle}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                <TextBlock Text="{Binding Command}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding Note}" Foreground="{DynamicResource WarningBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                                                           Visibility="{Binding NoteVisibility}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Tag="{Binding Id}" Content="{Binding Action}" Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="StartupToggle_Click" IsEnabled="{Binding CanToggle}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="StartupEmpty" Text="{DynamicResource Str.StartupItemsEmpty}" Style="{StaticResource MutedTextStyle}" Visibility="Collapsed"/>
                        <TextBlock x:Name="StartupStatus" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{DynamicResource Str.StartupServicesTitle}" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                                <TextBlock Text="{DynamicResource Str.StartupServicesHint}" Style="{StaticResource MutedTextStyle}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Button x:Name="OpenServicesConsole" DockPanel.Dock="Right" Tag="services" Content="{DynamicResource Str.StartupOpenServices}"
                                    Style="{StaticResource GhostButtonStyle}" Click="OpenSystemTool_Click" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <ItemsControl x:Name="ServiceGroups" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="{DynamicResource SmallEmphasisWeight}" Margin="0,4,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="{DynamicResource RadiusControl}" Padding="14,12" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <CheckBox Tag="{Binding Id}" IsChecked="{Binding Selected, Mode=OneWay}" Visibility="{Binding SelectableVisibility}"
                                                                      VerticalAlignment="Top" Margin="0,2,12,0" Checked="ServiceSelect_Changed" Unchecked="ServiceSelect_Changed"
                                                                      AutomationProperties.Name="{Binding Label}"/>
                                                            <!-- 没有优化项的行不能勾选：同一列放建议图标，别留一个空档 -->
                                                            <Path Tag="AdviceIcon" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,12,0"
                                                                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  Visibility="{Binding IconVisibility}" ToolTip="{Binding Advice}"
                                                                  AutomationProperties.Name="{Binding Advice}">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Data" Value="M12 3a9 9 0 1 0 0 18 9 9 0 1 0 0-18 M8 12h8"/>
                                                                        <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding AdviceKind}" Value="Close">
                                                                                <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding AdviceKind}" Value="Optional">
                                                                                <Setter Property="Data" Value="M12 3a9 9 0 1 0 0 18 9 9 0 1 0 0-18 M9.6 9.4a2.6 2.6 0 1 1 3.4 2.5c-.7.3-1 .9-1 1.6 M12 17h.01"/>
                                                                                <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding AdviceKind}" Value="Keep">
                                                                                <Setter Property="Data" Value="M12 3a9 9 0 1 0 0 18 9 9 0 1 0 0-18 M8.5 12.2l2.4 2.4 4.6-4.8"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                            <StackPanel Grid.Column="1">
                                                                <WrapPanel>
                                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="{DynamicResource SmallEmphasisWeight}" TextWrapping="Wrap"/>
                                                                    <Border Style="{StaticResource ChipStyle}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Advice}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding ServiceName}" Style="{StaticResource MutedTextStyle}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                                </WrapPanel>
                                                                <TextBlock Text="{Binding Reason}" Style="{StaticResource MutedTextStyle}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,2,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="ServiceEmpty" Text="{DynamicResource Str.StartupServicesEmpty}" Style="{StaticResource MutedTextStyle}" Visibility="Collapsed"/>
                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="ReviewButton" Content="{DynamicResource Str.StartupReviewNone}" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="Review_Click" IsEnabled="False" Margin="0,0,10,8"/>
                            <Button x:Name="ServicesRefreshButton" Content="{DynamicResource Str.StartupRefreshServices}" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="RefreshServices_Click" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <TextBlock x:Name="ServiceStatus" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
