<Window x:Class="FpsTune.Wpf.Views.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.AppName}" Style="{StaticResource WindowTypographyStyle}"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource FontBody}">
    <Border Margin="18"
            Background="{DynamicResource AppBackdropBrush}"
            BorderBrush="{DynamicResource BorderHoverBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusCard}"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22"
                              ShadowDepth="4"
                              Opacity="0.2"
                              Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="StatusIconSurface" Grid.Column="0"
                        Width="38" Height="38"
                        CornerRadius="19"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Path x:Name="IconPath" Data="M 10,2 A 8,8 0 1 0 10,18 A 8,8 0 1 0 10,2 M 10,8 V 14 M 10,5 L 10,5.1" Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleTextBlock"
                               Text="{DynamicResource Str.Prompt}"
                               FontSize="18"
                               FontWeight="{StaticResource SmallEmphasisWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SubTextBlock"
                               Text="{DynamicResource Str.AppName}"
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0"><TextBlock x:Name="MessageTextBlock"
                       Text=""
                       FontSize="14"
                       LineHeight="24"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,6,0"/></ScrollViewer>

            <DockPanel LastChildFill="True" Margin="0,22,0,0"><Button x:Name="CopyDetailsButton" Content="{DynamicResource Str.ErrorCopyDetails}" Style="{StaticResource GhostButtonStyle}" Visibility="Collapsed" DockPanel.Dock="Left" VerticalAlignment="Center" Click="CopyDetails_Click"/>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="12,0,0,0">
                <Button x:Name="CancelButton"
                        Content="{DynamicResource Str.Cancel}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="88"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>
                <Button x:Name="ConfirmButton"
                        Content="{DynamicResource Str.Ok}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="88"
                        Click="ConfirmButton_Click"/>
            </StackPanel></DockPanel>
        </StackPanel>
    </Border>
</Window>
