<UserControl x:Class="FpsTune.Wpf.Views.FilterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:FpsTune.Wpf.Views"
    Background="{DynamicResource AppBackgroundBrush}" FontFamily="{StaticResource FontBody}">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Str.NavFilters}" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="{DynamicResource Str.FilterPageIntro}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <views:FilterCenterPanel/>
                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><StackPanel>
                    <TextBlock Text="{DynamicResource Str.DeltaFixTab}" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Str.DeltaFixIntro}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <Button Content="{DynamicResource Str.DeltaFixOpen}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenDeltaFix_Click"/>
                </StackPanel></Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
