<UserControl x:Class="FpsTune.Wpf.Views.FilterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:FpsTune.Wpf.Views"
    xmlns:controls="clr-namespace:FpsTune.Wpf.Views.Controls"
    Background="{DynamicResource AppBackgroundBrush}" FontFamily="{StaticResource FontBody}">
    <Grid Margin="32,26,32,28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource Str.NavFilters}" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="{DynamicResource Str.FilterPageIntro}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                <RadioButton x:Name="ModeScreen" GroupName="filterWorkspaceMode" Style="{StaticResource ChoiceTabStyle}"
                             Content="{DynamicResource Str.FilterModeScreen}" IsChecked="True" Checked="Mode_Changed" Margin="0,0,8,0"/>
                <RadioButton x:Name="ModePerApp" GroupName="filterWorkspaceMode" Style="{StaticResource ChoiceTabStyle}"
                             Content="{DynamicResource Str.FilterModePerApp}" Checked="Mode_Changed"/>
            </WrapPanel>
        </Grid>

        <!-- 目标显示器与当前游戏是整页上下文；切换应用范围不丢失它。 -->
        <Border x:Name="CardDisplayTarget" Grid.Row="1" Style="{StaticResource CardStyle}" Padding="24,20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="360"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Str.DisplayTarget}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox x:Name="DisplayTargetCombo" Grid.Column="1" DisplayMemberPath="Label" Style="{StaticResource SelectComboBoxStyle}"
                          AutomationProperties.Name="{DynamicResource Str.DisplayTarget}" SelectionChanged="DisplayTarget_Changed"/>
                <Button x:Name="DisplayRefreshButton" Grid.Column="2" Content="{DynamicResource Str.DisplayRefresh}" Margin="10,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}" Click="DisplayRefresh_Click"/>
                <TextBlock x:Name="DisplayTargetState" Grid.Column="3" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <views:ScreenColorPanel x:Name="ColorPanel" Grid.Row="2" VerticalAlignment="Stretch"/>

        <!-- 不参与布局的控件宿主：初始化后把滤镜、振动、ICC、自动化搬进统一工作区。
             保留在页面 namescope 内，避免事件处理与现有代码失去关联。 -->
        <Grid x:Name="HiddenHost" Visibility="Collapsed">
            <views:FilterCenterPanel x:Name="FilterCenter"/>
            <views:PerAppFilterPanel x:Name="PerAppCenter"/>

            <StackPanel x:Name="VibranceContent">
                <StackPanel x:Name="VibSupportedPanel" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Str.VibNote}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                    <Grid Margin="0,14,0,0" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="VibPercentText" Text="—"
                                   FontFamily="{StaticResource FontStat}" Typography.NumeralAlignment="Tabular" FontSize="26" FontWeight="{DynamicResource StrongEmphasisWeight}"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" MinWidth="64"/>
                        <Slider Grid.Column="1" x:Name="VibSlider" Minimum="0" Maximum="100" TickFrequency="5"
                                IsSnapToTickEnabled="False" ValueChanged="VibSlider_Changed" Style="{StaticResource TuneSliderStyle}"
                                VerticalAlignment="Center" Margin="14,0,18,0"/>
                        <Button Grid.Column="2" x:Name="VibRecommendedButton" Content="{DynamicResource Str.VibRecommendedSet}"
                                Style="{StaticResource SecondaryButtonStyle}" MinWidth="90" Padding="10,8" VerticalAlignment="Center"
                                Click="VibRecommended_Click" ToolTip="{DynamicResource Str.TipVibRecommended}"/>
                    </Grid>
                    <TextBlock x:Name="VibStateText" Text="{DynamicResource Str.Reading}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0" Visibility="Collapsed">
                        <Button x:Name="VibApplyButton" Content="{DynamicResource Str.Apply}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="110" Margin="0,0,8,0" Click="VibApply_Click"/>
                        <Button x:Name="VibRestoreButton" Content="{DynamicResource Str.RestoreOriginal}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="110" Click="VibRestore_Click"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="VibUnsupportedText" Text="" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>

            <Expander x:Name="IccAdvanced" Header="{DynamicResource Str.IccAdvanced}" IsExpanded="False" Margin="0,0,0,14">
                <StackPanel Margin="0,14,0,0">
                    <TextBlock Text="{DynamicResource Str.IccCard}" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock x:Name="IccCurrentText" Text="{DynamicResource Str.Reading}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <!-- Windows 设置里「颜色配置文件」磁贴只做关联：屏幕会不会变，取决于那个 ICC 里有没有 vcgt 校准表。 -->
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="{DynamicResource RadiusControl}" Padding="14,12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.SystemIccTitle}" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock x:Name="SystemIccText" Text="{DynamicResource Str.Reading}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="SystemIccApplyButton" Content="{DynamicResource Str.SystemIccApply}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="150" Margin="0,0,8,0" Click="SystemIccApply_Click"/>
                                <Button x:Name="SystemIccRefreshButton" Content="{DynamicResource Str.SystemIccRefresh}" Style="{StaticResource GhostButtonStyle}" MinWidth="90" Click="SystemIccRefresh_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="IccSupportedPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <TextBlock Text="{DynamicResource Str.IccPresetLabel}" Style="{StaticResource MutedTextStyle}"/>
                        <ItemsControl Visibility="Collapsed" x:Name="IccPresetList" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <RadioButton GroupName="iccPreset" Style="{StaticResource PresetCard}" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                    <StackPanel><TextBlock controls:LocalizedText.Key="{Binding TitleKey}" Style="{StaticResource PresetCardText}"/>
                                        <TextBlock controls:LocalizedText.Key="{Binding DescriptionKey}" Style="{StaticResource PresetCardNote}"/>
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="IccStateText" Text="" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Visibility="Collapsed" x:Name="IccApplyButton" Content="{DynamicResource Str.ApplyPreset}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="110" Margin="0,0,8,0" Click="IccApply_Click"/>
                            <Button x:Name="IccApplyFileButton" Content="{DynamicResource Str.IccApplyFromFile}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="120" Margin="0,0,8,0" Click="IccApplyFromFile_Click" ToolTip="{DynamicResource Str.IccApplyFromFileTip}"/>
                            <Button Visibility="Collapsed" x:Name="IccRestoreButton" Content="{DynamicResource Str.RestoreOriginal}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="110" Click="IccRestore_Click"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Str.IccNote}" Style="{StaticResource MutedTextStyle}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock x:Name="IccUnsupportedText" Text="" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Expander>

            <StackPanel x:Name="SectionAutomation">
                <Border x:Name="CardFullscreen" Style="{StaticResource CardStyle}" Padding="24,20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.FullscreenTitle}" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Str.FullscreenHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <CheckBox x:Name="FullscreenCheck" Content="{DynamicResource Str.FullscreenToggle}" Style="{StaticResource ToggleSwitchStyle}"
                                  Margin="0,10,0,0" Checked="Fullscreen_Changed" Unchecked="Fullscreen_Changed"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.FullscreenPresetLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="FullscreenPresetCombo" Grid.Column="1" MinWidth="220" MaxWidth="260" HorizontalAlignment="Left"
                                      DisplayMemberPath="Label" Style="{StaticResource SelectComboBoxStyle}"
                                      AutomationProperties.Name="{DynamicResource Str.FullscreenPresetLabel}" SelectionChanged="FullscreenPreset_Changed"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.FullscreenChannelLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="FullscreenChannelCombo" Grid.Column="1" MinWidth="220" MaxWidth="260" HorizontalAlignment="Left"
                                      DisplayMemberPath="Label" Style="{StaticResource SelectComboBoxStyle}"
                                      AutomationProperties.Name="{DynamicResource Str.FullscreenChannelLabel}" SelectionChanged="FullscreenChannel_Changed"/>
                        </Grid>
                        <CheckBox x:Name="FullscreenGamesOnlyCheck" Content="{DynamicResource Str.FullscreenOnlyGames}"
                                  Style="{StaticResource ToggleSwitchStyle}" Margin="0,10,0,0"
                                  Checked="FullscreenGamesOnly_Changed" Unchecked="FullscreenGamesOnly_Changed"/>
                        <TextBlock Text="{DynamicResource Str.FullscreenChannelHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="{DynamicResource Str.FullscreenConflict}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock x:Name="FullscreenStatus" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.DeltaFixTab}" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Str.DeltaFixIntro}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <Button Content="{DynamicResource Str.DeltaFixOpen}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OpenDeltaFix_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
