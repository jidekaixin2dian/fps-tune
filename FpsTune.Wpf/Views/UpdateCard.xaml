<UserControl x:Class="FpsTune.Wpf.Views.UpdateCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:FpsTune.Wpf.Views.Controls">
    <controls:NotificationCard x:Name="Card">
        <controls:NotificationCard.Body>
            <StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="160">
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </ScrollViewer>
                <StackPanel Margin="0,12,0,12"><TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ProgressBar x:Name="DownloadProgress" Height="4" Maximum="100" Visibility="Collapsed" Margin="0,8,0,0"/></StackPanel>
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Str.UpdateLater}" Click="Later_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button x:Name="InstallButton" Content="{DynamicResource Str.UpdateNow}" Click="Install_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                </WrapPanel>
            </StackPanel>
        </controls:NotificationCard.Body>
    </controls:NotificationCard>
</UserControl>
