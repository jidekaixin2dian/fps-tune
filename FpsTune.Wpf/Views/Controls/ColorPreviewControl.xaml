<UserControl x:Class="FpsTune.Wpf.Views.Controls.ColorPreviewControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FpsTune.Wpf.Views.Controls">
 <StackPanel>
  <DockPanel Margin="0,0,0,10">
   <Button x:Name="LoadImageButton" DockPanel.Dock="Right" Content="{DynamicResource Str.ColorPreviewLoad}" Click="LoadImage_Click" Style="{StaticResource SecondaryButtonStyle}"/>
   <StackPanel VerticalAlignment="Center">
    <controls:FileNameLabel x:Name="ImageNameText" Text="{DynamicResource Str.ColorPreviewSample}" Margin="0,0,10,0"/>
    <TextBlock Text="{DynamicResource Str.ColorPreviewSourceHint}" Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,3,10,0"/>
   </StackPanel>
  </DockPanel>
  <ComboBox x:Name="ScreenshotCombo" Style="{StaticResource SelectComboBoxStyle}" SelectionChanged="Screenshot_Changed" Margin="0,0,0,10" AutomationProperties.Name="{DynamicResource Str.ColorPreviewScene}">
   <ComboBoxItem Content="{DynamicResource Str.ColorPreviewDelta}"/>
   <ComboBoxItem Content="{DynamicResource Str.ColorPreviewValorant}"/>
   <ComboBoxItem x:Name="CustomSceneItem" Content="{DynamicResource Str.ColorPreviewCustom}" Visibility="Collapsed"/>
   <ComboBoxItem x:Name="RecentSceneItem" Content="{DynamicResource Str.ColorPreviewRecent}"/>
  </ComboBox>
  <!-- 明确预览看的是哪一种效果：游戏能看到的（gamma + 数字振动）还是读 ICC 的程序看到的。 -->
  <WrapPanel Margin="0,0,0,10">
   <RadioButton x:Name="ChannelGame" GroupName="previewChannel" Style="{StaticResource ChoiceTabStyle}" Content="{DynamicResource Str.ColorPreviewChannelGame}"
                IsChecked="True" Checked="Channel_Changed" AutomationProperties.Name="{DynamicResource Str.ColorPreviewChannelGame}"/>
   <RadioButton x:Name="ChannelManaged" GroupName="previewChannel" Style="{StaticResource ChoiceTabStyle}" Content="{DynamicResource Str.ColorPreviewChannelManaged}"
                Checked="Channel_Changed" AutomationProperties.Name="{DynamicResource Str.ColorPreviewChannelManaged}"/>
  </WrapPanel>
  <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" MaxHeight="460">
  <Grid x:Name="ComparisonViewport" Width="960" Height="540" SizeChanged="Comparison_SizeChanged" IsVisibleChanged="Viewport_IsVisibleChanged">
  <Border x:Name="ComparisonFrame" HorizontalAlignment="Stretch" Background="#11151B" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="1">
   <!-- 尺寸交给布局：固定高度 + 撑满可用宽度（最多 880），不再用代码算像素——算错过一次，
        预览被压成一条竖线、分界手柄也就点不到了。 -->
   <Grid x:Name="ComparisonSurface" ClipToBounds="True">
    <TextBlock x:Name="EmptyHint" Text="{DynamicResource Str.ColorPreviewEmpty}" Foreground="#CCD2DA" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20"/>
    <Image x:Name="AfterImage" Stretch="Uniform"/>
    <Grid x:Name="BeforeLayer"><Image x:Name="BeforeImage" Stretch="Uniform"/></Grid>
    <!-- 这条不是"调参滑杆"：全站隐式 Slider 样式（Left + MaxWidth 260 + 高 22）会把它压成
         拇指宽度、跑到图下方，谁都拖不到。这里显式脱离该样式，铺满整块对比区。 -->
    <Slider x:Name="SplitSlider" Style="{x:Null}" Height="Auto" Minimum="0" Maximum="100" Value="50" SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True" ValueChanged="Split_Changed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Focusable="True" Cursor="SizeWE" AutomationProperties.Name="{DynamicResource Str.ColorPreviewSplit}" ToolTip="{DynamicResource Str.ColorPreviewDrag}">
     <Slider.Template>
      <ControlTemplate TargetType="Slider">
       <Grid Background="Transparent">
        <Track x:Name="PART_Track" Margin="0,0" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
         <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
         <Track.Thumb>
          <Thumb Width="24" Cursor="SizeWE">
           <Thumb.Template><ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent">
             <Border Width="2" Background="#F2FFFFFF"/>
             <Border x:Name="Grip" Width="18" Height="44" CornerRadius="9" Background="#FAFFFFFF" BorderBrush="#50000000" BorderThickness="1" VerticalAlignment="Center">
              <Path Data="M 0,0 L 0,12 M 4,0 L 4,12" Stroke="#4B5563" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
             </Border>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers>
           </ControlTemplate></Thumb.Template>
          </Thumb>
         </Track.Thumb>
         <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
        </Track>
       </Grid>
       <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate>
     </Slider.Template>
    </Slider>
    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#C011151B" CornerRadius="{DynamicResource RadiusChip}" Padding="8,4" Margin="10" IsHitTestVisible="False"><TextBlock Text="{DynamicResource Str.ColorPreviewBefore}" Foreground="White"/></Border>
    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#C011151B" CornerRadius="{DynamicResource RadiusChip}" Padding="8,4" Margin="10" IsHitTestVisible="False"><TextBlock Text="{DynamicResource Str.ColorPreviewAfter}" Foreground="White"/></Border>
   </Grid>
  </Border>
  </Grid>
  </Viewbox>
  <TextBlock Text="{DynamicResource Str.ColorPreviewDrag}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
  <TextBlock x:Name="PreviewStatus" Text="{DynamicResource Str.ColorPreviewGameHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,7,0,0"/>
 </StackPanel>
</UserControl>
