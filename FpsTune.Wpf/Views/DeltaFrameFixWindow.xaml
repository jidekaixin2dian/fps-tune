<Window x:Class="FpsTune.Wpf.Views.DeltaFrameFixWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{DynamicResource Str.DeltaFixTitle}" Style="{StaticResource WindowTypographyStyle}" Width="668" SizeToContent="Height" MaxHeight="788"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize" WindowStyle="None"
    AllowsTransparency="True" Background="Transparent">
    <Border x:Name="Shell" Margin="14" Background="{DynamicResource AppBackdropBrush}"
            BorderBrush="{DynamicResource BorderHoverBrush}" BorderThickness="1"
            CornerRadius="{DynamicResource RadiusCard}" Padding="24" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup><ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1"/><TranslateTransform x:Name="ShellOffset" Y="0"/></TransformGroup>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.2" Color="#000000"/>
        </Border.Effect>
        <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14" MouseLeftButtonDown="Header_MouseDown">
            <TextBlock Text="{DynamicResource Str.DeltaFixTitle}" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="{DynamicResource Str.DeltaFixIntro}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="520"><StackPanel Margin="0,0,8,0">
            <Border Style="{StaticResource CardStyle}"><StackPanel>
                <TextBlock Text="{DynamicResource Str.DeltaFixScanTitle}" Style="{StaticResource CardTitleStyle}"/>
                <TextBlock x:Name="ScanText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock Text="{DynamicResource Str.DeltaFixGameSteps}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><StackPanel>
                <TextBlock Text="{DynamicResource Str.DeltaFixPsoTitle}" Style="{StaticResource CardTitleStyle}"/>
                <TextBlock Text="{DynamicResource Str.DeltaFixPsoHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                <Button x:Name="PsoFixButton" Content="{DynamicResource Str.DeltaFixPsoAction}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="PsoFix_Click"/>
            </StackPanel></Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><StackPanel>
                <TextBlock Text="{DynamicResource Str.DeltaFixLegacyTitle}" Style="{StaticResource CardTitleStyle}"/>
                <TextBlock Text="{DynamicResource Str.DeltaFixLegacyHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                <Button x:Name="LegacyFixButton" Content="{DynamicResource Str.DeltaFixLegacyAction}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="LegacyFix_Click"/>
                <TextBlock Text="{DynamicResource Str.DeltaFixLaunchArgs}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel></Border>
            <TextBlock x:Name="ResultText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,14,0,0"/>
        </StackPanel></ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource Str.Cancel}" Style="{StaticResource GhostButtonStyle}" Click="Cancel_Click"/>
        </WrapPanel>
        </Grid>
    </Border>
</Window>
