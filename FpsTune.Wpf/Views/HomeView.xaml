<UserControl x:Class="FpsTune.Wpf.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头：mono 标签 + 联系方式（联系条目由 code-behind 动态填充） -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="概览"
                       Style="{StaticResource SectionLabelStyle}"
                       VerticalAlignment="Center"/>
            <StackPanel x:Name="ContactPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>
        </Grid>

        <!-- 状态宣言区 -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="系统层帧率优化控制台"
                           FontSize="26" FontWeight="SemiBold"
                           FontFamily="{StaticResource FontDisplay}"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="检测 → 解释 → 确认 → 执行 → 还原 · 不碰游戏文件 · 不注入进程 · 所有改动可还原"
                           FontSize="12.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock x:Name="VersionText"
                               Text="v1.0.0"
                               FontSize="11"
                               FontFamily="{StaticResource FontMono}"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"/>
                    <Border Width="1" Height="12" Background="{DynamicResource BorderBrush}" Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HardwareSummaryText"
                               Text=""
                               FontSize="11"
                               FontFamily="{StaticResource FontMono}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
            <Button x:Name="StartOptimizeButton"
                    Grid.Column="1"
                    Content="开始检测 →"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="132"
                    VerticalAlignment="Center"
                    Click="StartOptimize_Click"/>
        </Grid>

        <Border Grid.Row="2" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20,0,18"/>

        <!-- 功能模块：编号行块 -->
        <UniformGrid Grid.Row="3" Columns="2">
            <Border Style="{StaticResource FeatureCardStyle}" Margin="0,0,6,6" Cursor="Hand" Tag="detect" MouseLeftButtonUp="Module_Click" Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="01"
                               FontFamily="{StaticResource FontMono}" FontSize="15"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="检测" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="硬件信息、游戏路径、体检和优化项状态，只读不改" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource FeatureCardStyle}" Margin="6,0,0,6" Cursor="Hand" Tag="opt" MouseLeftButtonUp="Module_Click" Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="02"
                               FontFamily="{StaticResource FontMono}" FontSize="15"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="优化" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="OptCardSummary" Text="预设与逐项开关、系统层优化、一键还原" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource FeatureCardStyle}" Margin="0,6,6,6" Cursor="Hand" Tag="session" MouseLeftButtonUp="Module_Click" Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="03"
                               FontFamily="{StaticResource FontMono}" FontSize="15"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="性能会话" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="本地采样 CPU / 内存 / GPU / 显存，生成摘要、洞察与对比" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource FeatureCardStyle}" Margin="6,6,0,6" Cursor="Hand" Tag="ab" MouseLeftButtonUp="Module_Click" Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="04"
                               FontFamily="{StaticResource FontMono}" FontSize="15"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="A/B 实验" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="基线采样、候选组对比、保留或还原决策" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource FeatureCardStyle}" Margin="0,6,6,0" Cursor="Hand" Tag="friend" MouseLeftButtonUp="Module_Click" Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="05"
                               FontFamily="{StaticResource FontMono}" FontSize="15"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="朋友测试" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="生成优化前后帧率对比记录表" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource FeatureCardStyle}" Margin="6,6,0,0" Cursor="Hand" Tag="backup" MouseLeftButtonUp="Module_Click" Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="06"
                               FontFamily="{StaticResource FontMono}" FontSize="15"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="备份 / 日志" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="备份文件、还原全部、日志和 JSON 输出" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

    </Grid>
</UserControl>
