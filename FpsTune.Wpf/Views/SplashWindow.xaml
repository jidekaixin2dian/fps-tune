<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FpsTune.Wpf.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.AppName}"
        Width="460"
        Height="280"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource FontBody}">
    <Border Margin="16"
            Background="{DynamicResource AppBackdropBrush}"
            BorderBrush="{DynamicResource BorderHoverBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusCard}"
            Padding="34,30">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                              ShadowDepth="5"
                              Opacity="0.4"
                              Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 品牌区 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Width="44" Height="44"
                        CornerRadius="{StaticResource RadiusControl}"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE9D9;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="22"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Str.AppName}"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Str.SplashTagline}"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- 加载动画：四个圆点依次呼吸 -->
            <StackPanel x:Name="DotsPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <StackPanel.Resources>
                    <Style TargetType="Ellipse">
                        <Setter Property="Width" Value="9"/>
                        <Setter Property="Height" Value="9"/>
                        <Setter Property="Margin" Value="6,0"/>
                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="Opacity" Value="0.25"/>
                    </Style>
                </StackPanel.Resources>
                <Ellipse x:Name="Dot1"/>
                <Ellipse x:Name="Dot2"/>
                <Ellipse x:Name="Dot3"/>
                <Ellipse x:Name="Dot4"/>
            </StackPanel>

            <TextBlock x:Name="LoadingText" Grid.Row="3"
                       Text="{DynamicResource Str.SplashLoading}"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="VersionText" Grid.Row="4"
                       Text=""
                       FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>
        </Grid>
    </Border>
</Window>
