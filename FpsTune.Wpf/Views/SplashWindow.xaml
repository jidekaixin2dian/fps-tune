<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FpsTune.Wpf.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.AppName}" Style="{StaticResource WindowTypographyStyle}"
        Width="460"
        Height="280"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource FontBody}">
    <!-- 0.1.12 重设计：去掉装饰性 spinner，改为真实启动阶段进度条——
         每一段推进都对应 OnStartup 里实际完成的步骤（准备/恢复现场/构建界面/就绪） -->
    <Border Margin="16"
            Background="{DynamicResource AppBackdropBrush}"
            BorderBrush="{DynamicResource BorderHoverBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusCard}"
            Padding="40,32">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                              ShadowDepth="5"
                              Opacity="0.4"
                              Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 品牌区：用软件真实图标（与标题栏同一张 app-icon.png），不再用字体字形 -->
            <StackPanel HorizontalAlignment="Center">
                <Image Source="/Assets/app-icon.png"
                       Width="64" Height="64"
                       HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="{DynamicResource Str.AppName}"/>
                <TextBlock Text="{DynamicResource Str.AppName}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0"/>
                <TextBlock Text="{DynamicResource Str.SplashTagline}"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <!-- 进度区：细进度条 + 当前阶段 + 版本 -->
            <StackPanel Grid.Row="2">
                <ProgressBar x:Name="PhaseBar"
                             Style="{StaticResource ThinMeterStyle}"
                             Foreground="{DynamicResource AccentBrush}"
                             Maximum="100"
                             Value="6"/>
                <TextBlock x:Name="LoadingText" Grid.Row="3"
                           Text="{DynamicResource Str.SplashPhasePrepare}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
                <TextBlock x:Name="VersionText" Grid.Row="4"
                           Text=""
                           FontSize="10.5"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
