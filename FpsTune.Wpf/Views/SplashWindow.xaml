<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FpsTune.Wpf.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.AppName}"
        Width="460"
        Height="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource FontBody}">
    <Border Margin="16"
            Background="{DynamicResource AppBackdropBrush}"
            BorderBrush="{DynamicResource BorderHoverBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusCard}"
            Padding="36,30">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                              ShadowDepth="5"
                              Opacity="0.4"
                              Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 品牌区 -->
            <StackPanel HorizontalAlignment="Center">
                <Border Width="56" Height="56"
                        HorizontalAlignment="Center"
                        CornerRadius="14"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1.5">
                    <TextBlock Text="&#xE9D9;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="28"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{DynamicResource Str.AppName}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0"/>
                <TextBlock Text="{DynamicResource Str.SplashTagline}"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <!-- 旋转圆环加载指示（accent 弧线 + 弱化轨道） -->
            <Grid Grid.Row="2" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Ellipse Stroke="{DynamicResource BorderBrush}" StrokeThickness="4"/>
                <Ellipse x:Name="SpinnerArc" Stroke="{DynamicResource AccentBrush}" StrokeThickness="4"
                         StrokeDashArray="11 21" StrokeDashCap="Round"
                         StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" CenterX="22" CenterY="22"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

            <TextBlock x:Name="LoadingText" Grid.Row="3"
                       Text="{DynamicResource Str.SplashLoading}"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="VersionText" Grid.Row="4"
                       Text=""
                       FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>
        </Grid>
    </Border>
</Window>
