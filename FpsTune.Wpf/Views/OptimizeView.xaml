<UserControl x:Class="FpsTune.Wpf.Views.OptimizeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:FpsTune.Wpf.Views"
 Background="{DynamicResource ConsoleBackgroundBrush}" FontFamily="{StaticResource FontBody}">
 <UserControl.Resources>
  <local:CatalogGroupLabelConverter x:Key="CatalogGroupLabel"/>
  <Style x:Key="PresetChoiceStyle" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="MinHeight" Value="48"/>
   <Setter Property="Margin" Value="0,0,10,0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Choice" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="3" Padding="12,10">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Choice" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CategoryChoiceStyle" TargetType="RadioButton" BasedOn="{StaticResource PresetChoiceStyle}">
   <Setter Property="MinHeight" Value="38"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Margin" Value="0,0,6,0"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="28,20,28,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18">
   <TextBlock Text="{DynamicResource Str.OptimizeTitle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="22" FontWeight="SemiBold"/>
   <TextBlock Text="{DynamicResource Str.OptIntro}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"/>
  </StackPanel>
  <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="0,14" Margin="0,0,0,16">
   <DockPanel LastChildFill="True">
    <TextBlock Text="{DynamicResource Str.OptimizePresets}" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
    <UniformGrid Columns="4">
     <RadioButton x:Name="PresetBalanced" Content="{DynamicResource Str.PresetBalanced}" GroupName="preset" IsChecked="True" Style="{StaticResource PresetChoiceStyle}" ToolTip="{DynamicResource Str.TipBalanced}"/>
     <RadioButton x:Name="PresetSafeOnly" Content="{DynamicResource Str.PresetSafe}" GroupName="preset" Style="{StaticResource PresetChoiceStyle}" ToolTip="{DynamicResource Str.TipSafe}"/>
     <RadioButton x:Name="PresetFull" Content="{DynamicResource Str.PresetFull}" GroupName="preset" Style="{StaticResource PresetChoiceStyle}" ToolTip="{DynamicResource Str.TipFull}"/>
     <RadioButton x:Name="PresetCustom" Content="{DynamicResource Str.PresetCustom}" GroupName="preset" Style="{StaticResource PresetChoiceStyle}" Margin="0"/>
    </UniformGrid>
   </DockPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Grid.Row="0" Margin="0,0,10,10">
                        <TextBlock x:Name="ItemListTitle" Text="{DynamicResource Str.ItemsTitle}" Style="{StaticResource CardTitleStyle}" Margin="0" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Grid Width="190" Height="34">
                                <TextBox x:Name="SearchBox"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         VerticalContentAlignment="Center"
                                         FontSize="13"
                                         TextChanged="SearchBox_TextChanged"/>
                                <!-- 占位文字: 叠在输入框内部, 有输入即隐藏 -->
                                <TextBlock Text="{DynamicResource Str.SearchItems}"
                                           IsHitTestVisible="False"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Margin="11,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Content="{DynamicResource Str.SelectCurrent}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    MinWidth="72" Height="34" Margin="12,0,0,0"
                                    Click="SelectAllVisible_Click"/>
                            <Button Content="{DynamicResource Str.ClearCurrent}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    MinWidth="72" Height="34" Margin="8,0,0,0"
                                    Click="ClearAll_Click"/>
                        </StackPanel>
                    </Grid><UniformGrid Columns="6" Grid.Row="1" Margin="0,0,10,8">
                        <RadioButton Content="{DynamicResource Str.GroupAll}" GroupName="grpfilter" IsChecked="True" Tag=""
                                     Style="{StaticResource CategoryChoiceStyle}" Checked="GroupChip_Checked"/>
                        <RadioButton Content="{DynamicResource Str.GroupKeyboardMouse}" GroupName="grpfilter" Tag="键鼠"
                                     Style="{StaticResource CategoryChoiceStyle}" Checked="GroupChip_Checked"/>
                        <RadioButton Content="{DynamicResource Str.GroupGraphics}" GroupName="grpfilter" Tag="图形显示"
                                     Style="{StaticResource CategoryChoiceStyle}" Checked="GroupChip_Checked"/>
                        <RadioButton Content="{DynamicResource Str.GroupNetwork}" GroupName="grpfilter" Tag="网络"
                                     Style="{StaticResource CategoryChoiceStyle}" Checked="GroupChip_Checked"/>
                        <RadioButton Content="{DynamicResource Str.GroupPower}" GroupName="grpfilter" Tag="电源"
                                     Style="{StaticResource CategoryChoiceStyle}" Checked="GroupChip_Checked"/>
                        <RadioButton Content="{DynamicResource Str.GroupSystem}" GroupName="grpfilter" Tag="系统与调度"
                                     Style="{StaticResource CategoryChoiceStyle}" Checked="GroupChip_Checked"/>
                    </UniformGrid><ListBox x:Name="ItemList"
                             Grid.Row="2"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource CardListItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding ItemsView, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                                            <TextBlock Text="{Binding Name, Converter={StaticResource CatalogGroupLabel}}"
                                                       FontSize="13" FontFamily="{StaticResource FontBody}"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,8,14,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="0"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Id}" Visibility="Collapsed"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="13"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" FontSize="15"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock Foreground="{DynamicResource WarningBrush}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding SideEffect}"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding HasSideEffect, Converter={StaticResource BoolToVis}}">
                                            <Run Text="{DynamicResource Str.SideEffectLabel}"/><Run Text="{Binding SideEffect, Mode=OneWay}"/>
                                        </TextBlock>
                                    <WrapPanel><Border
                                            Margin="0,6,8,0"
                                            Style="{StaticResource ChipStyle}"
                                            BorderBrush="{DynamicResource WarningBrush}"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{DynamicResource Str.Admin}"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   FontSize="12" FontFamily="{StaticResource FontMono}"/>
                                    </Border>
                                    <Border
                                            Margin="0,6,8,0"
                                            Style="{StaticResource ChipStyle}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{DynamicResource Str.NeedsReboot}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="12" FontFamily="{StaticResource FontMono}"/>
                                    </Border>
                                    </WrapPanel></StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Optimized}" Value="True"><Setter Property="Foreground" Value="{DynamicResource OkBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <CheckBox Grid.Column="4"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding IsChecked}" Click="ItemToggle_Click" AutomationProperties.Name="{Binding Name}"
                                              VerticalAlignment="Center"
                                              Margin="14,0,0,0"/>
                                </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
    <TextBlock x:Name="EmptyHint" Grid.Row="2" Text="{DynamicResource Str.NoMatchingItems}" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource MutedTextStyle}"/>
   </Grid>
   <Grid Grid.Column="2" Margin="0,0,0,0">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="18,0,0,12">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="{DynamicResource Str.ItemDetailTitle}" Style="{StaticResource CardTitleStyle}"/>
<FlowDocumentScrollViewer Grid.Row="1"
                                 x:Name="OutputBox"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent">
                            <FlowDocument x:Name="OutputDoc" PagePadding="0" Background="Transparent"
                                          FontFamily="{StaticResource FontBody}" FontSize="13">
                                <Paragraph Foreground="{DynamicResource TextSecondaryBrush}">
                                    选择预设后点击“应用”。
                                </Paragraph>
                            </FlowDocument>
                        </FlowDocumentScrollViewer>
     </Grid>
    </Border>
    <Expander Grid.Row="1" Header="{DynamicResource Str.MyProfiles}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" Padding="0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
     <StackPanel Margin="0,12,0,0">
      <TextBlock Text="{DynamicResource Str.ProfileName}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,6"/>
<TextBox x:Name="ProfileNameBox"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Height="34"
                                 VerticalContentAlignment="Center" FontSize="13"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="{DynamicResource Str.Save}" Style="{StaticResource GhostButtonStyle}" MinWidth="52" Margin="0,0,4,4" Click="ProfileSave_Click"/>
                            <Button Content="{DynamicResource Str.Load}" Style="{StaticResource GhostButtonStyle}" MinWidth="52" Margin="0,0,4,4" Click="ProfileLoad_Click"/>
                            <Button Content="{DynamicResource Str.Delete}" Style="{StaticResource GhostButtonStyle}" MinWidth="52" Margin="0,0,4,4" Click="ProfileDelete_Click"/>
                            <Button Content="{DynamicResource Str.Export}" Style="{StaticResource GhostButtonStyle}" MinWidth="52" Margin="0,0,4,4" Click="ProfileExport_Click"/>
                            <Button Content="{DynamicResource Str.Import}" Style="{StaticResource GhostButtonStyle}" MinWidth="52" Margin="0,0,0,4" Click="ProfileImport_Click"/>
                        </WrapPanel><TextBlock x:Name="ProfileHint"
                                   Text="{DynamicResource Str.ProfileHint}"
                                   Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
     </StackPanel>
    </Expander>
   </Grid>
  </Grid>
  <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock x:Name="SelectionSummary" Text="{DynamicResource Str.PendingZero}" Foreground="{DynamicResource AccentBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <CheckBox x:Name="ConsentCheck" Style="{StaticResource ToggleSwitchStyle}"><TextBlock Text="{DynamicResource Str.ConsentText}" FontSize="13" TextWrapping="Wrap"/></CheckBox>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="RestoreButton" Content="{DynamicResource Str.RestoreAll}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="110" Margin="12,0" Click="RestoreButton_Click"/>
     <Button x:Name="OneClickButton" Content="{DynamicResource Str.OneClick}"
             Style="{StaticResource SecondaryButtonStyle}" MinWidth="110" Height="40" Margin="0,0,12,0" Click="OneClickButton_Click"
             ToolTip="{DynamicResource Str.OneClickTip}"/>
     <Button x:Name="ApplyButton" Content="{DynamicResource Str.ApplySelected}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="144" Height="40" Click="ApplyButton_Click"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
