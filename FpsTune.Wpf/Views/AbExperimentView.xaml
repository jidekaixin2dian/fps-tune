<UserControl x:Class="FpsTune.Wpf.Views.AbExperimentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <!-- 页面根滚动: 上方 Auto 行合计约 590px, 小窗口下会把"原始输出"挤到不可见;
         与检测页同款做法, 整页自然高度 + 根 ScrollViewer -->
    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="A/B 实验室" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="向导式实验：先采基线，再依次测试三个候选组，每步可关联一次性能会话，结论只来自实际采样"
                           Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
            </StackPanel>
             <Button x:Name="OpenDirButton"
                     Content="打开实验目录"
                     Style="{StaticResource SecondaryButtonStyle}"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     MinWidth="130"
                     Click="OpenDirButton_Click"/>
             <Button x:Name="CancelRunButton"
                     Content="取消当前步骤"
                     Style="{StaticResource GhostButtonStyle}"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     MinWidth="110" Margin="0,0,142,0"
                     IsEnabled="False"
                     Click="CancelRunButton_Click"/>
        </Grid>

        <!-- 向导步骤 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="实验向导（每步在同一游戏场景内进行）" Style="{StaticResource CardTitleStyle}"/>
                <ItemsControl x:Name="WizardStepsList" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8"
                                    Background="{DynamicResource ElevatedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource BorderBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="done">
                                                                <Setter Property="Fill" Value="{DynamicResource OkBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="reverted">
                                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="error">
                                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="running">
                                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ResultText}" FontSize="11" Margin="17,5,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="17,6,0,0">
                                            <TextBlock Text="关联性能会话：" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                            <ComboBox ItemsSource="{Binding SessionOptions}"
                                                      SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                                                      DisplayMemberPath="Label"
                                             Style="{StaticResource SelectComboBoxStyle}"
                                             MinHeight="28" MinWidth="220" Margin="4,0,0,0"
                                                       IsEnabled="{Binding CanEditSession}"
                                                       SelectionChanged="StepSession_SelectionChanged"
                                                      Tag="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding RunLabel}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinWidth="92" VerticalAlignment="Center" Margin="12,0,0,0"
                                            IsEnabled="{Binding CanRun}"
                                            Click="WizardStepRun_Click"
                                            Tag="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 状态条 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,14"
                BorderBrush="{DynamicResource AccentBrush}">
            <!-- Grid 而非横向 StackPanel: 让状态文本获得受限宽度, 长错误信息才能换行 -->
            <Grid>
                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText"
                           Text="就绪。点击上方步骤开始采样。"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 指标瓦片 -->
        <UniformGrid Grid.Row="3" Columns="6" Margin="0,0,0,14">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="平均 FPS" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="AvgFpsText" Text="--" Style="{StaticResource StatValueStyle}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="1% LOW" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="P1LowText" Text="--" Style="{StaticResource StatValueStyle}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="P99 (MS)" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="P99Text" Text="--" Style="{StaticResource StatValueStyle}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="卡顿" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="StutterText" Text="--" Style="{StaticResource StatValueStyle}" Foreground="{DynamicResource WarningBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="波动 CV" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="CvText" Text="--" Style="{StaticResource StatValueStyle}" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="结论" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock x:Name="DecisionText" Text="--" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource OkBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 历史趋势 -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="210"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="历史趋势" Style="{StaticResource CardTitleStyle}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Width="16" Height="3" CornerRadius="1.5"
                                Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="平均 FPS" FontSize="11" Margin="6,0,14,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Border Width="16" Height="3" CornerRadius="1.5"
                                Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="1% LOW" FontSize="11" Margin="6,0,14,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button Content="刷新" Style="{StaticResource GhostButtonStyle}"
                                MinWidth="64" Click="RefreshHistory_Click"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <Canvas x:Name="HistoryCanvas"/>
                    <TextBlock x:Name="HistoryEmptyText"
                               Text="暂无历史数据。完成一次基线采样或候选组测试后，这里会画出均值与 1% low 的对比曲线。"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 原始输出 -->
        <Border Grid.Row="5" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="原始输出" Style="{StaticResource CardTitleStyle}"/>
                <!-- 根滚动布局下给固定高度, 内部自带滚动; 滚到边由 code-behind 还给页面 -->
                <TextBox Grid.Row="1"
                         x:Name="RawBox"
                         Style="{StaticResource MonoTextBoxStyle}"
                         IsReadOnly="True"
                         Height="150"
                         PreviewMouseWheel="RawBoxWheelToRoot"
                         Text="等待采样..."/>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
