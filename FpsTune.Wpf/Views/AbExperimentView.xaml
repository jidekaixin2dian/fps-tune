<UserControl x:Class="FpsTune.Wpf.Views.AbExperimentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <!-- 页面根滚动: 上方 Auto 行合计约 590px, 小窗口下会把"原始输出"挤到不可见;
         与检测页同款做法, 整页自然高度 + 根 ScrollViewer -->
    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str.NavAb}" Style="{StaticResource SectionLabelStyle}"/>
                <TextBlock Text="{DynamicResource Str.AbIntro}"
                           Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"/>
            </StackPanel>
             <Button x:Name="OpenDirButton"
                     Content="{DynamicResource Str.OpenExperimentDir}"
                     Style="{StaticResource SecondaryButtonStyle}"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     MinWidth="130"
                     Click="OpenDirButton_Click"/>
             <Button x:Name="CancelRunButton"
                     Content="{DynamicResource Str.CancelCurrentStep}"
                     Style="{StaticResource GhostButtonStyle}"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     MinWidth="110" Margin="0,0,142,0"
                     IsEnabled="False"
                     Click="CancelRunButton_Click"/>
        </Grid>

        <!-- 向导步骤 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str.AbWizardTitle}" Style="{StaticResource CardTitleStyle}"/>
                <ItemsControl x:Name="WizardStepsList" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" Padding="12,9" CornerRadius="{StaticResource RadiusControl}"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource BorderBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="done">
                                                                <Setter Property="Fill" Value="{DynamicResource OkBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="reverted">
                                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="error">
                                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="running">
                                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontFamily="{StaticResource FontMono}" Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ResultText}" FontSize="11" Margin="15,5,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="15,6,0,0">
                                            <TextBlock Text="{DynamicResource Str.LinkSession}" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                            <ComboBox ItemsSource="{Binding SessionOptions}"
                                                      SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                                                      DisplayMemberPath="Label"
                                             Style="{StaticResource SelectComboBoxStyle}"
                                             MinHeight="28" MinWidth="220" Margin="4,0,0,0"
                                                       IsEnabled="{Binding CanEditSession}"
                                                       SelectionChanged="StepSession_SelectionChanged"
                                                      Tag="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding RunLabel}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinWidth="92" VerticalAlignment="Center" Margin="12,0,0,0"
                                            IsEnabled="{Binding CanRun}"
                                            Click="WizardStepRun_Click"
                                            Tag="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 状态条 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                BorderBrush="{DynamicResource AccentBrush}" Padding="14,10">
            <!-- Grid 而非横向 StackPanel: 让状态文本获得受限宽度, 长错误信息才能换行 -->
            <Grid>
                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText"
                           Text="{DynamicResource Str.AbReady}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 指标通栏 -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.AvgFps}" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock x:Name="AvgFpsText" Text="--" Style="{StaticResource StatValueStyle}" FontSize="19" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Text="1% LOW" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock x:Name="P1LowText" Text="--" Style="{StaticResource StatValueStyle}" FontSize="19" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Text="P99 (MS)" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock x:Name="P99Text" Text="--" Style="{StaticResource StatValueStyle}" FontSize="19" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Stutter}" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock x:Name="StutterText" Text="--" Style="{StaticResource StatValueStyle}" FontSize="19" Foreground="{DynamicResource WarningBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.CvJitter}" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock x:Name="CvText" Text="--" Style="{StaticResource StatValueStyle}" FontSize="19" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="5" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Verdict}" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock x:Name="DecisionText" Text="--" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource OkBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 历史趋势 -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="210"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource Str.HistoryTrend}" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Width="14" Height="2"
                                Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Str.AvgFps}" FontSize="11" FontFamily="{StaticResource FontMono}" Margin="6,0,14,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Border Width="14" Height="2"
                                Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="1% LOW" FontSize="11" FontFamily="{StaticResource FontMono}" Margin="6,0,14,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button Content="{DynamicResource Str.Refresh}" Style="{StaticResource GhostButtonStyle}"
                                MinWidth="56" Click="RefreshHistory_Click"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <Canvas x:Name="HistoryCanvas"/>
                    <TextBlock x:Name="HistoryEmptyText"
                               Text="{DynamicResource Str.NoHistoryData}"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 原始输出 -->
        <Border Grid.Row="5" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource Str.RawOutput}" Style="{StaticResource CardTitleStyle}"/>
                <!-- 根滚动布局下给固定高度, 内部自带滚动; 滚到边由 code-behind 还给页面 -->
                <TextBox Grid.Row="1"
                         x:Name="RawBox"
                         Style="{StaticResource MonoTextBoxStyle}"
                         IsReadOnly="True"
                         Height="150"
                         PreviewMouseWheel="RawBoxWheelToRoot"
                         Text="{DynamicResource Str.WaitingForSample}"/>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
