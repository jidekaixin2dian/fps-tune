<UserControl x:Class="FpsTune.Wpf.Views.GuideCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:FpsTune.Wpf.Views.Controls">
    <controls:NotificationCard x:Name="Card">
        <controls:NotificationCard.Body>
            <StackPanel>
                <StackPanel x:Name="TutorialBody">
                    <TextBlock x:Name="StepTitle" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="StepBody" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,18"/>
                    <Button x:Name="GoToButton" Content="{DynamicResource Str.GoToStep}" Click="GoTo_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/>
                    <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="StepProgress" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource FontMono}"/>
                        <Button x:Name="PreviousButton" Grid.Column="1" Content="{DynamicResource Str.PreviousStep}" Click="Previous_Click" Style="{StaticResource GhostButtonStyle}" Margin="0,0,6,0"/>
                        <Button x:Name="NextButton" Grid.Column="2" Content="{DynamicResource Str.NextStep}" Click="Next_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>
                </StackPanel>
                <StackPanel x:Name="FeedbackBody" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Str.CommunityIntro}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="QQ 659528489" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,16,0,14"/>
                    <WrapPanel><Button Content="{DynamicResource Str.CopyGroup}" Click="CopyGroup_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"/>
                        <Button Content="{DynamicResource Str.OpenIssue}" Click="OpenIssue_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8"/></WrapPanel>
                    <TextBlock x:Name="CopyStatus" Foreground="{DynamicResource OkBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource Str.FeedbackDetails}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <TextBlock Text="{DynamicResource Str.CommunitySafety}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </controls:NotificationCard.Body>
    </controls:NotificationCard>
</UserControl>
