<Window x:Class="FpsTune.Wpf.Views.CloseChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.CloseChoiceTitle}" Style="{StaticResource WindowTypographyStyle}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" WindowStyle="None" Background="{DynamicResource AppBackdropBrush}">
    <Border Style="{StaticResource CardStyle}" Padding="26">
        <StackPanel>
            <TextBlock Text="{DynamicResource Str.CloseChoiceTitle}" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="{DynamicResource Str.CloseChoiceHint}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,20" TextWrapping="Wrap"/>
            <RadioButton x:Name="TrayChoice" IsChecked="True" GroupName="closeAction" Margin="0,0,0,16" AutomationProperties.Name="{DynamicResource Str.CloseChoiceTray}">
                <StackPanel><TextBlock Text="{DynamicResource Str.CloseChoiceTray}" FontWeight="{DynamicResource SmallEmphasisWeight}"/>
                    <TextBlock Text="{DynamicResource Str.CloseChoiceTrayHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,5,0,0" MaxWidth="360"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="ExitChoice" GroupName="closeAction" Margin="0,0,0,20" AutomationProperties.Name="{DynamicResource Str.CloseChoiceExit}">
                <StackPanel><TextBlock Text="{DynamicResource Str.CloseChoiceExit}" FontWeight="{DynamicResource SmallEmphasisWeight}"/>
                    <TextBlock Text="{DynamicResource Str.CloseChoiceExitHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,5,0,0" MaxWidth="360"/></StackPanel>
            </RadioButton>
            <CheckBox x:Name="RememberChoice" Content="{DynamicResource Str.CloseChoiceRemember}" Margin="0,0,0,24"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="{DynamicResource Str.Cancel}" IsCancel="True" Click="Cancel_Click" Style="{StaticResource GhostButtonStyle}" Margin="0,0,10,0"/>
                <Button x:Name="ConfirmButton" Content="{DynamicResource Str.CloseChoiceTray}" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="Confirm_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
