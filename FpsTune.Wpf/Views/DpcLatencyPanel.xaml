<UserControl x:Class="FpsTune.Wpf.Views.DpcLatencyPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="{DynamicResource Str.DpcTitle}" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Str.DpcIntro}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="DpcDurationCombo" MinWidth="96" Style="{StaticResource SelectComboBoxStyle}" SelectedIndex="1"
                              AutomationProperties.Name="{DynamicResource Str.DpcDurationLabel}">
                        <ComboBoxItem Content="15 s" Tag="15"/>
                        <ComboBoxItem Content="30 s" Tag="30"/>
                        <ComboBoxItem Content="60 s" Tag="60"/>
                    </ComboBox>
                    <Button x:Name="DpcRunButton" Content="{DynamicResource Str.DpcStart}" Style="{StaticResource PrimaryButtonStyle}"
                            Margin="10,0,0,0" MinWidth="112" Click="Run_Click"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="DpcAdminText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <ProgressBar x:Name="DpcProgress" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,10,0,0"
                         Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock x:Name="DpcStatusText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"
                       AutomationProperties.LiveSetting="Polite"/>

            <StackPanel x:Name="DpcResultPanel" Visibility="Collapsed" Margin="0,14,0,0">
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusControl}" Padding="14,12">
                    <StackPanel>
                        <DockPanel>
                            <Border x:Name="DpcVerdictBadge" DockPanel.Dock="Left" Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock x:Name="DpcVerdictText" Text="—" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="{DynamicResource SmallEmphasisWeight}"/>
                            </Border>
                            <TextBlock x:Name="DpcMeasuredText" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <UniformGrid Columns="4" Margin="0,12,0,0">
                            <StackPanel><TextBlock Text="{DynamicResource Str.DpcCpuShare}" Style="{StaticResource MutedTextStyle}" FontSize="12"/>
                                <TextBlock x:Name="DpcCpuText" Text="—" FontFamily="{StaticResource FontStat}" FontSize="20" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextPrimaryBrush}"/></StackPanel>
                            <StackPanel><TextBlock Text="{DynamicResource Str.DpcMax}" Style="{StaticResource MutedTextStyle}" FontSize="12"/>
                                <TextBlock x:Name="DpcMaxText" Text="—" FontFamily="{StaticResource FontStat}" FontSize="20" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextPrimaryBrush}"/></StackPanel>
                            <StackPanel><TextBlock Text="{DynamicResource Str.DpcIsrShare}" Style="{StaticResource MutedTextStyle}" FontSize="12"/>
                                <TextBlock x:Name="IsrCpuText" Text="—" FontFamily="{StaticResource FontStat}" FontSize="20" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextPrimaryBrush}"/></StackPanel>
                            <StackPanel><TextBlock Text="{DynamicResource Str.DpcSamples}" Style="{StaticResource MutedTextStyle}" FontSize="12"/>
                                <TextBlock x:Name="DpcSamplesText" Text="—" FontFamily="{StaticResource FontStat}" FontSize="20" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextPrimaryBrush}"/></StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource Str.DpcDriversTitle}" Style="{StaticResource MutedTextStyle}" Margin="0,12,0,6"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/><ColumnDefinition Width="86"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str.DpcDriverModule}" Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                    <TextBlock Grid.Column="1" Text="{DynamicResource Str.DpcDriverTotal}" Style="{StaticResource MutedTextStyle}" FontSize="11" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource Str.DpcDriverMax}" Style="{StaticResource MutedTextStyle}" FontSize="11" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="{DynamicResource Str.DpcDriverCount}" Style="{StaticResource MutedTextStyle}" FontSize="11" HorizontalAlignment="Right"/>
                </Grid>
                <ItemsControl x:Name="DpcDriversList">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/><ColumnDefinition Width="86"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Module}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding CombinedTotalMs, StringFormat={}{0:0.0} ms}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                            <TextBlock Grid.Column="2" Text="{Binding CombinedMaxMs, StringFormat={}{0:0.00} ms}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                            <TextBlock Grid.Column="3" Text="{Binding CombinedCount}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{DynamicResource Str.DpcDriverLimit}" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,6,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
