<Window x:Class="FpsTune.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FpsTune.Wpf.Views.Controls"

        Icon="Assets/app.ico"
        Width="1200" Height="780"
        MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Title="FPS 帧律"
        SourceInitialized="OnSourceInitialized"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="7"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="ChromeRoot"
            Background="{DynamicResource AppBackdropBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid x:Name="ChromeGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 极光层: 三组全窗渐变叠加在基础底色之上, 贯穿标题栏、页签栏与页面。 -->
            <Grid x:Name="AuroraLayer"
                  Grid.Row="0" Grid.RowSpan="3"
                  IsHitTestVisible="False"
                  ClipToBounds="True">
                <!-- 青色主光: 从上缘向内容区缓慢漂移。 -->
                <Border x:Name="AuroraMainLayer"
                        Opacity="0.9">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="AuroraMainTransform"/>
                    </Border.RenderTransform>
                </Border>
                <!-- 蓝色侧光: 从右侧斜向扫过, 保持低饱和避免抢文字层级。 -->
                <Border x:Name="AuroraSideLayer"
                        Opacity="0.78">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="AuroraSideTransform"/>
                    </Border.RenderTransform>
                </Border>
                <!-- 底部反射光: 很轻的冷色回光, 让整窗而非顶部单点有层次。 -->
                <Border x:Name="AuroraReflectionLayer"
                        Opacity="0.68">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="AuroraReflectionTransform"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>

            <!-- 标题栏：品牌 + 状态 + 窗口按钮 -->
            <Grid Grid.Row="0"
                  Background="{DynamicResource SidebarBackgroundBrush}">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Assets/app-icon.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="FPS-TUNE"
                               Margin="9,0,0,0"
                               FontSize="12" FontWeight="Bold"
                               FontFamily="{StaticResource FontMono}"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleVersionText"
                               Text="v1.0.1"
                               Margin="10,1,0,0"
                               FontSize="11"
                               FontFamily="{StaticResource FontMono}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="CaptionMin" Tag="min" Click="CaptionButton_Click"
                            Width="44" Height="32" Style="{StaticResource CaptionButtonStyle}">
                        <Path Data="M0 0 H10" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1"/>
                    </Button>
                    <Button x:Name="CaptionMax" Tag="max" Click="CaptionButton_Click"
                            Width="44" Height="32" Style="{StaticResource CaptionButtonStyle}">
                        <Path Data="M0.5 0.5 H8.5 V8.5 H0.5 Z" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1"
                              StrokeLineJoin="Round" Fill="Transparent"/>
                    </Button>
                    <Button x:Name="CaptionClose" Tag="close" Click="CaptionButton_Click"
                            Width="44" Height="32" Style="{StaticResource CaptionCloseButtonStyle}">
                        <Path Data="M0 0 L8 8 M8 0 L0 8" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 页签栏：中文页签 + 底部指示线 -->
            <Grid Grid.Row="1"
                  Background="{DynamicResource SidebarBackgroundBrush}">
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Margin="8,0,8,0" VerticalAlignment="Bottom">
                        <controls:NavButton x:Name="NavHome"
                                            Tag="home"
                                            Text="概览"
                                            IsChecked="True"
                                            Checked="Nav_Checked"/>
                        <controls:NavButton x:Name="NavDetect"
                                            Tag="detect"
                                            Text="检测"
                                            Checked="Nav_Checked"/>
                        <controls:NavButton x:Name="NavOpt"
                                            Tag="opt"
                                            Text="优化"
                                            Checked="Nav_Checked"/>
                        <controls:NavButton x:Name="NavSession"
                                            Tag="session"
                                            Text="性能会话"
                                            Checked="Nav_Checked"/>
                        <controls:NavButton x:Name="NavAb"
                                            Tag="ab"
                                            Text="A/B 实验"
                                            Checked="Nav_Checked"/>
                        <controls:NavButton x:Name="NavFriend"
                                            Tag="friend"
                                            Text="朋友测试"
                                            Checked="Nav_Checked"/>
                        <controls:NavButton x:Name="NavBackup"
                                            Tag="backup"
                                            Text="备份 / 日志"
                                            Checked="Nav_Checked"/>
                        <controls:NavButton x:Name="NavSettings"
                                            Tag="settings"
                                            Text="设置"
                                            Checked="Nav_Checked"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="SidebarVersionText"
                           Text="v1.0.1"
                           Margin="0,0,14,0"
                           FontSize="11"
                           FontFamily="{StaticResource FontMono}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- 内容 -->
            <ContentControl x:Name="PageHost"
                            Grid.Row="2"
                            Margin="0"
                            Focusable="False"/>
        </Grid>
    </Border>
</Window>
