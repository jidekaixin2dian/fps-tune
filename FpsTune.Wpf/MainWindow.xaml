<Window x:Class="FpsTune.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Icon="Assets/app.ico"
        Width="1200" Height="780"
        MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Title="FPS 帧律"
        SourceInitialized="OnSourceInitialized"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="7"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="ChromeRoot"
            Background="{DynamicResource AppBackdropBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid x:Name="ChromeGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 极光层: 窗口级固定背景, 盖满全窗(含侧栏), 页面在其上滑动 -->
            <Border x:Name="AuroraLayer"
                    Grid.Row="0" Grid.RowSpan="2"
                    IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.75" RadiusY="0.72">
                        <GradientStop Color="#554DA3FF" Offset="0"/>
                        <GradientStop Color="#004DA3FF" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="{DynamicResource SidebarBackgroundBrush}">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Assets/app-icon.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="FPS 帧律"
                               Margin="9,0,0,0"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleVersionText"
                               Text="v1.0.1"
                               Margin="10,1,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="CaptionMin" Tag="min" Click="CaptionButton_Click"
                            Width="46" Height="32" Style="{StaticResource CaptionButtonStyle}">
                        <Path Data="M0 0 H10" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1"/>
                    </Button>
                    <Button x:Name="CaptionMax" Tag="max" Click="CaptionButton_Click"
                            Width="46" Height="32" Style="{StaticResource CaptionButtonStyle}">
                        <Path Data="M0.5 0.5 H8.5 V8.5 H0.5 Z" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1"
                              StrokeLineJoin="Round" Fill="Transparent"/>
                    </Button>
                    <Button x:Name="CaptionClose" Tag="close" Click="CaptionButton_Click"
                            Width="46" Height="32" Style="{StaticResource CaptionCloseButtonStyle}">
                        <Path Data="M0 0 L8 8 M8 0 L0 8" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,16">
                    <TextBlock Text="fps-tune"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="通用 FPS · Windows 系统层帧率优化"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <!-- 设置固定左下角 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,20">
                    <Border Height="1"
                            Background="{DynamicResource BorderBrush}"
                            Margin="0,0,0,14"/>
                    <RadioButton x:Name="NavSettings"
                                 Tag="settings"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30"
                                    CornerRadius="9"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="5" Canvas.Top="5" Width="14" Height="14"
                                         Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/>
                                <Ellipse Canvas.Left="9" Canvas.Top="9" Width="6" Height="6"
                                         Fill="{DynamicResource AccentBrush}"/>
                                <Line X1="12" Y1="2" X2="12" Y2="5" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeEndLineCap="Round"/>
                                <Line X1="12" Y1="19" X2="12" Y2="22" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeEndLineCap="Round"/>
                                <Line X1="2" Y1="12" X2="5" Y2="12" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeEndLineCap="Round"/>
                                <Line X1="19" Y1="12" X2="22" Y2="12" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeEndLineCap="Round"/>
                                <Line X1="4.9" Y1="4.9" X2="7.1" Y2="7.1" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeEndLineCap="Round"/>
                                <Line X1="16.9" Y1="16.9" X2="19.1" Y2="19.1" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeEndLineCap="Round"/>
                                <Line X1="4.9" Y1="19.1" X2="7.1" Y2="16.9" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeEndLineCap="Round"/>
                                <Line X1="16.9" Y1="7.1" X2="19.1" Y2="4.9" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                            </Border>
                            <TextBlock Text="设置"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <TextBlock x:Name="SidebarVersionText"
                               Text="v1.0.1"
                               Margin="14,10,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Margin="18,20,18,0">
                    <TextBlock Text="工作区"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Margin="4,18,0,8"/>
                    <RadioButton x:Name="NavHome"
                                 Tag="home"
                                 Style="{StaticResource NavRadioStyle}"
                                 IsChecked="True"
                                 Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30"
                                    CornerRadius="9"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M4 11 L12 4 L20 11 V20 H14 V14 H10 V20 H4 Z"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                            </Border>
                            <TextBlock Text="首页"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavDetect"
                                 Tag="detect"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30"
                                    CornerRadius="9"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="3.5" Canvas.Top="3.5" Width="13" Height="13"
                                         Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/>
                                <Line X1="14.5" Y1="14.5" X2="20" Y2="20"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                            </Border>
                            <TextBlock Text="检测"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavOpt"
                                 Tag="opt"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30"
                                    CornerRadius="9"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M13 2 L5.5 14 H11.5 L9.5 22 L18.5 10 H12.5 Z"
                                      Fill="{DynamicResource AccentBrush}"
                                      StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                            </Border>
                            <TextBlock Text="优化"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="实验与数据"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Margin="4,18,0,8"/>
                    <RadioButton x:Name="NavAb"
                                 Tag="ab"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30"
                                    CornerRadius="9"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="4" Canvas.Top="13" Width="3.5" Height="8" RadiusX="1.75" RadiusY="1.75" Fill="{DynamicResource AccentBrush}"/>
                                <Rectangle Canvas.Left="10.25" Canvas.Top="9" Width="3.5" Height="12" RadiusX="1.75" RadiusY="1.75" Fill="{DynamicResource AccentBrush}"/>
                                <Rectangle Canvas.Left="16.5" Canvas.Top="5" Width="3.5" Height="16" RadiusX="1.75" RadiusY="1.75" Fill="{DynamicResource AccentBrush}"/>
                            </Canvas>
                        </Viewbox>
                            </Border>
                            <TextBlock Text="A/B 实验"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavFriend"
                                 Tag="friend"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30"
                                    CornerRadius="9"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M17 21 V19 A4 4 0 0 0 13 15 H5 A4 4 0 0 0 1 19 V21"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Ellipse Canvas.Left="5" Canvas.Top="3" Width="8" Height="8"
                                         Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/>
                                <Path Data="M23 21 V19 A4 4 0 0 0 20 15.13"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Path Data="M16 3.13 A4 4 0 0 1 16 10.87"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                            </Border>
                            <TextBlock Text="朋友测试"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavBackup"
                                 Tag="backup"
                                 Style="{StaticResource NavRadioStyle}"
                                 Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30"
                                    CornerRadius="9"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M5 3 H14 L18 7 V21 H5 Z"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                      StrokeLineJoin="Round"/>
                                <Path Data="M14 3 V7 H18"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                      StrokeLineJoin="Round"/>
                                <Line X1="8.5" Y1="12" X2="15.5" Y2="12"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeEndLineCap="Round"/>
                                <Line X1="8.5" Y1="16" X2="15.5" Y2="16"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                            </Border>
                            <TextBlock Text="备份 / 日志"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 右侧内容 -->
            <ContentControl x:Name="PageHost"
                            Grid.Column="1"
                            Margin="0"
                            Focusable="False"/>
        </Grid>
    </Grid>
    </Border>
</Window>
