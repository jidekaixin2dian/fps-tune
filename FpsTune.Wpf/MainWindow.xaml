<Window x:Class="FpsTune.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:FpsTune.Wpf.Views.Controls"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Icon="Assets/app.ico" Width="1360" Height="860" MinWidth="1180" MinHeight="720"
    Title="{DynamicResource Str.AppName}" WindowStartupLocation="CenterScreen"
    SourceInitialized="OnSourceInitialized" ResizeMode="CanResize" AllowsTransparency="False"
    Background="{DynamicResource AppBackdropBrush}" FontFamily="{StaticResource FontBody}" Style="{StaticResource WindowTypographyStyle}"
    TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58" GlassFrameThickness="0" ResizeBorderThickness="7" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="ChromeRoot" Background="{DynamicResource AppBackdropBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" CornerRadius="8" RenderOptions.ClearTypeHint="Enabled">
        <Grid x:Name="ChromeGrid">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition x:Name="NavigationRow" Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Image x:Name="WallpaperBackdrop" Grid.RowSpan="3" Grid.ColumnSpan="2" Stretch="UniformToFill"
                   IsHitTestVisible="False" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Grid x:Name="TitleBar" Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource SidebarBackgroundBrush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Image x:Name="AppBrand" Source="{StaticResource AppMark}" Width="32" Height="32"/>
                    <TextBlock Text="{DynamicResource Str.AppNameShort}" FontSize="18" FontWeight="{DynamicResource StrongEmphasisWeight}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleVersionText" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="16,2,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="TitleActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="HudEntryButton" Content="{DynamicResource Str.HudEntry}" Click="HudEntry_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" Padding="14,0" Height="34"/>
                    <Button x:Name="CommandSearchButton" Click="CommandSearch_Click" Style="{StaticResource GhostButtonStyle}" Width="34" Height="34" Padding="0" Margin="0,0,12,0"
                            ToolTip="{DynamicResource Str.CommandSearch}" AutomationProperties.Name="{DynamicResource Str.CommandSearch}">
                        <Path Data="M 10.5,4.5 A 6,6 0 1 0 10.5,16.5 A 6,6 0 1 0 10.5,4.5 M 15,15 L 20,20" Width="18" Height="18" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>
                    </Button>
                    <Button x:Name="MoreButton" Content="{DynamicResource Str.MoreActions}" Click="More_Click" Style="{StaticResource GhostButtonStyle}" Margin="0,0,12,0" Height="34" Padding="12,0">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MoreMenu" MinWidth="190" FontFamily="{StaticResource FontBody}">
                                <MenuItem IsEnabled="False"><MenuItem.Header><TextBlock x:Name="AdminStatusText" Foreground="{DynamicResource TextMutedBrush}"/></MenuItem.Header></MenuItem>
                                <Separator/>
                                <MenuItem x:Name="GuideMenuItem" Header="{DynamicResource Str.Guide}" Click="Guide_Click"/>
                                <MenuItem x:Name="FeedbackMenuItem" Header="{DynamicResource Str.Feedback}" Click="Feedback_Click"/>
                                <MenuItem x:Name="OverviewModeButton" Click="OverviewMode_Click" ToolTip="{DynamicResource Str.TipDisplayMode}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="CaptionMin" Tag="min" Click="CaptionButton_Click" Width="42" Height="36" Margin="6,0,0,0" Style="{StaticResource CaptionButtonStyle}" ToolTip="{DynamicResource Str.Minimize}" AutomationProperties.Name="{DynamicResource Str.Minimize}"><Path Data="M0 0 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="1" StrokeThickness="1.2"/></Button>
                    <Button x:Name="CaptionMax" Tag="max" Click="CaptionButton_Click" Width="42" Height="36" Style="{StaticResource CaptionButtonStyle}"><Path x:Name="CaptionMaxGlyph" Data="M0 0 H10 V10 H0 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11" Height="11" StrokeThickness="1.2"/></Button>
                    <Button x:Name="CaptionClose" Tag="close" Click="CaptionButton_Click" Width="42" Height="36" Style="{StaticResource CaptionCloseButtonStyle}" ToolTip="{DynamicResource Str.CloseChoiceTitle}" AutomationProperties.Name="{DynamicResource Str.CloseChoiceTitle}"><Path Data="M0 0 L10 10 M10 0 L0 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11" Height="11" StrokeThickness="1.4"/></Button>
                </StackPanel>
            </Grid>
            <Grid x:Name="TabBar" Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource SidebarBackgroundBrush}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="NavigationHeading" Text="{DynamicResource Str.Workspace}" Margin="24,24,0,16" Foreground="{DynamicResource TextMutedBrush}" FontSize="13"/>
                <StackPanel x:Name="NavigationStack" Grid.Row="1" Margin="4,0,10,0">
                    <controls:NavButton x:Name="NavHome" Tag="home" Text="{DynamicResource Str.NavHome}" Icon="M2.5 8 L8 2.5 L13.5 8 M4.5 7 V13.5 H11.5 V7" Style="{StaticResource SideNavItemStyle}" IsChecked="True" Checked="Nav_Checked"/>
                    <StackPanel x:Name="NavGroupGamesRoot">
                        <ToggleButton x:Name="NavGroupGamesHeader" Tag="Games" Style="{StaticResource NavGroupHeaderStyle}" Content="{DynamicResource Str.NavGroupGames}" IsChecked="True" Checked="GroupHeader_Toggled" Unchecked="GroupHeader_Toggled" AutomationProperties.Name="{DynamicResource Str.NavGroupGames}"/>
                        <StackPanel x:Name="NavGroupGamesItems">
                            <controls:NavButton x:Name="NavGames" Tag="games" Text="{DynamicResource Str.NavGames}" Icon="M5.5 5.5 H10.5 A2.5 2.5 0 0 1 13 8 A3.2 3.2 0 0 1 9.8 11.2 H6.2 A3.2 3.2 0 0 1 3 8 A2.5 2.5 0 0 1 5.5 5.5 Z M5.3 7.6 V9.6 M4.3 8.6 H6.3 M10.2 8 V8.1 M11.5 9 V9.1" Style="{StaticResource SideNavSubItemStyle}" Checked="Nav_Checked"/>
                            <controls:NavButton x:Name="NavQuick" Tag="quick" Text="{DynamicResource Str.NavQuickOpt}" Icon="M8.7 2 L4 9 H7 L6.4 14 L12 7 H8.6 Z" Style="{StaticResource SideNavSubItemStyle}" Checked="Nav_Checked"/>
                            <controls:NavActionButton x:Name="NavDeltaFix" Content="{DynamicResource Str.DeltaFixTab}" Icon="M3.5 7.5 H10 A3 3 0 0 1 10 13.5 H6 M6.5 4.5 L3.5 7.5 L6.5 10.5" Style="{StaticResource SideNavActionStyle}" Click="NavDeltaFix_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="NavGroupDisplayRoot">
                        <ToggleButton x:Name="NavGroupDisplayHeader" Tag="Display" Style="{StaticResource NavGroupHeaderStyle}" Content="{DynamicResource Str.NavGroupDisplay}" IsChecked="True" Checked="GroupHeader_Toggled" Unchecked="GroupHeader_Toggled" AutomationProperties.Name="{DynamicResource Str.NavGroupDisplay}"/>
                        <StackPanel x:Name="NavGroupDisplayItems">
                            <controls:NavButton x:Name="NavDetect" Tag="detect" Text="{DynamicResource Str.NavDetect}" Icon="M2.5 12.5 A5.5 5.5 0 0 1 13.5 12.5 M8 11.5 L10.8 6.8" Style="{StaticResource SideNavSubItemStyle}" Checked="Nav_Checked"/>
                            <controls:NavButton x:Name="NavDisplay" Tag="display" Text="{DynamicResource Str.NavDisplayPage}" Icon="M2.5 3.5 H13.5 V10.5 H2.5 Z M6 13.5 H10 M8 10.5 V13.5" Style="{StaticResource SideNavSubItemStyle}" Checked="Nav_Checked"/>
                        </StackPanel>
                    </StackPanel>
                    <controls:NavButton x:Name="NavFilters" Tag="filters" Text="{DynamicResource Str.NavFilters}" Icon="M2.5 3 H13.5 L9.5 8.5 V12.5 L6.5 11 V8.5 Z" Style="{StaticResource SideNavItemStyle}" Checked="Nav_Checked"/>
                    <controls:NavButton x:Name="NavTools" Tag="tools" Text="{DynamicResource Str.NavTools}" Icon="M2.5 5.5 H13.5 V13 H2.5 Z M6 5.5 V3.5 H10 V5.5 M2.5 9 H13.5" Style="{StaticResource SideNavItemStyle}" Checked="Nav_Checked"/>
                    <StackPanel x:Name="NavGroupSystemRoot">
                        <ToggleButton x:Name="NavGroupSystemHeader" Tag="System" Style="{StaticResource NavGroupHeaderStyle}" Content="{DynamicResource Str.NavGroupSystem}" IsChecked="True" Checked="GroupHeader_Toggled" Unchecked="GroupHeader_Toggled" AutomationProperties.Name="{DynamicResource Str.NavGroupSystem}"/>
                        <StackPanel x:Name="NavGroupSystemItems">
                            <controls:NavButton x:Name="NavOpt" Tag="opt" Text="{DynamicResource Str.NavOpt}" Icon="M3 5.5 H13 M3 10.5 H13 M6.5 3.8 V7.2 M10.5 8.8 V12.2" Style="{StaticResource SideNavSubItemStyle}" Checked="Nav_Checked"/>
                            <controls:NavButton x:Name="NavBackup" Tag="backup" Text="{DynamicResource Str.NavBackup}" Icon="M8 3.5 A4.5 4.5 0 1 1 3.5 8 M3.5 4 V8 H7.5 M8 6 V8.5 L9.8 9.8" Style="{StaticResource SideNavSubItemStyle}" Checked="Nav_Checked"/>
                        </StackPanel>
                    </StackPanel>
                    <controls:NavButton x:Name="NavSession" Tag="session" Text="{DynamicResource Str.NavSession}" Icon="M8 4 A4.6 4.6 0 1 1 7.99 4 M8 2.3 V4 M6.2 2.5 H9.8 M8 8.5 L10 6" Style="{StaticResource SideNavItemStyle}" Checked="Nav_Checked"/>
                    <controls:NavButton x:Name="NavAb" Tag="ab" Text="{DynamicResource Str.NavAb}" Icon="M4.5 12.5 V3.5 M4.5 3.5 L2.8 5.2 M4.5 3.5 L6.2 5.2 M11.5 3.5 V12.5 M11.5 12.5 L9.8 10.8 M11.5 12.5 L13.2 10.8" Style="{StaticResource SideNavItemStyle}" Checked="Nav_Checked"/>
                    <controls:NavButton x:Name="NavSettings" Tag="settings" Text="{DynamicResource Str.NavSettings}" Icon="M8 5.6 A2.4 2.4 0 1 0 8.01 5.6 M8 2 V3.6 M8 12.4 V14 M2 8 H3.6 M12.4 8 H14 M3.75 3.75 L4.9 4.9 M11.1 11.1 L12.25 12.25 M12.25 3.75 L11.1 4.9 M4.9 11.1 L3.75 12.25" Style="{StaticResource SideNavItemStyle}" Checked="Nav_Checked"/>
                </StackPanel>
                <StackPanel x:Name="NavigationFooter" Grid.Row="2" Margin="24,20,16,24">
                    <TextBlock x:Name="FooterBrandText" Text="{DynamicResource Str.AppName}" FontFamily="{StaticResource FontBody}" FontWeight="{DynamicResource SmallEmphasisWeight}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                </StackPanel>
            </Grid>
            <ContentControl x:Name="PageHost" Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Focusable="False"/>
            <Border x:Name="HudOptionsPanel" Grid.RowSpan="3" Grid.ColumnSpan="2" Panel.ZIndex="210" Style="{StaticResource CardStyle}"
                    Background="{DynamicResource NotificationBackgroundBrush}" Width="380" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,68,24,0" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel><Button Content="{DynamicResource Str.HudOptionsDismiss}" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource GhostButtonStyle}" Click="HudOptionsDismiss_Click"/><TextBlock Text="{DynamicResource Str.HudTitle}" Foreground="{DynamicResource TextPrimaryBrush}" Style="{StaticResource ItemTitleStyle}" VerticalAlignment="Center"/></DockPanel>
                    <WrapPanel Margin="0,12,0,16"><Button x:Name="RestoreHudButton" Content="{DynamicResource Str.HudUnlock}" Click="HudRestore_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button x:Name="HideHudButton" Content="{DynamicResource Str.HudHide}" Click="HudClose_Click" Style="{StaticResource GhostButtonStyle}"/></WrapPanel>
                    <TextBlock Text="{DynamicResource Str.HudLayout}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,14"><RadioButton x:Name="HudCompactOption" GroupName="HudLayout" Content="{DynamicResource Str.HudCompact}" Tag="compact" Checked="HudAppearance_Changed" Margin="0,0,18,0"/><RadioButton x:Name="HudStripOption" GroupName="HudLayout" Content="{DynamicResource Str.HudStrip}" Tag="strip" Checked="HudAppearance_Changed" Margin="0,0,22,0"/><RadioButton x:Name="HudCardOption" GroupName="HudLayout" Content="{DynamicResource Str.HudCard}" Tag="card" Checked="HudAppearance_Changed"/></StackPanel>
                    <Button x:Name="HudGamePresetButton" Content="{DynamicResource Str.HudGamePreset}" Style="{StaticResource SecondaryButtonStyle}" Click="HudGamePreset_Click" Margin="0,0,0,12"/><TextBlock x:Name="HudTransparencyLabel" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Slider x:Name="HudTransparencySlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="HudTransparency_Changed" Margin="0,8,0,8"/>
                    <WrapPanel Margin="0,0,0,14"><Button Content="{DynamicResource Str.HudOpaque}" Tag="0" Click="HudTransparencyPreset_Click" Style="{StaticResource GhostButtonStyle}"/><Button Content="{DynamicResource Str.HudTranslucent}" Tag="50" Click="HudTransparencyPreset_Click" Style="{StaticResource GhostButtonStyle}"/><Button x:Name="HudNoBackgroundButton" Content="{DynamicResource Str.HudNoBackground}" Tag="100" Click="HudTransparencyPreset_Click" Style="{StaticResource GhostButtonStyle}"/></WrapPanel>
                    <TextBlock Text="{DynamicResource Str.HudPosition}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,14"><RadioButton x:Name="HudLeftOption" GroupName="HudPosition" Content="{DynamicResource Str.HudTopLeft}" Checked="HudAppearance_Changed" Margin="0,0,16,0"/><RadioButton x:Name="HudCenterOption" GroupName="HudPosition" Content="{DynamicResource Str.HudTopCenter}" Checked="HudAppearance_Changed" Margin="0,0,16,0"/><RadioButton x:Name="HudRightOption" GroupName="HudPosition" Content="{DynamicResource Str.HudTopRight}" Checked="HudAppearance_Changed"/></StackPanel>
                    <TextBlock Text="{DynamicResource Str.HudAppearanceHint}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button x:Name="SaveHudAppearanceButton" Content="{DynamicResource Str.HudSaveAppearance}" Click="HudAppearanceSave_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="HudOptionsStatus" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="NotificationArea" Grid.Row="2" Grid.Column="1" Panel.ZIndex="100"
                          Width="440" Margin="20" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <StackPanel x:Name="NotificationStack"/>
            </ScrollViewer>
            <Grid x:Name="CommandOverlay" Grid.RowSpan="3" Grid.ColumnSpan="2" Panel.ZIndex="200" Background="#99000000"
                  Visibility="Collapsed" MouseDown="CommandBackdrop_MouseDown" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <ContentControl x:Name="CommandHost" MaxWidth="740" Margin="28,76,28,24" VerticalAlignment="Top" HorizontalContentAlignment="Stretch"/>
            </Grid>
        </Grid>
    </Border>
</Window>
