<Window x:Class="FpsTune.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:FpsTune.Wpf.Views.Controls"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Icon="Assets/app.ico" Width="1360" Height="860" MinWidth="1180" MinHeight="720"
    Title="{DynamicResource Str.AppName}" WindowStartupLocation="CenterScreen"
    SourceInitialized="OnSourceInitialized" ResizeMode="CanResize" AllowsTransparency="False"
    Background="{DynamicResource AppBackdropBrush}" FontFamily="{StaticResource FontBody}"
    TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58" GlassFrameThickness="0" ResizeBorderThickness="7" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="ChromeRoot" Background="{DynamicResource AppBackdropBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" CornerRadius="8">
        <Grid x:Name="ChromeGrid">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition x:Name="NavigationRow" Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid x:Name="TitleBar" Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource SidebarBackgroundBrush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Image Source="/Assets/app-icon.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{DynamicResource Str.AppNameShort}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleVersionText" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="16,2,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock x:Name="AdminStatusText" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Button Content="{DynamicResource Str.Guide}" Click="Guide_Click" Style="{StaticResource GhostButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Str.Feedback}" Click="Feedback_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0"/>
                    <Button x:Name="OverviewModeButton" Click="OverviewMode_Click" Style="{StaticResource GhostButtonStyle}" Margin="0,0,12,0" ToolTip="{DynamicResource Str.TipDisplayMode}"/>
                    <Button x:Name="CaptionMin" Tag="min" Click="CaptionButton_Click" Width="44" Height="32" Style="{StaticResource CaptionButtonStyle}" ToolTip="{DynamicResource Str.Minimize}" AutomationProperties.Name="{DynamicResource Str.Minimize}"><Path Data="M0 0 H10" Stroke="{DynamicResource TextSecondaryBrush}"/></Button>
                    <Button x:Name="CaptionMax" Tag="max" Click="CaptionButton_Click" Width="44" Height="32" Style="{StaticResource CaptionButtonStyle}" ToolTip="{DynamicResource Str.Maximize}" AutomationProperties.Name="{DynamicResource Str.Maximize}"><Path Data="M0 0 H9 V9 H0 Z" Stroke="{DynamicResource TextSecondaryBrush}" Fill="Transparent"/></Button>
                    <Button x:Name="CaptionClose" Tag="close" Click="CaptionButton_Click" Width="44" Height="32" Style="{StaticResource CaptionCloseButtonStyle}" ToolTip="{DynamicResource Str.Close}" AutomationProperties.Name="{DynamicResource Str.Close}"><Path Data="M0 0 L9 9 M9 0 L0 9" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"/></Button>
                </StackPanel>
            </Grid>
            <Grid x:Name="TabBar" Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource SidebarBackgroundBrush}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="NavigationHeading" Text="{DynamicResource Str.Workspace}" Margin="24,24,0,16" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                <StackPanel x:Name="NavigationStack" Grid.Row="1" Margin="12,0,12,0">
                    <controls:NavButton x:Name="NavHome" Tag="home" Text="{DynamicResource Str.NavHome}" IsChecked="True" Checked="Nav_Checked"/>
                    <controls:NavButton x:Name="NavDetect" Tag="detect" Text="{DynamicResource Str.NavDetect}" Checked="Nav_Checked"/>
                    <controls:NavButton x:Name="NavOpt" Tag="opt" Text="{DynamicResource Str.NavOpt}" Checked="Nav_Checked"/>
                    <controls:NavButton x:Name="NavDisplay" Tag="display" Text="{DynamicResource Str.NavDisplay}" Checked="Nav_Checked"/>
                    <controls:NavButton x:Name="NavSession" Tag="session" Text="{DynamicResource Str.NavSession}" Checked="Nav_Checked"/>
                    <controls:NavButton x:Name="NavAb" Tag="ab" Text="{DynamicResource Str.NavAb}" Checked="Nav_Checked"/>
                    <controls:NavButton x:Name="NavBackup" Tag="backup" Text="{DynamicResource Str.NavBackup}" Checked="Nav_Checked"/>
                    <controls:NavButton x:Name="NavSettings" Tag="settings" Text="{DynamicResource Str.NavSettings}" Checked="Nav_Checked"/>
                </StackPanel>
                <StackPanel x:Name="NavigationFooter" Grid.Row="2" Margin="24,20,16,24">
                    <TextBlock Text="FPS TUNE" FontFamily="{StaticResource FontMono}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="SidebarVersionText" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
            <ContentControl x:Name="PageHost" Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Focusable="False"/>
            <ScrollViewer x:Name="NotificationArea" Grid.Row="2" Grid.Column="1" Panel.ZIndex="100"
                          Width="440" Margin="20" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <StackPanel x:Name="NotificationStack"/>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
