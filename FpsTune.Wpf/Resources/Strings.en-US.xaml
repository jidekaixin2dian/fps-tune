    <s:String x:Key="Str.TipTransparencyAA">Supersampling 2x is the default recommendation; high-end desktop cards such as the 5070 Ti can use 4x</s:String>
    <s:String x:Key="Str.AaSuper2x">Supersampling 2x (recommended)</s:String>
