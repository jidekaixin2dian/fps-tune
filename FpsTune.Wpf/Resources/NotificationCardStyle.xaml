<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:FpsTune.Wpf.Views.Controls">
    <Style x:Key="NotificationCardStyle" TargetType="{x:Type controls:NotificationCard}">
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Template"><Setter.Value>
<ControlTemplate TargetType="{x:Type controls:NotificationCard}">
    <Border Background="{DynamicResource NotificationBackgroundBrush}" BorderBrush="{DynamicResource BorderHoverBrush}"
            BorderThickness="1" CornerRadius="12" Padding="18">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{TemplateBinding NotificationTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{TemplateBinding NotificationSubtitle}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <Button x:Name="FoldButton" Grid.Column="1" Content="{TemplateBinding FoldLabel}"
                        Style="{DynamicResource GhostButtonStyle}" Padding="8,5" VerticalAlignment="Top"/>
                <Button x:Name="CloseButton" Grid.Column="2" Content="×" Style="{DynamicResource GhostButtonStyle}" Padding="8,5"
                        VerticalAlignment="Top" ToolTip="{DynamicResource Str.Close}" AutomationProperties.Name="{DynamicResource Str.Close}"/>
            </Grid>
            <ContentPresenter x:Name="BodyHost" Content="{TemplateBinding Content}" Margin="0,16,0,0"/>
        </StackPanel>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="False"><Setter TargetName="BodyHost" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
</ResourceDictionary>
