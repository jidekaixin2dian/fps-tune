<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FpsTune.Wpf</RootNamespace>
    <AssemblyName>FpsTune</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WMI 查询（内存频率体检），避免再启动 powershell.exe 子进程 -->
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FpsTune.Wpf.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\catalog\catalog.json" Link="catalog.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\catalog\catalog.json" LogicalName="FpsTune.Wpf.Catalog.catalog.json" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\tray.ico" />
    <Resource Include="Assets\app-icon.png" />
    <Resource Include="Assets\wechat-qr.jpg" />
  </ItemGroup>

</Project>
