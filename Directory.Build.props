<Project>
  <!-- 版本与产品标识的唯一来源：csproj / 安装器 / PowerShell CLI 均从此读取 -->
  <PropertyGroup>
    <!-- 版本号拆两段：VersionPrefix 必须是三段数字（发布/安装脚本与更新比较都消费它），
         VersionSuffix 是预发布标识（0.1 Beta 线），进 InformationalVersion/ProductVersion 展示 -->
    <!-- 0.1.4 = catalog 33 项名称/说明英译（P2-1）+ 优化页分类标签本地化；i18n 收尾 -->
    <!-- 0.1.5 = 显示页「驱动内手动设置清单」卡（P2-8，A 卡/Intel 手动调优指引 + 厂商识别） -->
    <!-- 0.1.6 = 启动画面 + 启动预热 + 「我的方案」弹窗化（用户反馈体验轮） -->
    <!-- 0.1.7 = 显示页状态读取异步化 + 优化页列表虚拟化 + DRS 卡下拉框主题样式（用户反馈卡顿/样式轮） -->
    <!-- 0.1.8 = 备份页文件状态列表（P2-11：标出已消费的 .restored 审计记录） -->
    <!-- 0.1.9 = ICC 自选 .icc/.icm 文件（P2-10 / GUI_PLAN G3） -->
    <!-- 0.1.10 = 显示页二级页签（用户反馈：卡片多、滚动长） -->
    <!-- 0.1.11 = P2-12 PresentMon 前置探测 + 显示页居中 + 空闲预热 + 启动画面重设计 -->
    <!-- 0.1.12 = 全仓统一卡片骨架（检测/优化去扁平）+ 显示页全宽大改（页签状态徽标/驱动3D双列）+ splash 真阶段进度 -->
    <!-- 0.1.13 = 控制台概览首次「基础建议」先跑只读体检（P3-9：默认模式下新用户不再绕过检测页） -->
    <!-- 0.1.14 = 系统性审计修复（更新检查对全 pre-release 失效根因修复 + 还原管理员预检 +
         导出/删除/打开目录守卫 + 设置页外观卡顺序 + 会话比较表头 + 对话框 Enter + AB 图重绘）
         + splash 等首页数据就绪才放行（用户反馈） -->
    <!-- 0.1.15 = P3-4 检测页前置状态条（进入即显示上次检测时间与耗时） -->
    <VersionPrefix>0.1.15</VersionPrefix>
    <VersionSuffix>beta</VersionSuffix>
    <Product>FPS 帧律</Product>
    <Description>通用 FPS · Windows 系统层帧率优化工具</Description>
    <Authors>FPS 帧律</Authors>
  </PropertyGroup>
</Project>
