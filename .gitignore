# OS / editor cruft
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
*.swp

# Local experiment state / backups (written to %LOCALAPPDATA% by the tools;
# these are just in case something lands in the repo)
state/
*.csv
backup-*.json
*.tmp
*.log

# .NET build output
bin/
obj/
*.user

# Release artifacts
dist/

# 本地测试/验证输出（Tee-Object、手工冒烟日志等），不入库
test-result*.txt

# 本地开发文档、交接、计划、审查与历史记录：禁止提交 / push / 放入 Release
# 已跟踪的开发文档必须 git rm --cached；只忽略不会移除远端已有文件。
*.md
*.rst
*.adoc
*.doc
*.docx
*.pdf
*.html
*.htm
/docs/
/dev-docs/
/development/
/.agents/
/.codex/
# 公开白名单只有面向使用者的说明；嵌套 README 仍按开发文档忽略。
!/README.md
!/README.en.md
!/SKILL.md

# 本地 AI 代理的工作数据（记忆/技能/会话态），不入库
.workbuddy-ai/

# 本地探针/验证工程（结论仅保留本地开发文档，工程本身不入库）
work/
.zcodeignore
__pycache__/

# 评审产出（本地产出，不入库）
review-output/

# WorkBuddy 代理工作数据（本机会话），不入库
.workbuddy/
